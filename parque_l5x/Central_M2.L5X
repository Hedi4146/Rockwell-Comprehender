<Routine Name="R002_Local" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOV(machineSpeed_DINT,SpeedPPM)Blink(Blink1,pulse_1000ms,500,500)Blink(Blink3,pulse_400ms,200,200)Blink(Blink4,pulse_100ms,50,50)Blink(Blink5,pulse_50ms,25,25)Blink(Blink6,pulse_3000ms,505,500);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[[XIC(HMI_Err_Rst) ,XIC(ResetAlarm) ] OTE(Cmd_Reset) ,XIC(Emergency_RST) OTE(IO1:4:O.3) ,XIC(open_1) [XIO(IO1:2:I.2) ,XIC(HmiEnableSimulation) ] OTU(Cmd_Servo_Enable) OTU(Cmd_Start_Up) ,XIC(Cmd_Servo_Enable) TON(Servo_Enable_Delay,?,?) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[
*******************************************************
Enable Servos Control
*******************************************************
]]>
</Comment>
<Text>
<![CDATA[XIC(Servo_Enable_Delay.DN)[XIC(Cmd_ServoSelect[1]) OTE(Cmd_Enable[1]) ,XIC(OFF) XIC(Cmd_ServoSelect[2]) OTE(Cmd_Enable[2]) ,XIC(Cmd_ServoSelect[3]) OTE(Cmd_Enable[3]) ,XIC(Cmd_ServoSelect[4]) OTE(Cmd_Enable[4]) ,XIC(Cmd_ServoSelect[5]) [XIC(NWleftSplicePrepared) ,XIC(Cmd_Unwind[5]) ] OTE(Cmd_Enable[5]) ,XIC(Cmd_ServoSelect[6]) [XIC(NWrightSplicePrepared) ,XIC(Cmd_Unwind[6]) ] OTE(Cmd_Enable[6]) ,XIC(Cmd_ServoSelect[7]) [XIC(PEleftSplicePrepared) ,XIC(Cmd_Unwind[7]) ] OTE(Cmd_Enable[7]) ,XIC(Cmd_ServoSelect[8]) [XIC(PErightSplicePrepared) ,XIC(Cmd_Unwind[8]) ] OTE(Cmd_Enable[8]) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[*******************************************************
Disable Servos Control
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[[XIO(Cmd_ServoSelect[1]) ,XIO(Cmd_Servo_Enable) ] OTE(Cmd_Disable[1]) ,XIC(OFF) OTE(Cmd_Disable[2]) ,[XIO(Cmd_ServoSelect[2]) ,XIO(Cmd_Servo_Enable) ] OTE(Cmd_Disable[2]) ,[XIO(Cmd_ServoSelect[3]) ,XIO(Cmd_Servo_Enable) ] OTE(Cmd_Disable[3]) ,[XIO(Cmd_ServoSelect[4]) ,XIO(Cmd_Servo_Enable) ] OTE(Cmd_Disable[4]) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[*******************************************************
Disable Servos Control
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[[XIO(Cmd_ServoSelect[5]) ,XIO(Cmd_Servo_Enable) ,XIO(Cmd_Unwind[5]) XIO(NWleftSplicePrepared) ] OTE(Cmd_Disable[5]) ,[XIO(Cmd_ServoSelect[6]) ,XIO(Cmd_Servo_Enable) ,XIO(Cmd_Unwind[6]) XIO(NWrightSplicePrepared) ] OTE(Cmd_Disable[6]) ,[XIO(Cmd_ServoSelect[7]) ,XIO(Cmd_Servo_Enable) ,XIO(Cmd_Unwind[7]) XIO(PEleftSplicePrepared) ] OTE(Cmd_Disable[7]) ,[XIO(Cmd_ServoSelect[8]) ,XIO(Cmd_Servo_Enable) ,XIO(Cmd_Unwind[8]) XIO(PErightSplicePrepared) ] OTE(Cmd_Disable[8]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[*******************************************************
Start Up  & Stop Control
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[XIO(Cmd_Stop_1) XIC(Servo_Enable_Delay.DN) TON(Start_Up_Delay,?,?) ,XIC(Start_Up_Delay.DN) ONS(ONS.0) OTL(Cmd_Start_Up) ,XIC(Cmd_Start_Up) TON(Synchronism_Delay,?,?) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[[XIC(BIT[3].15) XIC(IO1:2:I.0) ,XIC(BIT[4].2) XIO(IO1:1:I.2) ] ONS(ONS.1) ADD(1,Stop_Display,Stop_Display) ,GRT(Stop_Display,1) MOV(0,Stop_Display) ,EQU(Stop_Display,1) OTE(Cmd_Stop_1) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(Synchronism_Delay.DN) OTE(IO1:4:O.1) ,XIC(Cmd_Stop_1) OTU(Cmd_Start_Up) OTE(IO1:4:O.0) ,[GRT(SpeedPPM,1) ,XIC(CS) ] XIO(HmiEnableSimulation) OTE(NW.running) OTE(PE.running) ,MOV(nw_l_size,hmi_nw_lenfth) MOV(pe_l_size,hmi_pe_length) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[
*******************************************************
Clock Pulse to Diameter update of  NW & PE Unwinders   
*******************************************************
]]>
</Comment>
<Text>
<![CDATA[[[LIM(0,Master.ActualPosition,90) ,LIM(180,Master.ActualPosition,270) XIC(change_pulso2) ] OTE(Pulse_NW) ,[LIM(0,Master.ActualPosition,90) ,LIM(180,Master.ActualPosition,270) XIC(change_pulso2_Pe) ] OTE(Pulse_PE) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[
*******************************************************
Glue  Application Control
*******************************************************

]]>
</Comment>
<Text>
<![CDATA[XIO(HmiEnableSimulation)XIC(Glue_Laminator_Enable)[XIC(HMI_Automatic_Button) GEQ(SpeedPPM,HMI_LimitGlue) TON(TON_Glue,?,?) XIC(TON_Glue.DN) ,XIO(HMI_Automatic_Button) ]OTE(IO2:4:O.6)OTE(IO2:4:O.3);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[[XIC(IO1:2:I.7) ,XIC(Test_pulse) ,XIC(HMI_Err_Rst) ] ONS(ONS.13) OTL(Get_Pulse) ,XIC(Get_Pulse) TON(Time_Pulse,?,?) Blink(Blink[7],Pulse.7,500,1250) ,XIC(Pulse.7) OTE(IO1:4:O.7) ,XIC(Time_Pulse.DN) OTU(Pulse.7) OTU(Get_Pulse) ,XIC(MachineStill) OTE(IO2:4:O.7) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R003_SM1_SM2_Feeder" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[[XIO(BIT[10].11) MOV(Glue_Rack_3:6:I.Ch0InputData,Dancer_Laminador) ,XIC(BIT[10].11) MOV(LAM_DANCER_VALUE,Dancer_Laminador) ] MOV(Dancer_Laminador,NWdancer_CV) DIV(NWdancer_CV,300,Nwdancer_CVperc) ,MOV(200,SM1HmiMaxCorrection) MOV(NWHmiDancerSet,SM1HmiDancerSetpoint) MOV(Nwdancer_CVperc,SM1DancerPosition) MOV(NWHmiDancerGain,NWHmiPgain) ,EQU(machineSpeed_DINT,0) XIC(M13.DriveEnableStatus) XIC(M14.DriveEnableStatus) XIC(Cmd_Servo_Enable) XIC(IO2:2:I.1) OTE(Jog_Manual_Laminador) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[
*******************************************************
SM1  Servo Control 
*******************************************************]]>
</Comment>
<Text>
<![CDATA[XIC(Synchronism_Delay.DN)XIC(Object_Sercos[0].Sts_DriveEnableStatus)XIO(SM1_Gear_Change_UpDate)XIO(SM1_Gear_Change_UpDate_2)[XIO(Jog_Manual_Laminador) [MAG(M27_Rodillo_SS,M15,sm1_date.servo_sync,1,NW_Final_Gear,1,1,Actual,Real,Enabled,500,Units per sec2) ,NEQ(NW_Final_Gear,NW_Gear_Change) [OTE(SM1_Gear_Change_UpDate) ,MOV(NW_Final_Gear,NW_Gear_Change) ] ] ,XIC(Jog_Manual_Laminador) [MAG(M27_Rodillo_SS,M14,sm1_date_2.servo_sync,1,NW_Final_Gear_2,1,1,Actual,Real,Enabled,2000,Units per sec2) ,NEQ(NW_Final_Gear_2,NW_Gear_Change_2) [OTE(SM1_Gear_Change_UpDate_2) ,MOV(NW_Final_Gear_2,NW_Gear_Change_2) ] ] ,[GRT(machineSpeed_DINT,5) ,XIC(Jog_Manual_Laminador) ] [CPT(SM1JogSpeedCorrection,(SM1HmiDancerSetpoint-SM1DancerPosition)*NWHmiPgain) ,GRT(SM1JogSpeedCorrection,SM1HmiMaxCorrection) MOV(SM1HmiMaxCorrection,SM1JogSpeedCorrection) ,XIO(SM1DancCorr.DN) TON(SM1DancCorr,?,?) ,XIC(open_Jog) XIC(SM1DancCorr.DN) MAJ(M27_Rodillo_SS,SM1dancerJOG,0,SM1JogSpeedCorrection,Units per sec,15,Units per sec2,15,% of Maximum,S-Curve,50,50,% of Maximum,Disabled,Programmed,0,None) ] ,LES(machineSpeed_DINT,1) XIO(Jog_Manual_Laminador) MAS(M27_Rodillo_SS,SM1dancerSTOP,Jog,Yes,90,% of Maximum,No,100,% of Maximum) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[
*******************************************************
SM2  Servo Control 
*******************************************************]]>
</Comment>
<Text>
<![CDATA[AFI()XIC(Synchronism_Delay.DN)XIC(Synchronism_Delay.DN)XIC(Object_Sercos[1].Sts_DriveEnableStatus)MAG(M26_Rodillo_Poly,M27_Rodillo_SS,sm2_date.servo_sync,0,Ratio_Rod_Poly,1,1,Actual,Real,Enabled,100,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(sm2_date.servo_sync.ER)XIO(sm1_date.servo_sync.ER)XIO(SM1dancerSTOP.ER)XIO(SM1dancerJOG.ER)OTE(Motion_M1_M2_Ok);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(HMI_Err_Rst) ,XIO(Motion_M1_M2_Ok) ,XIC(ResetAlarm) ]XIO(Motion_M1_M2_Ok)CLR(sm2_date.servo_sync.FLAGS)CLR(sm1_date.servo_sync.FLAGS)CLR(SM1dancerSTOP.FLAGS)CLR(SM1dancerJOG.FLAGS);]]>
