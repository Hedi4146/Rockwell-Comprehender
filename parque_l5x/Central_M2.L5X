<Program Name="Stacker" TestEdits="false" MainRoutineName="MainRutine" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="Alarm" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
*******************************************************
Alarms Reset Sequence
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[XIC(Stacker_CMD.FaultReset_Sequence) XIC(Stacker_CMD.FaultReset_Time) OTE(Stacker_CMD.FaultReset) CLR(Alarm2) ,[XIC(Stacker_InPut.Torque_Safe_Off) ,XIC(BIT[5].7) ] OTL(Alarm2.0) ,XIC(Stacker_InPut.Torque_Safe_Off_Vertical) OTL(Alarm2.1) ,XIC(Stacker_InPut.E_Stop_Main) OTL(Alarm2.2) ,XIC(Stacker_InPut.E_Stop_Front) [OTL(Alarm2.3) ,CTU(STOP_FRONT,?,?) ] ,XIC(Stacker_InPut.E_Stop_Op) OTL(Alarm2.4) ,XIC(Stacker_InPut.Upper_Guard) OTL(Alarm2.5) ,XIC(Stacker_InPut.Lower_Guard) [OTL(Alarm2.6) ,CTU(LOWER_GUARD_OPEN,?,?) ] ,XIC(Stacker_InPut.Back_Guard) [OTL(Alarm2.7) ,CTU(BACK_GUARD_OPEN,?,?) ] ,XIC(Stacker_InPut.Operator_Guard) [OTL(Alarm2.23) ,CTU(OPERATOR_GUARD_OPEN,?,?) ] ,XIC(BIT[1].11) OTL(Alarm2.24) ,XIC(BIT[1].13) OTL(Alarm2.25) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[[XIC(M20_Status.Alarm_Present) ,XIC(M20.PhysicalAxisFault) ,XIC(M20.ModuleFault) ] OTL(Alarm2.8) ,[XIC(M21_Status.Alarm_Present) ,XIC(M21.PhysicalAxisFault) ,XIC(M21.ModuleFault) ] OTL(Alarm2.9) ,[XIC(M22_Status.Alarm_Present) ,XIC(M22.PhysicalAxisFault) ,XIC(M22.ModuleFault) ] OTL(Alarm2.10) ,[XIC(M23_Status.Alarm_Present) ,XIC(M23.PhysicalAxisFault) ,XIC(M23.ModuleFault) ] OTL(Alarm2.11) ,[XIC(M24_Status.Alarm_Present) ,XIC(M24.PhysicalAxisFault) ,XIC(M24.ModuleFault) ] OTL(Alarm2.12) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Stacker_InPut.Thermal_Alarm_220Vac) OTL(Alarm2.13) ,XIC(Stacker_InPut.Thermal_Alarm_440Vac) OTL(Alarm2.14) ,XIC(Stacker_Status.Ready_to_Operate) [XIO(Stacker_Status.All_Servos_Start_Pos) TON(TON[30],?,?) XIC(TON[30].DN) ,XIC(BIT[8].12) XIC(Fault_counter_diaper) ] OTL(Alarm2.15) ,XIO(Stacker_Status.Ready_to_Operate) XIC(Stacker_CMD.Homing) TON(TON[31],?,?) XIC(TON[31].DN) OTL(Alarm2.16) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[LIM(2000,Reset_Time.ACC,3000) XIO(M25_Status.Enable_On) OTL(Alarm2.17) ,LIM(7000,Reset_Time.ACC,8000) [XIC(M20_Status.Enable_On) OTL(Alarm2.18) ,XIC(M21_Status.Enable_On) OTL(Alarm2.19) ,XIC(M22_Status.Enable_On) OTL(Alarm2.20) ,XIC(M23_Status.Enable_On) OTL(Alarm2.21) ,XIC(M24_Status.Enable_On) OTL(Alarm2.22) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(Stacker_CMD.FaultReset)NEQ(Alarm2,0)OTE(Stacker_Status.Alarm_Present);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="General" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[Blink(Blink[5],Pulse.5,5,5)Blink(Blink[3],Pulse.3,50,250)Blink(Blink[2],Pulse.2,250,250)Blink(Blink[0],Pulse.0,500,500);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(Stacker_InPut.Torque_Safe_Off) XIO(Stacker_InPut.Thermal_Alarm_220Vac) XIO(Stacker_InPut.E_Stop_Main) OTE(PowerOK_Stacker) ,XIC(Stacker_CMD.Enable_Servos) XIC(PowerOK_Stacker) OTL(Stacker_CMD.Master_Enable_Servos) ,[XIC(Stacker_Status.Alarm_Present) ,XIO(PowerOK_Stacker) ] OTU(Stacker_CMD.Master_Enable_Servos) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[
*******************************************************
Servos Enable Command
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[XIC(Stacker_CMD.Master_Enable_Servos) OTE(M20_CMD.Enable) OTE(M21_CMD.Enable) OTE(M22_CMD.Enable) OTE(M23_CMD.Enable) OTE(M24_CMD.Enable) ,XIO(Stacker_InPut.Torque_Safe_Off_Vertical) XIO(Stacker_InPut.E_Stop_Main) OTE(M25_CMD.Enable) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[
*******************************************************
Status  All servos Ready 
*******************************************************]]>
</Comment>
<Text>
<![CDATA[XIC(M20_Status.Ready)XIC(M21_Status.Ready)XIC(M22_Status.Ready)XIC(M23_Status.Ready)XIC(M24_Status.Ready)XIC(M25_Status.Ready)OTE(Stacker_Status.All_Servos_Ready);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[
*******************************************************
Status  All servos Homed 
*******************************************************]]>
</Comment>
<Text>
<![CDATA[XIC(OFF)XIC(M20_Status.Homed)XIC(M21_Status.Homed)XIC(M22_Status.Homed)XIC(M23_Status.Homed)XIC(M24_Status.Homed)XIC(M25_Status.Homed)OTE(Stacker_Status.All_Servos_Homed);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[
*******************************************************
Status  All servos On 
*******************************************************]]>
</Comment>
<Text>
<![CDATA[XIC(M20_Status.Enable_On)XIC(M21_Status.Enable_On)XIC(M22_Status.Enable_On)XIC(M23_Status.Enable_On)XIC(M24_Status.Enable_On)XIC(M25_Status.Enable_On)OTE(Stacker_Status.All_Servos_On);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[
*******************************************************
Status  All servos Ready to Operate
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[XIC(Stacker_Status.All_Servos_Positioning) ,XIC(Stacker_Status.Ready_to_Operate) ]XIC(Pos_01_M20.Ok)XIC(Pos_01_M21.Ok)XIC(Pos_01_M22.Ok)XIC(Pos_01_M24.Ok)XIC(Pos_01_M25.Ok)[XIC(Pos_02_M23.Ok) [XIC(Move_Side_Op) ,XIC(Move_Side_Op_Dr) ] ,XIC(Pos_01_M23.Ok) [XIC(Move_Side_Dr) ,XIC(Move_Side_Op_Dr) ] ]OTE(Stacker_Status.All_Servos_Start_Pos);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Stacker_Status.All_Servos_Start_Pos)ONS(BIT[6].0)OTL(Stacker_Status.Ready_to_Operate)OTU(Stacker_Status.All_Servos_Positioning);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Stacker_Status.Alarm_Present)OTU(Stacker_Status.Ready_to_Operate);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[
*******************************************************
Status  Lights
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[[[[XIC(Stacker_Status.Alarm_Present) ,XIO(Stacker_OutPut.PB_Manual_Green_Light) ] [XIO(NODE_Z1:8:I.0) ,XIO(NODE_Z1:8:I.1) ] ,XIO(Open_Guard) ] XIC(Pulse.0) ,AFI() XIC(Stacker_Status.All_Servos_Positioning) ] OTE(Stacker_OutPut.Status_Red_Light) ,[XIO(Stacker_OutPut.Status_Red_Light) XIO(Homing_In_Process) XIC(NODE_Z1:8:I.1) XIC(NODE_Z1:8:I.0) ,XIC(Homing_In_Process) XIC(Pulse.0) ] OTE(Stacker_OutPut.PB_Reset_Blue_Light) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(Stacker_Status.Ready_to_Operate) ,XIC(Stacker_CMD.Homing) XIC(Pulse.0) ]OTE(Stacker_OutPut.Status_Green_Light)OTE(Stacker_OutPut.PB_Manual_Green_Light);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[[GRT(Reset_Time.ACC,10) ,XIC(Stacker_CMD.Homing) ] OTE(Homing_In_Process) XIC(Pulse.0) ,XIO(Stacker_InPut.Torque_Safe_Off) XIO(NODE_Z1:5:I.3) XIC(NODE_Z1:7:I.2) XIO(NODE_Z1:5:I.2) XIC(NODE_Z1:7:I.1) OTE(Open_Guard) XIO(Stacker_Status.Ready_to_Operate) LES(Reset_Time.ACC,5) XIO(Stacker_CMD.Homing) ]OTE(Stacker_OutPut.Status_Yellow_Light);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[AFI()XIC(BIT[5].6)[XIC(M20.SafeOffModeActiveStatus) ,XIC(M21.SafeOffModeActiveStatus) ,XIC(M22.SafeOffModeActiveStatus) ,XIC(M23.SafeOffModeActiveStatus) ,XIC(M24.SafeOffModeActiveStatus) ,XIC(M25.SafeOffModeActiveStatus) ]OTE(BIT[5].7);]]>
