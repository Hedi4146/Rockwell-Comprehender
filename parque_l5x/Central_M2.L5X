<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Stacker_CMD.Move_Man_Auto) XIC(bitcontar) [XIO(MachineStill) ,] ,XIO(Stacker_CMD.Move_Man_Auto) XIC(Pulse.1) ]ONS(BIT[6].6)CTU(Diapers_Counter,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Diapers_Counter.DN) ,XIC(Pulso_Cyclo_Manual.TT) ]XIC(Stacker_Status.All_Servos_Start_Pos)OTL(Stacker_Status.Start_Cycle);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[ADD(Diapers_Counter.PRE,2,Diapers_Counter_EX)GRT(Diapers_Counter.ACC,Diapers_Counter_EX)OTE(Fault_counter_diaper);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(Stacker_Status.Start_Cycle) TON(Retardo_Conteo,?,?) XIC(Retardo_Conteo.DN) ,XIC(Stacker_CMD.FaultReset) ]OTU(Stacker_Status.Start_Cycle);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Stacker_Status.Start_Cycle)ONS(BIT[6].2)[XIC(Bandera_Op) OTL(Bandera_2_Op) ,XIC(Bandera_Dr) OTL(Bandera_2_Dr) ];]]>
