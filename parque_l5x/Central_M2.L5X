<Routine Name="R013_Folding_Cam" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[****************************************************************************************************************************************************************

Control de movimiemiento de  Virtual Axis master para sincronia y reposicionamiento de servo de paletas dobladoresa (Folding Cam)

****************************************************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[[XIC(DB_M5_AxEnabled) [XIC(Start_Machine) ,XIC(Enable_VM_M5_Man) ] XIO(MAG_VM_Fold.IP) MAG(VMaster_Folding_Cam,Vmaster1,MAG_VM_Fold,0,1,1,1,Actual,Real,Enabled,90,% of Maximum) ,XIO(DB_M5_AxEnabled) XIO(Start_Machine) ONS(ONS.9) MAS(VMaster_Folding_Cam,MAS_VM_Fold,Gear,Yes,80,% of Maximum,No,100,% of Time) ,XIC(ResetAlarm) [XIC(MAG_VM_Fold.ER) CLR(MAG_VM_Fold.FLAGS) ,XIC(MAS_VM_Fold.ER) CLR(MAS_VM_Fold.FLAGS) ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(M5_MemPosition)OTU(Aux_01);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(M5_MemPosition)JMP(end);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(M5_MemPosition) ONS(Aux_01) XIC(MachineStill) SUB(Vmaster1.ActualPosition,VMaster_Folding_Cam.ActualPosition,Delta_VM_M5) ,LES(Delta_VM_M5,0) ADD(360,Delta_VM_M5,Diff_Position_VM_M5) ,GEQ(Delta_VM_M5,0) MOV(Delta_VM_M5,Diff_Position_VM_M5) ,XIC(Size_S) MOV(Diff_Position_VM_M5,VM_M5_DeltaPos_Size_S) ,XIC(Size_M) MOV(Diff_Position_VM_M5,VM_M5_DeltaPos_Size_M) ,XIC(Size_L) MOV(Diff_Position_VM_M5,VM_M5_DeltaPos_Size_L) ,XIC(Size_XL) MOV(Diff_Position_VM_M5,VM_M5_DeltaPos_Size_XL) ,XIC(Size_XXL) MOV(Diff_Position_VM_M5,VM_M5_DeltaPos_Size_XXL) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[LBL(end)NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(Size_S) MOV(VM_M5_DeltaPos_Size_S,DELTA_Pos_Motor) ,XIC(Size_M) MOV(VM_M5_DeltaPos_Size_M,DELTA_Pos_Motor) ,XIC(Size_L) MOV(VM_M5_DeltaPos_Size_L,DELTA_Pos_Motor) ,XIC(Size_XL) MOV(VM_M5_DeltaPos_Size_XL,DELTA_Pos_Motor) ,XIC(Size_XXL) MOV(VM_M5_DeltaPos_Size_XXL,DELTA_Pos_Motor) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(M5.AxisHomedStatus)[XIC(MotorRunning) XIO(MachineMoving) XIC(DB_M5_AxEnabled) XIO(Homing_Procedure) [XIC(Start_Homing_M5) ONS(ONS.16) OTL(Homing_Procedure) ,OTE(Ready_To_Homing) ONS(ONS.17) OTU(Auto_Phase_Folding_Cam) ] ,XIC(Homing_Procedure) ONS(ONS.18) [SUB(Vmaster1.ActualPosition,DELTA_Pos_Motor,Homing_DeltaPosition) ,GEQ(Homing_DeltaPosition,0) MOV(Homing_DeltaPosition,New_Position) ,LES(Homing_DeltaPosition,0) ADD(360,Homing_DeltaPosition,New_Position) ,SUB(VMaster_Folding_Cam.ActualPosition,New_Position,DELTA_DIRECTION_HOME) ABS(DELTA_DIRECTION_HOME,DELTA_DIRECTION_HOME) ,GRT(VMaster_Folding_Cam.ActualPosition,New_Position) [LIM(0,DELTA_DIRECTION_HOME,180) MOV(3,Homing_Direction) ,LIM(181,DELTA_DIRECTION_HOME,359) MOV(3,Homing_Direction) ] ,LES(VMaster_Folding_Cam.ActualPosition,New_Position) [LIM(0,DELTA_DIRECTION_HOME,180) MOV(3,Homing_Direction) ,LIM(181,DELTA_DIRECTION_HOME,359) MOV(3,Homing_Direction) ] ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(MotorRunning) XIC(DB_M5_AxEnabled) XIC(Homing_Procedure) [XIO(MAM_VM_M5_Home.IP) MAM(VMaster_Folding_Cam,MAM_VM_M5_Home,Homing_Direction,New_Position,3000,Units per sec,100,Units per sec2,100,Units per sec2,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MAM_VM_M5_Home.IP) OTU(Homing_Procedure) ] ,XIC(MAM_VM_M5_Home.ER) MOV(MAM_VM_M5_Home.ERR,IstFaultCode) OTE(Er) ,XIC(MAM_VM_M5_Home.PC) OTE(VMaster_Folding_Cam_DN) ,XIC(ResetAlarm) [XIC(MAM_VM_M5_Home.ER) CLR(MAM_VM_M5_Home.FLAGS) ,XIC(MAM_VM_M5_phase.ER) CLR(MAM_VM_M5_phase.FLAGS) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Enfase Virtual Axis master para  paletas dobladoresa (Folding Cam)

****************************************************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[XIC(MotorRunning)XIC(DB_M5_AxEnabled)[XIO(MAM_VM_M5_phase.IP) [XIC(M5Data.Motion.PhaseForwardCommand) ONS(ONS.19) MOV(HMI_M5_StepPhaser,VM_M5_Step_Phaser) ,XIC(M5Data.Motion.PhaseBackwardCommand) ONS(ONS.20) CPT(VM_M5_Step_Phaser,-1*HMI_M5_StepPhaser) ] MAM(VMaster_Folding_Cam,MAM_VM_M5_phase,1,VM_M5_Step_Phaser,HMI_M5_SpeedPhaser,Units per sec,50,% of Maximum,50,% of Maximum,Trapezoidal,100,100,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MAM_VM_M5_phase.IP) XIC(MachineStill) OTE(Folding_Cam_CMD_Jog) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[****************************************************************************************************************************************************************

Control de movimiemiento de  M5 para sincronia y Start/Stop de servo de paletas dobladoresa (Folding Cam)

****************************************************************************************************************************************************************]]>
</Comment>
<Text>
<![CDATA[[[XIO(NODE_Z1:8:I.5) XIC(stat_M5) ,XIC(Folding_Cam_CMD_Jog) ,XIC(HmiEnableSimulation) ] LIM(Start_Folding_Cam_Low,VMaster_Folding_Cam.ActualPosition,Start_Folding_Cam_Hi) ONS(ONS.21) OTL(Folding_Cam_Start) ,[XIC(S:FS) ,XIC(Folding_Cam_CMD_Jog) ,XIC(HmiEnableSimulation) ,XIC(MAM_VM_M5_Home.PC) ] ONS(ONS.24) OTL(Auto_Phase_Folding_Cam) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[GRT(VMaster_Folding_Cam.AverageVelocity,500)XIC(MotorRunning)XIC(DB_M5_AxEnabled)XIC(Ready_To_Homing)XIC(Folding_Cam_Start)[SUB(VMaster_Folding_Cam.ActualVelocity,M5.AverageVelocity,Speed_M5_Diff) LES(Speed_M5_Diff,5) ,LES(M5_Delta_Position_ABS,1) TON(Timer_To_Stop_M5,?,?) ]MOV(VMaster_Folding_Cam.ActualVelocity,M5_Speed_MAM)XIO(Timer_To_Stop_M5.DN)XIC(Pulse.0)OTE(Aux_Bit.12);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Aux_Bit.12)ONS(ONS.22)[SUB(VMaster_Folding_Cam.ActualPosition,M5.ActualPosition,M5_Delta_Position) ,ABS(M5_Delta_Position,M5_Delta_Position_ABS) ]GRT(M5_Delta_Position_ABS,1)[MOV(M5_Delta_Position,Delta_Position) ,LES(Delta_Position,-180) ADD(Delta_Position,360,Delta_Position) ,GRT(Delta_Position,180) SUB(Delta_Position,360,Delta_Position) ,GRT(Delta_Position,20) MOV(20,Delta_Position) ,LES(Delta_Position,-20) MOV(-20,Delta_Position) ,MAM(M5,MAM_M5,1,Delta_Position,M5_Speed_MAM,Units per sec,90,% of Maximum,90,% of Maximum,S-Curve,90,90,% of Maximum,Disabled,Current,0,None,0,0) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(NODE_Z1:8:I.6)ONS(ONS.23)[XIC(NODE_Z1:8:I.5) ,XIO(stat_M5) ]XIO(Folding_Cam_CMD_Jog)XIO(HmiEnableSimulation)[OTU(Folding_Cam_Start) MOV(VMaster_Folding_Cam.ActualPosition,Start_Folding_Cam_Position) ,ADD(Start_Folding_Cam_Position,10,Start_Folding_Cam_Hi) SUB(Start_Folding_Cam_Position,20,Start_Folding_Cam_Low) ,GRT(Start_Folding_Cam_Hi,360) SUB(Start_Folding_Cam_Hi,360,Start_Folding_Cam_Hi) ,LES(Start_Folding_Cam_Low,0) ADD(Start_Folding_Cam_Low,360,Start_Folding_Cam_Low) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
M5 - FOLDING CAMS
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

ACTIVAR Y VELOCIDAD DE LA GESTIÓN DEL MOTOR
(se resaltan los parámetros fundamentales que se establecerán y que estaban previamente en INIT)
(NOTA: si el grupo hace dos piezas por revolución del codificador, ponga 2 en el HMIRollDiameter)
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[AHT_Enable_DriveAxis(EDA_M5,StartMotors,MachineMoving,OFF,HMI_Enable_M5) MOV(1,M5Data.Input.AxPar.HmiRollDiameter) ,XIC(Convertion) SSV(Axis,M5,ConversionConstant,M5_ConversionConstant) SSV(Axis,M5,PositionUnwind,M5_Position_Unwind) ,XIC(Clock_100ms) [[XIC(HMI_M5_PhaseForward_Button) ,XIC(Input_SEL_PhaseFOR_M5) ,XIC(Phaser_ON.5) XIC(HMI_Main_PhaserFORW) ,XIC(M2Data.Motion.PhaseForwardCommand) ] OTE(M5Data.Motion.PhaseForwardCommand) ,[XIC(HMI_M5_PhaseBack_Button) ,XIC(Input_SEL_PhaseREV_M5) ,XIC(Phaser_ON.5) XIC(HMI_Main_PhaserREV) ,XIC(M2Data.Motion.PhaseBackwardCommand) ] OTE(M5Data.Motion.PhaseBackwardCommand) ] ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[Servo_Manager_1(ServoManager_M5,M5,Axis.GroupSynced,ResetAlarm,EDA_M5.Enable_Cond,DB_M5_AxEnabled) ,XIC(MotorRunning) XIC(DB_M5_AxEnabled) [XIC(Folding_Cam_Start) MAG(M5,VMaster_Folding_Cam,MAG_M5,0,1,0,0,Actual,Real,Enabled,250,% of Maximum) ,XIO(Folding_Cam_Start) MAS(M5,MAS_M5,Gear,Yes,250,% of Maximum,No,250,% of Maximum) ] ,[XIC(MAG_M5.ER) ,XIC(MAS_M5.ER) ,XIC(MAM_M5.ER) ] OTE(Folding_Cam_Alarm_Present) ,XIC(ResetAlarm) XIC(Folding_Cam_Alarm_Present) XIC(Folding_Cam_Alarm_Present) OTU(Folding_Cam_Start) CLR(MAG_M5.FLAGS) CLR(MAS_M5.FLAGS) CLR(MAM_M5.FLAGS) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R015_Drives_Homing" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
HMI Bit management to enable the pushbuttons to store the Delta Position between Master and Slave
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[XIC(MachineStill)ONS(Aux_Bit.9)OTL(HMI_Enable_Storage_DeltaPos);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(MachineMoving)ONS(Aux_Bit.10)OTU(HMI_Enable_Storage_DeltaPos);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(MachineStill)ONS(Aux_Bit.11)[XIO(HmiEnableSimulation) XIC(MotorRunning_Delayed) XIC(PowerOK) OTL(Automatic_MemPosition) ,TOF(Timer_MemPosition,?,?) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(HmiEnableSimulation) ,XIO(HmiEnableSimulation) XIO(MotorRunning_Delayed) ,XIO(PowerOK) ,XIO(Timer_MemPosition.EN) XIO(Timer_MemPosition.DN) ]OTU(Automatic_MemPosition);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
AXIS PAD CUT PHASE POSITIONING - M1
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[AFI()[XIC(HMI_M1_MemPosition) ,XIC(HMI_MemPosition_All_Axis) ,AFI() XIC(Timer_M1_MemPosition.DN) ]OTE(M1_MemPosition);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[SUB(Master.ActualPosition,M1.ActualPosition,Delta_1);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[AHT_Delta_PhaseMotors(M1_DeltaPhase,MachineStill,M1_MemPosition,Master.ActualPosition,M1.ActualPosition,Size_S,Size_M,Size_L,Size_XL,Size_XXL,M1_DeltaPos_Size_S,M1_DeltaPos_Size_M,M1_DeltaPos_Size_L,M1_DeltaPos_Size_XL,M1_DeltaPos_Size_XXL);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(M1_Cmd_Reference_HMI) TON(M1_Cmd_Reference_Timer,?,?) XIC(M1_Cmd_Reference_Timer.DN) MAH(M1,M1_MAH_1) ,XIC(ResetAlarm) XIC(M1_MAH_1.ER) CLR(M1_MAH_1.FLAGS) ,OTU(Homing_Sequence_M1) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(DB_M1.AxEnabled) TON(M1_Timer_Homing,?,?) XIC(M1_Timer_Homing.DN) [XIC(M1.AxisHomedStatus) ONS(ONS1[1].1) OTE(Start_Homing_M1) ,AFI() XIO(BIT[0].2) XIO(M1.AxisHomedStatus) ONS(ONS1[1].0) OTL(Homing_Sequence_M1) ] ,XIC(Glue_Rack_3:2:I.14) OSR(OSR_C_Inicial,OSR_C_Inicial_1) ,XIC(OSR_C_Inicial_1) TOF(Bit_Retention_C_Inicial,?,?) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Homing_Sequence_M1)XIC(DB_M1.AxEnabled)XIO(MachineMoving)TON(M1_Timer_InHoming,?,?)XIC(M1_Timer_InHoming.DN)[[XIO(Bit_Retention_C_Inicial.DN) XIO(M1_MAJ.IP) MAJ(M1,M1_MAJ,M1_MAJ_Direction,Speed_Jog_M1,Units per sec,50,Units per sec2,50,% of Maximum,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None) ,XIC(Bit_Retention_C_Inicial.DN) XIO(M1_MAS.IP) MAS(M1,M1_MAS,Jog,Yes,1000,Units per sec2,No,1000,Units per sec3) XIC(M1_MAS.PC) OTL(CMD_Home_M1) ] ,XIC(CMD_Home_M1) XIC(Bit_Retention_C_Inicial.DN) XIO(M1_MAH.IP) MAH(M1,M1_MAH) XIC(M1_MAH.PC) OTU(CMD_Home_M1) OTU(Homing_Sequence_M1) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(M1_MAJ.ER) ,XIC(M1_MAS.ER) ,XIC(M1_MAH.ER) ]OTE(Error_Home_M1);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(ResetAlarm)XIC(Error_Home_M1)OTU(CMD_Home_M1)OTU(Homing_Sequence_M1)CLR(M1_MAS.FLAGS)CLR(M1_MAH.FLAGS)CLR(M1_MAJ.FLAGS);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
Homing direction - 3 (positive), 4 (negative)
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[AHT_Homing(M1_Homing,M1,MAM_M1_HOME,MotorRunning,MachineMoving,DB_M1.AxEnabled,Start_Homing_M1,Master.ActualPosition,ResetAlarm,Size_S,Size_M,Size_L,Size_XL,Size_XXL,M1_DeltaPos_Size_S,M1_DeltaPos_Size_M,M1_DeltaPos_Size_L,M1_DeltaPos_Size_XL,M1_DeltaPos_Size_XXL,Ready_To_Homing_M1,M1_Homing.IstFaultCode);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[XIC(Size_S) MOV(M1_DeltaPos_Size_S,Mx_HMI_DeltaPos[1]) ,XIC(Size_M) MOV(M1_DeltaPos_Size_M,Mx_HMI_DeltaPos[1]) ,XIC(Size_L) MOV(M1_DeltaPos_Size_L,Mx_HMI_DeltaPos[1]) ,XIC(Size_XL) MOV(M1_DeltaPos_Size_XL,Mx_HMI_DeltaPos[1]) ,XIC(Size_XXL) MOV(M1_DeltaPos_Size_XXL,Mx_HMI_DeltaPos[1]) ,XIC(MachineStill) MOV(M1.ActualPosition,Mx_HMI_ActualPosition[1]) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIC(BIT[6].10) [XIO(BIT[6].12) XIC(MachineStill) ,XIC(BIT[6].12) XIC(MachineStill) XIC(BIT[8].7) ] [TON(MEM_POS_TON,?,?) ,XIC(MEM_POS_TON.DN) [XIO(MEM_POS_DIS_TON.DN) OTE(BIT[6].9) ,TON(MEM_POS_DIS_TON,?,?) ] ] ,XIC(MachineMoving) TON(M2_RUN_NEW_TMR,?,?) ,GRT(M2_RUN_NEW_TMR.ACC,H_LIM_M2_RUN) OTL(BIT[8].7) ,XIC(MEM_POS_DIS_TON.DN) OTU(BIT[8].7) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
AXIS FINAL CUT PHASE POSITIONING - M2
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_M2_MemPosition) ,XIC(HMI_MemPosition_All_Axis) ,AFI() XIC(Timer_M2_MemPosition.DN) ,XIC(BIT[6].9) ]OTE(M2_MemPosition);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[SUB(Master.ActualPosition,M2.ActualPosition,Delta_2);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[AHT_Delta_PhaseMotors(M2_DeltaPhase,MachineStill,M2_MemPosition,Master.ActualPosition,M2.ActualPosition,Size_S,Size_M,Size_L,Size_XL,Size_XXL,M2_DeltaPos_Size_S,M2_DeltaPos_Size_M,M2_DeltaPos_Size_L,M2_DeltaPos_Size_XL,M2_DeltaPos_Size_XXL);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[[XIO(BIT[7].12) ,XIC(BIT[4].11) ][XIC(DB_M2.AxEnabled) TON(M2_Timer_Homing,?,?) XIC(M2_Timer_Homing.DN) [XIC(M2.AxisHomedStatus) ONS(ONS1[1].2) OTL(Start_Homing_M2) ,XIO(M2.AxisHomedStatus) ONS(ONS1[1].4) OTL(Homing_Sequence_M2) ,XIC(Start_Homing_M2) TON(Timer_Start_Homing_M2,?,?) XIC(Timer_Start_Homing_M2.DN) OTU(Start_Homing_M2) ] ,XIC(Glue_Rack_3:2:I.15) OSR(OSR_C_Final,OSR_C_Final_1) ,XIC(OSR_C_Final_1) TOF(Bit_Retention_C_Final,?,?) ,NOP() ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIO(BIT[7].12) ,XIC(BIT[4].11) ]XIC(Homing_Sequence_M2)XIC(DB_M2.AxEnabled)XIO(MachineMoving)TON(M2_Timer_InHoming,?,?)XIC(M2_Timer_InHoming.DN)[[XIO(Bit_Retention_C_Final.DN) XIO(M2_MAJ.IP) MAJ(M2,M2_MAJ,M2_MAJ_Direction,Speed_Jog_M2,Units per sec,50,Units per sec2,50,% of Maximum,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None) ,XIC(Bit_Retention_C_Final.DN) XIO(M2_MAS.IP) MAS(M2,M2_MAS,Jog,Yes,1000,Units per sec2,No,1000,Units per sec3) XIC(M2_MAS.PC) OTL(CMD_Home_M2) ] ,XIC(CMD_Home_M2) XIC(Bit_Retention_C_Final.DN) XIO(M2_MAH.IP) MAH(M2,M2_MAH) XIC(M2_MAH.PC) OTU(CMD_Home_M2) OTU(Homing_Sequence_M2) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[[XIC(M2_MAJ.ER) ,XIC(M2_MAS.ER) ,XIC(M2_MAH.ER) ]OTE(Error_Home_M2);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(ResetAlarm)XIC(Error_Home_M2)OTU(CMD_Home_M2)OTU(Homing_Sequence_M2)CLR(M2_MAS.FLAGS)CLR(M2_MAH.FLAGS)CLR(M2_MAJ.FLAGS);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
Homing direction - 3 (positive), 4 (negative)
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[AHT_Homing(M2_Homing,M2,MAM_M2_HOME,MotorRunning,MachineMoving,DB_M2.AxEnabled,Start_Homing_M2,Master.ActualPosition,ResetAlarm,Size_S,Size_M,Size_L,Size_XL,Size_XXL,M2_DeltaPos_Size_S,M2_DeltaPos_Size_M,M2_DeltaPos_Size_L,M2_DeltaPos_Size_XL,M2_DeltaPos_Size_XXL,Ready_To_Homing_M2,M2_Homing.IstFaultCode);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[[XIC(Size_S) MOV(M2_DeltaPos_Size_S,Mx_HMI_DeltaPos[2]) ,XIC(Size_M) MOV(M2_DeltaPos_Size_M,Mx_HMI_DeltaPos[2]) ,XIC(Size_L) MOV(M2_DeltaPos_Size_L,Mx_HMI_DeltaPos[2]) ,XIC(Size_XL) MOV(M2_DeltaPos_Size_XL,Mx_HMI_DeltaPos[2]) ,XIC(Size_XXL) MOV(M2_DeltaPos_Size_XXL,Mx_HMI_DeltaPos[2]) ,XIC(MachineStill) MOV(M2.ActualPosition,Mx_HMI_ActualPosition[2]) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
AXIS SHAPING CUT PHASE POSITIONING - M3
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[XIC(HMI_M3_MemPosition) ,XIC(HMI_MemPosition_All_Axis) ,AFI() XIC(Timer_M3_MemPosition.DN) ]OTE(M3_MemPosition);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[SUB(Master.ActualPosition,M3.ActualPosition,Delta);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[AHT_Delta_PhaseMotors(M3_DeltaPhase,MachineStill,M3_MemPosition,Master.ActualPosition,M3.ActualPosition,Size_S,Size_M,Size_L,Size_XL,Size_XXL,M3_DeltaPos_Size_S,M3_DeltaPos_Size_M,M3_DeltaPos_Size_L,M3_DeltaPos_Size_XL,M3_DeltaPos_Size_XXL);]]>
</Text>
</Rung>
