</Text>
</Rung>
<Rung Number="77" Type="N">
<Text>
<![CDATA[XIC(right_cutter)OSF(ons.18,ons.19);]]>
</Text>
</Rung>
<Rung Number="78" Type="N">
<Text>
<![CDATA[XIC(ons.17)XIC(running)OTL(bool1.24);]]>
</Text>
</Rung>
<Rung Number="79" Type="N">
<Text>
<![CDATA[XIC(ons.19)XIC(running)OTL(bool1.25);]]>
</Text>
</Rung>
<Rung Number="80" Type="N">
<Text>
<![CDATA[XIC(bool1.24)TON(timer50,?,?);]]>
</Text>
</Rung>
<Rung Number="81" Type="N">
<Text>
<![CDATA[XIC(bool1.25)TON(timer51,?,?);]]>
</Text>
</Rung>
<Rung Number="82" Type="N">
<Text>
<![CDATA[XIC(timer50.DN)OTU(bool1.24);]]>
</Text>
</Rung>
<Rung Number="83" Type="N">
<Text>
<![CDATA[XIC(timer51.DN)OTU(bool1.25);]]>
</Text>
</Rung>
<Rung Number="84" Type="N">
<Text>
<![CDATA[[XIC(bool1.17) ,XIC(bool1.21) ]OTE(Splice_mill);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
