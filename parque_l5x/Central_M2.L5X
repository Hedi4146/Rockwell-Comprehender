</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[JSR(R003_Vertical,0) ,JSR(R002_Stripper,0) ,JSR(R001_Compresor,0) ,JSR(R000_Carro,0) ];]]>
