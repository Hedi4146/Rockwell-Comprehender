<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(MotorRunning)XIO(MachineMoving)XIC(AxEnabled)XIO(Homing_Procedure)[XIC(HMI_StartHoming) ONS(aux2) OTL(Homing_Procedure) ,OTE(Ready_To_Homing) ,SUB(Master_ActualPosition,DELTA_Pos_Motor,Homing_DeltaPosition) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Homing_Procedure)ONS(aux4)[GEQ(Homing_DeltaPosition,0) MOV(Homing_DeltaPosition,New_Position) ,LES(Homing_DeltaPosition,0) ADD(360,Homing_DeltaPosition,New_Position) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[SUB(Physical_axis.ActualPosition,New_Position,DELTA_DIRECTION_HOME) ABS(DELTA_DIRECTION_HOME,DELTA_DIRECTION_HOME) ,GRT(Physical_axis.ActualPosition,New_Position) [LIM(0,DELTA_DIRECTION_HOME,180) MOV(Home_Dir,Homing_Direction) ,LIM(181,DELTA_DIRECTION_HOME,359) MOV(Home_Dir,Homing_Direction) ] ,LES(Physical_axis.ActualPosition,New_Position) [LIM(0,DELTA_DIRECTION_HOME,180) MOV(Home_Dir,Homing_Direction) ,LIM(181,DELTA_DIRECTION_HOME,359) MOV(Home_Dir,Homing_Direction) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Homing_Procedure)[XIO(MAM_HOME.IP) MAM(Physical_axis,MAM_HOME,Homing_Direction,New_Position,Speed,Units per sec,100,Units per sec2,100,Units per sec2,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None,0,0) ,XIC(MAM_HOME.IP) OTU(Homing_Procedure) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(MAM_HOME.ER)MOV(MAM_HOME.ERR,IstFaultCode)OTE(Er);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(ResetAxAlarm)XIC(MAM_HOME.ER)CLR(MAM_HOME.FLAGS);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
