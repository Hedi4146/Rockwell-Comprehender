<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(Data.Motion.GearAbsoluteAxPhased) XIC(PhysicalAx.GearingLockStatus) OTE(AxSyncro) ,XIC(PhysicalAx.AxisHomedStatus) OTE(AxHomed) ,XIO(AxEnabled) ONS(aux5) [CLR(Data.Motion.Stop.FLAGS) ,CLR(Data.Motion.Gear.FLAGS) ,CLR(Data.Motion.ManualPhMamFw.FLAGS) ,CLR(Data.Motion.ManualPhMamBk.FLAGS) ,CLR(IstFaultCode) ,CLR(DriveFaultCode) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[[XIC(Data.Motion.Stop.ER) MOV(Data.Motion.Stop.ERR,IstFaultCode) ,XIC(Data.Motion.Gear.ER) MOV(Data.Motion.Gear.ERR,IstFaultCode) ,XIC(Data.Motion.ManualPhMamFw.ER) MOV(Data.Motion.ManualPhMamFw.ERR,IstFaultCode) ,XIC(Data.Motion.ManualPhMamBk.ER) MOV(Data.Motion.ManualPhMamBk.ERR,IstFaultCode) ,XIC(Data.Motion.ServoManager.ER) MOV(Data.Motion.ServoManager.IstError,IstFaultCode) ] OTE(Er) ,[XIC(ResetAxAlarm) ,XIC(PhysicalAx.InhibitStatus) ] [XIC(Data.Motion.Stop.ER) CLR(Data.Motion.Stop.FLAGS) ,XIC(Data.Motion.Gear.ER) CLR(Data.Motion.Gear.FLAGS) ,XIC(Data.Motion.ManualPhMamFw.ER) CLR(Data.Motion.ManualPhMamFw.FLAGS) ,XIC(Data.Motion.ManualPhMamBk.ER) CLR(Data.Motion.ManualPhMamBk.FLAGS) ,CLR(IstFaultCode) ,CLR(DriveFaultCode) ] ,XIO(PhysicalAx.InhibitStatus) [XIC(PhysicalAx.AxisFault.0) ,XIC(PhysicalAx.AxisFault.1) ,XIC(PhysicalAx.AxisFault.2) ] [OTE(AxFault) ,MOV(PhysicalAx.DriveFault,DriveFaultCode) ] ];]]>
</Text>
</Rung>
