<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Wrk_MAJ_Permissive)XIO(HMI_Cmd_Home)[XIC(Switch_ON_T.DN) ,XIC(Switch_OFF_T.DN) ]XIO(Wrk_Mirror)[MAJ(Ref_ServoAxis,Wrk_MI_MAJ,Wrk_MAJDirection,HMI_MAJ_Speed,Units per sec,HMI_Accel,Units per sec2,HMI_Decel,Units per sec2,Trapezoidal,ACCEL_J,DECEL_J,Units per sec3,Disabled,Programmed,0,None) ,NEQ(HMI_MAJ_Speed,Par_MAJ_Speed_Mirror) [OTE(Wrk_Mirror) ,MOV(HMI_MAJ_Speed,Par_MAJ_Speed_Mirror) ] ];]]>
