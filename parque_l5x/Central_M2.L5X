<Routine Name="I_O_Interface" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
*******************************************************
Interface InPut
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[XIC(NODE_Z1:5:I.0) OTE(Stacker_InPut.PB_Reset) ,XIC(NODE_Z1:5:I.1) OTE(Stacker_InPut.PB_Manual) ,XIC(NODE_Z1:5:I.2) OTE(Stacker_InPut.E_Stop_Op) ,XIC(NODE_Z1:5:I.3) OTE(Stacker_InPut.E_Stop_Front) ,XIO(NODE_Z1:5:I.4) OTE(Stacker_InPut.E_Stop_Main) ,XIO(NODE_Z1:5:I.5) OTE(Stacker_InPut.Torque_Safe_Off) ,XIC(OFF) OTE(Stacker_InPut.Torque_Safe_Off_Vertical) ,XIC(NODE_Z1:5:I.7) OTE(Stacker_InPut.Upper_Guard) ,XIC(NODE_Z1:7:I.0) OTE(Stacker_InPut.Lower_Guard) ,XIO(NODE_Z1:7:I.1) OTE(Stacker_InPut.Back_Guard) ,XIO(I01012) XIC(BIT[2].7) OTE(BIT[1].11) ,XIO(NODE_Z1:4:I.5) OTE(BIT[1].13) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(NODE_Z1:7:I.2) OTE(Stacker_InPut.Operator_Guard) ,XIC(NODE_Z1:7:I.3) OTE(Stacker_InPut.Sensor_Diapers) ,XIC(NODE_Z1:7:I.4) OTE(Stacker_InPut.Homing_Servo_Vertical) ,XIC(NODE_Z1:7:I.5) OTE(Stacker_InPut.Homing_Servo_Stripper) ,XIC(NODE_Z1:7:I.6) OTE(Stacker_InPut.Homing_Servo_Compress) ,XIC(NODE_Z1:7:I.7) OTE(Stacker_InPut.Homing_Servo_Car) ,XIC(NODE_Z1:8:I.0) OTE(Stacker_InPut.Homing_Servo_Exp_Op) ,XIC(NODE_Z1:8:I.1) OTE(Stacker_InPut.Homing_Servo_Exp_Dr) ,XIO(NODE_Z1:8:I.2) OTE(Stacker_InPut.Thermal_Alarm_220Vac) ,XIC(NODE_Z1:8:I.3) OTE(Stacker_InPut.Normal_Stop) ,XIO(NODE_Z1:8:I.4) OTE(Stacker_InPut.Thermal_Alarm_440Vac) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[
*******************************************************
Interface OutPut
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[XIC(Stacker_OutPut.CR_warning_counter_diapers) OTE(BIT[4].15) ,XIC(Stacker_OutPut.Status_Green_Light) OTE(NODE_Z1:1:O.3) ,[XIC(Stacker_OutPut.Status_Yellow_Light) ,XIC(Pulse.2) [XIC(Stacker_OutPut.CR_warning_counter_diapers) ,XIC(BIT[8].4) ] ] OTE(NODE_Z1:1:O.4) ,[XIC(Stacker_OutPut.Status_Red_Light) ,XIC(Pulse.2) XIC(BIT[8].4) ] OTE(NODE_Z1:1:O.5) ,XIC(Stacker_OutPut.PB_Reset_Blue_Light) OTE(NODE_Z1:1:O.6) ,XIC(Stacker_OutPut.PB_Manual_Green_Light) OTE(NODE_Z1:1:O.7) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[
*******************************************************
Interface HMI
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[XIO(Stacker_HMI.No_Golpes) ONS(BIT[5].0) OTU(Packing_X2) OTL(Packing_X1) ,XIC(Stacker_HMI.No_Golpes) ONS(BIT[5].1) OTU(Packing_X1) OTL(Packing_X2) ,[LES(Stacker_HMI.Move,1) ,GRT(Stacker_HMI.Move,3) ] MOV(1,Stacker_HMI.Move) ,EQU(Stacker_HMI.Move,1) ONS(BIT[5].2) OTU(Move_Side_Op_Dr) OTU(Move_Side_Dr) OTL(Move_Side_Op) ,EQU(Stacker_HMI.Move,2) ONS(BIT[5].3) OTU(Move_Side_Op_Dr) OTU(Move_Side_Op) OTL(Move_Side_Dr) ,EQU(Stacker_HMI.Move,3) ONS(BIT[5].4) OTU(Move_Side_Op) OTU(Move_Side_Dr) OTL(Move_Side_Op_Dr) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[
*******************************************************
Interface HMI
No of diapers is limited between 14 and 30 x strock
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[LES(Stacker_HMI.No_Diapers,14) MOV(14,Stacker_HMI.No_Diapers) ,LIM(14,Stacker_HMI.No_Diapers,30) MOV(Stacker_HMI.No_Diapers,Diapers_Counter.PRE) ,GRT(Stacker_HMI.No_Diapers,30) MOV(30,Stacker_HMI.No_Diapers) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[
*******************************************************
Interface HMI
Speed Simulation is limited between 150 and 410 PPM
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[LES(Stacker_HMI.Speed_Simulation,150) MOV(150,Stacker_HMI.Speed_Simulation) ,GRT(Stacker_HMI.Speed_Simulation,410) MOV(410,Stacker_HMI.Speed_Simulation) ,LIM(150,Stacker_HMI.Speed_Simulation,410) MOV(Stacker_HMI.Speed_Simulation,Speed_Simulation) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[
*******************************************************
Interface HMI
Set the activation time for compress and stripper
*******************************************************]]>
</Comment>
<Text>
<![CDATA[MOV(Stacker_HMI.Compress_Time,Compress_Time.PRE)MOV(Stacker_HMI.Stripper_Time,Stripper_Time.PRE);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
