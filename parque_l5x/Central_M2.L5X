<DataValueMember Name="Val_PositionDeviationFromProducer" DataType="REAL" Radix="Float" Value="0.0"/>
</Structure>
</DefaultData>
</LocalTag>
<LocalTag Name="Null" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[---------------------------------------------------------------------------------------------------------------------
A x i s C o n s u m e C I P S y n c _ A O I
---------------------------------------------------------------------------------------------------------------------

+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
Version         |       Date          |      Author            |   Description
+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
1.0                 | 2010 Sept 10  | Robert Günther   | Beta Release
-----------------------------------------------------------------------------------------------------------------------------------------
1.1                 | 2010 Sept 21  | Robert Günther   | Test Release new Features / extended Error Checks
-----------------------------------------------------------------------------------------------------------------------------------------
1.2                 | 2010 Oct 19   | Robert Günther   | Added Dynamics Limit and automatic Master Delay Compensation
-----------------------------------------------------------------------------------------------------------------------------------------
1.3                 | 2010 Nov 17  | Robert Günther   | Fix for an Anomaly in V18/V19 - MaxInterval Time of motion task can become negative
----------------------------------------------------------------------------------------------------------------------------------------
1.4                 | 2011 Mar   9  | Robert Günther   | Error 17 detection removed - GSV MaxInterval Time of   motion task does not work reliably
----------------------------------------------------------------------------------------------------------------------------------------

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Restart: init base values]]>
</Comment>
<Text>
<![CDATA[[XIC(Inp_Restart) ONS(ONS_Reset) OTU(Sts_ER) CLR(Err_No) ,XIC(PrepareRestart) ]OTU(PrepareRestart)OTE(Init);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Init)MOV(0.30103,lg2)CLR(MyState)MOV(Inp_AxisDataStructure.Counter,OldCounter)OTU(CU_Valid)CLR(CU_OkCnt);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Init)COP(MI_Zero,MI_MAJ_AxisConsumed,1)COP(MI_Zero,MI_MAM_AxisConsumedAbs,1)COP(MI_Zero,MI_MAJ_CST,1);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Init)MOV(1000000.0,AxisCST_MaxSpeed)MOV(10000000.0,AxisCST_MaxAcceleration)MOV(10000000.0,AxisCST_MaxDeceleration)MOV(1.00000000e+009,AxisCST_MaxJerk)MOV(1000.0,AxisCST_ConversionConstant)MOV(100000000,AxisCST_PositionUnwind);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Init)SSV(Axis,InOut_Axis_CSTAid,MaximumSpeed,AxisCST_MaxSpeed)SSV(Axis,InOut_Axis_CSTAid,MaximumAcceleration,AxisCST_MaxAcceleration)SSV(Axis,InOut_Axis_CSTAid,MaximumDeceleration,AxisCST_MaxDeceleration)SSV(Axis,InOut_Axis_CSTAid,MaximumAccelerationJerk,AxisCST_MaxJerk)SSV(Axis,InOut_Axis_CSTAid,MaximumDecelerationJerk,AxisCST_MaxJerk)SSV(Axis,InOut_Axis_CSTAid,ConversionConstant,AxisCST_ConversionConstant)SSV(Axis,InOut_Axis_CSTAid,PositionUnwind,AxisCST_PositionUnwind);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Init)SSV(Axis,Out_Axis_Consumed,MaximumSpeed,AxisCST_MaxSpeed)SSV(Axis,Out_Axis_Consumed,MaximumAcceleration,AxisCST_MaxAcceleration)SSV(Axis,Out_Axis_Consumed,MaximumDeceleration,AxisCST_MaxDeceleration)SSV(Axis,Out_Axis_Consumed,MaximumAccelerationJerk,AxisCST_MaxJerk)SSV(Axis,Out_Axis_Consumed,MaximumDecelerationJerk,AxisCST_MaxJerk);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Init)OTU(HelpTag)CLR(AxisCST_Vel0Cnt)CLR(Wrong_CSTTime_Cnt)MOV(60000,TON_Synchronized.PRE)MOV(30000,TON_DetectTimeMaster.PRE)MOV(500,TON_ReadSync.PRE)CLR(FaultState);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Init)CLR(TimeDifIntegrator)CLR(AccSystimeDif)CLR(Val_MySystimeDif);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Init)OTU(Val_ProducerMovedNegative)OTU(Val_ProducerMovedPositive)CLR(Accel_Limit1)CLR(Old_Val_Incr_Move);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[V1.3 Reset Motion Groups MaximumInterval after Restart]]>
</Comment>
<Text>
<![CDATA[XIC(Init)SSV(MotionGroup,Inp_MotionGroup,MaximumInterval,Null);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Start Aid axis if not running yet]]>
</Comment>
<Text>
<![CDATA[LES(InOut_Axis_CSTAid.CommandVelocity,99999)OTU(MI_MAJ_CST.EN)MAJ(InOut_Axis_CSTAid,MI_MAJ_CST,0,100000,Units per sec,1000000000,Units per sec2,1000000000,Units per sec2,Trapezoidal,0,0,% of Time,Disabled,Programmed,0,None);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Use synchronous copy to get consistent data from producer]]>
</Comment>
<Text>
<![CDATA[CPS(Inp_AxisDataStructure,P,1);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)COP(P,C.P,1);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[wait for first update from producer]]>
</Comment>
<Text>
<![CDATA[EQU(MyState,0)[EQU(P.Counter,OldCounter) ,XIO(P.ConnectionStatus.RunMode) ,XIC(P.ConnectionStatus.ConnectionFaulted) ,XIO(Inp_MotionGroup.GroupSynced) ]JMP(EndOfExtrapolation);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[EQU(MyState,0)[XIC(P.DisableAdvancedFeatures) OTL(oldDisableAdvancedFeatures) ,XIO(P.DisableAdvancedFeatures) OTU(oldDisableAdvancedFeatures) ,XIC(P.DisableExtendedErrorCheck) OTL(oldDisableExtendedErrorCheck) ,XIO(P.DisableExtendedErrorCheck) OTU(oldDisableExtendedErrorCheck) ]MAS(Out_Axis_Consumed,MI_MAS1,Jog,Yes,1000000000,Units per sec2,Yes,0,% of Time);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[---------------------------------------------------------------------------------------------------------------------
C S T     C a l c u l a t i o n
---------------------------------------------------------------------------------------------------------------------

Determine CST and SystemTime of Motion Task calculation
Build Difference between SystemTime of Motion Task Calculation at producer and my SystemTime of Motion Task calculation

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[TON(TON_ReadSync,?,?)XIC(TON_ReadSync.DN)RES(TON_ReadSync)OTE(CheckTimeSync);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(CheckTimeSync)GSV(TimeSynchronize,,OffsetFromMaster,OffsetFromMaster[0])[NEQ(OffsetFromMaster[0],0) ,NEQ(OffsetFromMaster[1],0) ]OTL(IamTimeSlave);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[EQU(OffsetFromMaster[0],0)EQU(OffsetFromMaster[1],0)TON(TON_DetectTimeMaster,?,?)XIC(TON_DetectTimeMaster.DN)OTU(IamTimeSlave);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[MOV(CU_Local_us,CU_Sum_us);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIO(P.DisableAdvancedFeatures)XIC(CU_Valid)GSV(Task,THIS,OverlapCount,MyOverlapCount)SUB(MyOverlapCount,oldOverlapCount,NewOverlapCounter)[GRT(NewOverlapCounter,0) MUL(NewOverlapCounter,CU_Local_us,CU_Sum_us) ADD(CU_Sum_us,CU_Local_us,CU_Sum_us) MUL(NewOverlapCounter,Out_Axis_Consumed.CommandVelocity,OldExtrapolation1) MUL(OldExtrapolation1,Val_CoarseUpdate_Sec,OldExtrapolation2) ADD(Old_ExtrapolationDistance,OldExtrapolation2,Old_ExtrapolationDistance) ,LES(NewOverlapCounter,0) ]MOV(MyOverlapCount,oldOverlapCount);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(CU_Valid)XIO(RG_DoubleCheck_CSTAccuarcy)ADD(Old_CSTTimeAtMotionPlannerCalculation,CU_Sum_us,CSTTimeAtMotionPlannerCalculation)MOV(CSTTimeAtMotionPlannerCalculation,Old_CSTTimeAtMotionPlannerCalculation)JMP(CalcTimeToProducer);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(CU_Valid)XIC(RG_DoubleCheck_CSTAccuarcy)ADD(Old_CSTTimeAtMotionPlannerCalculation,CU_Local_us,CSTTimeAtMotionPlannerCalculation_DCheck);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Use Axis_CSTAid to determine time of motion task calculation]]>
</Comment>
<Text>
<![CDATA[GSV(CST,,CurrentValue,CST_Time[0])SSV(Axis,InOut_Axis_CSTAid,InterpolationTime,CST_Time[0]);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)COP(CST_Time[0],C.C_CST[0],2);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Determine at what point of time (CST) my axes positions have been calculated -> CSTTimeAtMotionPlannerCalculation]]>
</Comment>
<Text>
<![CDATA[SUB(InOut_Axis_CSTAid.CommandPosition,InOut_Axis_CSTAid.InterpolatedCommandPosition,CST_DeltaPosition)GRT(CST_DeltaPosition,0)SUB(CST_DeltaPosition,100000,CST_DeltaPosition);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[NEQ(InOut_Axis_CSTAid.CommandVelocity,0)DIV(CST_DeltaPosition,InOut_Axis_CSTAid.CommandVelocity,TimeToCalculation)MUL(TimeToCalculation,1000000,TimeToCalculation_us)ADD(CST_Time[0],TimeToCalculation_us,CSTTimeAtMotionPlannerCalculation);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Comment>
<![CDATA[Verification of calculation time]]>
</Comment>
<Text>
<![CDATA[SSV(Axis,InOut_Axis_CSTAid,InterpolationTime,CSTTimeAtMotionPlannerCalculation)SUB(InOut_Axis_CSTAid.CommandPosition,InOut_Axis_CSTAid.InterpolatedCommandPosition,InterpolatedPosDif);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[if position difference is not 0 -> use old Coarse Update Period]]>
</Comment>
<Text>
<![CDATA[[NEQ(InterpolatedPosDif,0) ,LES(InOut_Axis_CSTAid.CommandVelocity,99999) ]CLR(CU_OkCnt)ADD(Old_CSTTimeAtMotionPlannerCalculation,CU_Local_us,CSTTimeAtMotionPlannerCalculation);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[GRT(InOut_Axis_CSTAid.CommandVelocity,99999)EQU(InterpolatedPosDif,0)[XIC(RG_DoubleCheck_CSTAccuarcy) XIC(CU_Valid) NEQ(CSTTimeAtMotionPlannerCalculation,CSTTimeAtMotionPlannerCalculation_DCheck) ADD(Wrong_CSTTime_Cnt,1,Wrong_CSTTime_Cnt) ,ADD(CU_OkCnt,1,CU_OkCnt) GEQ(CU_OkCnt,6) OTL(CU_Valid) ];]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[Build difference between last calculation time and current calculation time -> Coarse Update Period (CU_Local_us, CU_Local_sec)]]>
</Comment>
<Text>
<![CDATA[SUB(CSTTimeAtMotionPlannerCalculation,Old_CSTTimeAtMotionPlannerCalculation,TimeDif_BetweenCalc);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[MOV(TimeDif_BetweenCalc,CU_Local_us)MOV(CU_Local_us,Val_CoarseUpdate_us)DIV(CU_Local_us,1000000,Val_CoarseUpdate_Sec)MUL(CU_Local_us,2,CU_Local_us_Mul2);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[MOV(CSTTimeAtMotionPlannerCalculation,Old_CSTTimeAtMotionPlannerCalculation);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[LBL(CalcTimeToProducer)NOP();]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[no data from producer yet]]>
</Comment>
<Text>
<![CDATA[EQU(MyState,0)CLR(DifTime_ProducerConsumer)JMP(NoDataProducer);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Comment>
<![CDATA[Convert producer systemtime into local CST time with local SystemOffset
CST = SystemTime - Offset]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[GSV(TimeSynchronize,,SystemTimeAndOffset,SystemTimeAndOffset[0]);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)COP(SystemTimeAndOffset[0],C.C_Systime[0],4);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[SUB(P.SystemTimeAndOffset[0],SystemTimeAndOffset[2],CSTTime_Producer);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(CSTTime_Producer,C.CSTTime_Producer);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Comment>
<![CDATA[Substract System Time local from System Time producer -> DifTime_ProducerConsumer]]>
</Comment>
<Text>
<![CDATA[SUB(CSTTimeAtMotionPlannerCalculation,CSTTime_Producer,DifTime_ProducerConsumer);]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(DifTime_ProducerConsumer,C.DifTime_ProducerConsumer);]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Text>
<![CDATA[LBL(NoDataProducer)NOP();]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Text>
<![CDATA[EQU(MyState,0)NEQ(P.Counter,OldCounter)CLR(StartCounter)MOV(10,MyState);]]>
</Text>
</Rung>
<Rung Number="45" Type="N">
<Text>
<![CDATA[OTU(Val_FirstScan);]]>
</Text>
</Rung>
<Rung Number="46" Type="N">
<Text>
<![CDATA[EQU(10,MyState)ADD(StartCounter,1,StartCounter)GRT(StartCounter,10)OTU(Sts_ER)CLR(Err_No)OTL(Val_FirstScan)MOV(20,MyState);]]>
</Text>
</Rung>
<Rung Number="47" Type="N">
<Text>
<![CDATA[LES(MyState,20)JMP(EndOfExtrapolation);]]>
</Text>
</Rung>
<Rung Number="48" Type="N">
<Comment>
<![CDATA[---------------------------------------------------------------------------------------------------------------------
F i r s t    S c a n    I n i t    C o n s u m e r   A x i s
---------------------------------------------------------------------------------------------------------------------

Copy RotaryAxis, Conversion Constant and Position Unwind from Producer to Conumer
]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="49" Type="N">
<Text>
<![CDATA[XIC(Val_FirstScan)CLR(ProducedIsRotaryAxis)[XIC(P.RotaryAxis) OTL(ProducedIsRotaryAxis.0) ,XIO(P.RotaryAxis) OTU(ProducedIsRotaryAxis.0) ]SSV(Axis,Out_Axis_Consumed,RotaryAxis,ProducedIsRotaryAxis);]]>
</Text>
</Rung>
<Rung Number="50" Type="N">
<Text>
<![CDATA[XIC(Val_FirstScan)[SSV(Axis,Out_Axis_Consumed,ConversionConstant,P.ConversionConstant) ,XIC(P.RotaryAxis) SSV(Axis,Out_Axis_Consumed,PositionUnwind,P.PositionUnwind) DIV(P.PositionUnwind,P.ConversionConstant,MyUnwindPosition) ];]]>
</Text>
</Rung>
<Rung Number="51" Type="N">
<Text>
<![CDATA[XIC(Val_FirstScan)MOV(0.5,MaxProducedPosition);]]>
</Text>
</Rung>
<Rung Number="52" Type="N">
<Text>
<![CDATA[XIC(Val_FirstScan)[MOV(Inp_Timeout_mSec,TON_TimeOut.PRE) [LEQ(Inp_Timeout_mSec,0) MOV(50,TON_TimeOut.PRE) ,GRT(Inp_Timeout_mSec,100) MOV(100,TON_TimeOut.PRE) ] ,MUL(TON_TimeOut.PRE,1000,TimeOut_us) ];]]>
</Text>
</Rung>
<Rung Number="53" Type="N">
<Text>
<![CDATA[XIC(Val_FirstScan)[GEQ(CU_Local_us,P.CU_P_us) MUL(CU_Local_us,5,Max_DelayCompensation) ,LES(CU_Local_us,P.CU_P_us) MUL(P.CU_P_us,5,Max_DelayCompensation) ];]]>
</Text>
</Rung>
<Rung Number="54" Type="N">
<Text>
<![CDATA[XIC(Val_FirstScan)GSV(Axis,Out_Axis_Consumed,AxisInstance,OldMyAxisInstance);]]>
</Text>
</Rung>
<Rung Number="55" Type="N">
<Comment>
<![CDATA[---------------------------------------------------------------------------------------------------------------------
E r r o r    C h e c k s
---------------------------------------------------------------------------------------------------------------------

]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="56" Type="N">
<Text>
<![CDATA[XIC(Sts_ER)JMP(FaultHandler);]]>
</Text>
</Rung>
<Rung Number="57" Type="N">
<Comment>
<![CDATA[ERROR: Producer not in RUN Mode]]>
</Comment>
<Text>
<![CDATA[XIO(P.ConnectionStatus.RunMode)MOV(1,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="58" Type="N">
<Comment>
<![CDATA[ERROR: Connection to Producer faulted]]>
</Comment>
<Text>
<![CDATA[XIC(P.ConnectionStatus.ConnectionFaulted)MOV(2,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="59" Type="N">
<Comment>
<![CDATA[ERROR: Producer's Coarse Update is wrong]]>
</Comment>
<Text>
<![CDATA[EQU(MyState,20)XIO(Val_FirstScan)LEQ(P.CU_P_us,0)MOV(3,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="60" Type="N">
<Comment>
<![CDATA[ERROR: Producer did run 20 updates before consumer got new data]]>
</Comment>
<Text>
<![CDATA[EQU(MyState,20)XIO(Val_FirstScan)[SUB(P.Counter,OldCounter,CounterDif) LES(CounterDif,0) ADD(CounterDif,1000,CounterDif) ,GRT(CounterDif,20) MOV(4,Err_No) OTL(Sts_ER) ];]]>
</Text>
</Rung>
<Rung Number="61" Type="N">
<Comment>
<![CDATA[ERROR: DifTime_ProducerConsumer exceeds Timout

(value can actually be negative if producer motion calculation time is later than consumer motion calculation time - so dont check for negative values)
]]>
</Comment>
<Text>
<![CDATA[EQU(MyState,20)XIO(Val_FirstScan)GRT(DifTime_ProducerConsumer,TimeOut_us)ADD(TimeOutCnt,1,TimeOutCnt)MOV(5,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="62" Type="N">
<Comment>
<![CDATA[ERROR:Timeout since last update frome producer]]>
</Comment>
<Text>
<![CDATA[EQU(MyState,20)XIO(Val_FirstScan)EQU(P.Counter,OldCounter)MOV(Inp_Timeout_mSec,TON_TimeOut.PRE)TON(TON_TimeOut,?,?)XIC(TON_TimeOut.DN)MOV(6,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="63" Type="N">
<Comment>
<![CDATA[ERROR: Wrong extrapolation type from Producer]]>
</Comment>
<Text>
<![CDATA[EQU(MyState,20)XIO(Val_FirstScan)[GRT(P.ExtrapolationType,2) ,LES(P.ExtrapolationType,0) ]MOV(7,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="64" Type="N">
<Comment>
<![CDATA[ERROR: Additional delay compensation (producer+ consumer) too long]]>
</Comment>
<Text>
<![CDATA[ADD(P.AdditionalDelayCompensation_us,Inp_AdditionalDelayCompensation_us,MyAdditionalDelaycompensation)ABS(MyAdditionalDelaycompensation,AbsMyAdditionalDelaycompensation)GRT(AbsMyAdditionalDelaycompensation,Max_DelayCompensation)MOV(8,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="65" Type="N">
<Text>
<![CDATA[EQU(MyState,20)XIO(Val_FirstScan)[XIC(MI_MAJ_AxisConsumed.ER) ,XIC(MI_MAM_AxisConsumedAbs.ER) ]MOV(9,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="66" Type="N">
<Comment>
<![CDATA[ERROR:DisableAdvancedFeatures has changed]]>
</Comment>
<Text>
<![CDATA[[XIC(P.DisableAdvancedFeatures) XIO(oldDisableAdvancedFeatures) ,XIO(P.DisableAdvancedFeatures) XIC(oldDisableAdvancedFeatures) ]MOV(10,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="67" Type="N">
<Comment>
<![CDATA[ERROR: DisableExtendedErrorChacks turned off]]>
</Comment>
<Text>
<![CDATA[XIO(P.DisableExtendedErrorCheck)XIC(oldDisableExtendedErrorCheck)MOV(11,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="68" Type="N">
<Comment>
<![CDATA[ERROR:Time Synchronization disabled]]>
</Comment>
<Text>
<![CDATA[XIC(CheckTimeSync)GSV(TimeSynchronize,,PTPEnable,PTPEnable)EQU(PTPEnable,0)MOV(12,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="69" Type="N">
<Comment>
<![CDATA[ERROR:Time Synchronization off for more than 1 minute]]>
</Comment>
<Text>
<![CDATA[EQU(MyState,20)[XIC(CheckTimeSync) GSV(TimeSynchronize,,IsSynchronized,SystemTimeSynchronized) ,XIO(CheckTimeSync) ]XIC(IamTimeSlave)XIO(SystemTimeSynchronized.0)TON(TON_Synchronized,?,?)XIC(TON_Synchronized.DN)MOV(12,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="70" Type="N">
<Comment>
<![CDATA[-------------------------------------------------
Extended error checks]]>
</Comment>
<Text>
<![CDATA[XIC(P.DisableExtendedErrorCheck)JMP(NoExtendedErrorCheck);]]>
</Text>
</Rung>
<Rung Number="71" Type="N">
<Comment>
<![CDATA[ERROR: Rotary Axis configuration has changed on the fly]]>
</Comment>
<Text>
<![CDATA[EQU(MyState,20)XIO(Val_FirstScan)[XIC(ProducedIsRotaryAxis.0) XIO(P.RotaryAxis) ,XIO(ProducedIsRotaryAxis.0) XIC(P.RotaryAxis) ]MOV(13,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="72" Type="N">
<Comment>
<![CDATA[ERROR: Axis Unwind / Conversion Constant has changed on the fly]]>
</Comment>
<Text>
<![CDATA[EQU(MyState,20)XIO(Val_FirstScan)XIC(P.RotaryAxis)DIV(P.PositionUnwind,P.ConversionConstant,CurrentUnwind)NEQ(CurrentUnwind,MyUnwindPosition)MOV(14,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="73" Type="N">
<Comment>
<![CDATA[ERROR: Auto Tag update not enabled]]>
</Comment>
<Text>
<![CDATA[XIO(MI_MAJ_CST.ER)EQU(InOut_Axis_CSTAid.CommandVelocity,0)ADD(AxisCST_Vel0Cnt,1,AxisCST_Vel0Cnt)GEQ(AxisCST_Vel0Cnt,10)MOV(15,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="74" Type="N">
<Text>
<![CDATA[GSV(MotionGroup,Inp_MotionGroup,AutoTagUpdate,MG_AutoTagUpdate)XIO(MG_AutoTagUpdate.0)MOV(15,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="75" Type="N">
<Comment>
<![CDATA[ERROR: Axis has been exchanged by program change online]]>
</Comment>
<Text>
<![CDATA[EQU(MyState,20)XIO(Val_FirstScan)GSV(Axis,Out_Axis_Consumed,AxisInstance,MyAxisInstance)NEQ(MyAxisInstance,OldMyAxisInstance)MOV(16,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="76" Type="N">
<Comment>
<![CDATA[ERROR: wrong timing, AOI not executed in a motion group triggered event task]]>
</Comment>
<Text>
<![CDATA[AFI()EQU(MyState,20)XIC(CU_Valid)XIC(HelpTag)[SUB(InOut_Axis_CSTAid.CommandPosition,OldCSTAxis_Position,Measured_PosDifference_Between_AOI_Calls) ,LES(Measured_PosDifference_Between_AOI_Calls,0) ADD(Measured_PosDifference_Between_AOI_Calls,100000,Measured_PosDifference_Between_AOI_Calls) ]MUL(InOut_Axis_CSTAid.CommandVelocity,Val_CoarseUpdate_Sec,PosDifference_Between_AOI_Calls)SUB(Measured_PosDifference_Between_AOI_Calls,PosDifference_Between_AOI_Calls,DifPos_CallPeriod)[DIV(DifPos_CallPeriod,InOut_Axis_CSTAid.CommandVelocity,DifTime_CAllPeriod) ,GSV(MotionGroup,Inp_MotionGroup,MaximumInterval,MG_MaxInterval[0]) SUB(MG_MaxInterval[0],CU_Local_us,MG_CU_Difference) ][LIM(0.001,DifTime_CAllPeriod,-0.001) ,LES(MG_CU_Difference,0) ]EQU(NewOverlapCounter,0)MOV(17,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="77" Type="N">
<Text>
<![CDATA[EQU(MyState,20)XIC(CU_Valid)OTL(HelpTag)MOV(InOut_Axis_CSTAid.CommandPosition,OldCSTAxis_Position);]]>
</Text>
</Rung>
<Rung Number="78" Type="N">
<Text>
<![CDATA[EQU(MyState,20)XIC(P.AxisStatus.0)ONS(ONS_UseActual)[XIC(P.UseActual) OTL(old_UseActual) ,XIO(P.UseActual) OTU(old_UseActual) ];]]>
</Text>
</Rung>
<Rung Number="79" Type="N">
<Comment>
<![CDATA[ERROR: Producer  has ServoActionStatus=1  but UseActual changes on the fly]]>
</Comment>
<Text>
<![CDATA[EQU(MyState,20)XIC(P.AxisStatus.0)[XIC(P.UseActual) XIO(old_UseActual) ,XIO(P.UseActual) XIC(old_UseActual) ]MOV(18,Err_No)OTL(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="80" Type="N">
<Text>
<![CDATA[LBL(NoExtendedErrorCheck)NOP();]]>
</Text>
</Rung>
<Rung Number="81" Type="N">
<Text>
<![CDATA[XIO(Sts_ER)JMP(Extrapolation);]]>
</Text>
</Rung>
<Rung Number="82" Type="N">
<Comment>
<![CDATA[---------------------------------------------------------------------------------------------------------------------
F a u l t   H a n d l e r
---------------------------------------------------------------------------------------------------------------------

]]>
</Comment>
<Text>
<![CDATA[LBL(FaultHandler)NOP();]]>
</Text>
</Rung>
<Rung Number="83" Type="N">
<Comment>
<![CDATA[Fault State 20: wait until consumed axis has ramped to 0 speed - recover if selected]]>
</Comment>
<Text>
<![CDATA[EQU(FaultState,20)EQU(Out_Axis_Consumed.CommandVelocity,0)XIC(Inp_AutoRecover)OTL(PrepareRestart);]]>
</Text>
</Rung>
<Rung Number="84" Type="N">
<Comment>
<![CDATA[In this state, the axis is running with MAJ at constant speed
If a stop ramp is configured that consumed axis is ramped to 0 with this speed
If no stop ramp is configured it will stay in this state and do nothing until Inp_Restart is set again]]>
</Comment>
<Text>
<![CDATA[[EQU(FaultState,0) XIO(oldDisableAdvancedFeatures) ,EQU(FaultState,10) ]GRT(Inp_StopRampOnFault_UnitsSec2,0)[OTU(MI_MAJ_to_0.EN) MAJ(Out_Axis_Consumed,MI_MAJ_to_0,0,0,Units per sec,Inp_StopRampOnFault_UnitsSec2,Units per sec2,Inp_StopRampOnFault_UnitsSec2,Units per sec2,Trapezoidal,0,0,% of Time,Disabled,Programmed,0,None) ,MOV(20,FaultState) ];]]>
</Text>
</Rung>
<Rung Number="85" Type="N">
<Comment>
<![CDATA[Fault State 0 and oldDisableAdvancedFeatures:
If STS_IP: The last MAM of the axis has been executed, so it would be in a stop
In order to allow a stop ramp we continue with an MAJ to last received velocity
Afterwards we may ramp down to 0 speed in state 10 - if a stop ramp is configured]]>
</Comment>
<Text>
<![CDATA[EQU(FaultState,0)XIC(oldDisableAdvancedFeatures)[XIC(Sts_IP) MAJ(Out_Axis_Consumed,MI_MAJ_to_LastVel,0,P.Velocity,Units per sec,Inp_StopRampOnFault_UnitsSec2,Units per sec2,Inp_StopRampOnFault_UnitsSec2,Units per sec2,Trapezoidal,0,0,% of Time,Enabled,Programmed,0,None) ,XIO(Sts_IP) ]MOV(10,FaultState);]]>
</Text>
</Rung>
<Rung Number="86" Type="N">
<Text>
<![CDATA[JMP(EndOfExtrapolation);]]>
</Text>
</Rung>
<Rung Number="87" Type="N">
<Comment>
<![CDATA[---------------------------------------------------------------------------------------------------------------------
C o n s u m e d     A x i s     E x t r a p o l a t i o n     A l g o r i t h m 
---------------------------------------------------------------------------------------------------------------------

]]>
</Comment>
<Text>
<![CDATA[LBL(Extrapolation)NOP();]]>
</Text>
</Rung>
<Rung Number="88" Type="N">
<Text>
<![CDATA[XIC(Val_FirstScan)CLR(Old_ExtrapolationDistance);]]>
</Text>
</Rung>
<Rung Number="89" Type="N">
<Text>
<![CDATA[XIC(Val_FirstScan)XIC(P.RotaryAxis)DIV(MyUnwindPosition,2,UnwindDifLimit)NEG(UnwindDifLimit,UnwindDifLimitNeg)[GRT(MyUnwindPosition,MaxProducedPosition) MOV(MyUnwindPosition,MaxProducedPosition) ,LES(MyUnwindPosition,MaxProducedPosition) ]LOG(MyUnwindPosition,LogMaxProducedPosition)DIV(LogMaxProducedPosition,lg2,Lg2Unwind)SUB(Lg2Unwind,23,LG2Quant)XPY(2,LG2Quant,UnwindQuantizationError)MUL(UnwindQuantizationError,16,QuantizationLimit);]]>
</Text>
</Rung>
<Rung Number="90" Type="N">
<Text>
<![CDATA[XIO(P.RotaryAxis)ABS(P.Position,AbsProducedPosition)GRT(AbsProducedPosition,MaxProducedPosition)MOV(AbsProducedPosition,MaxProducedPosition)LOG(MaxProducedPosition,LogMaxProducedPosition)DIV(LogMaxProducedPosition,lg2,Lg2Unwind)SUB(Lg2Unwind,23,LG2Quant)XPY(2,LG2Quant,UnwindQuantizationError)MUL(UnwindQuantizationError,16,QuantizationLimit);]]>
</Text>
</Rung>
<Rung Number="91" Type="N">
<Text>
<![CDATA[XIC(Val_FirstScan)[XIC(P.RotaryAxis) MOV(2,MAM_MoveType) ,XIO(P.RotaryAxis) MOV(0,MAM_MoveType) ];]]>
</Text>
</Rung>
<Rung Number="92" Type="N">
<Comment>
<![CDATA[detect system offset jitter in both systems]]>
</Comment>
<Text>
<![CDATA[XIO(P.DisableAdvancedFeatures)SUB(SystemTimeAndOffset[2],ConsSysTimeOld,ConsSystimeDif)SUB(P.SystemTimeAndOffset[2],ProdSysTimeOld,ProdSystimeDif);]]>
</Text>
</Rung>
<Rung Number="93" Type="N">
<Text>
<![CDATA[XIO(P.DisableAdvancedFeatures)MOV(SystemTimeAndOffset[2],ConsSysTimeOld)MOV(P.SystemTimeAndOffset[2],ProdSysTimeOld);]]>
</Text>
</Rung>
<Rung Number="94" Type="N">
<Text>
<![CDATA[XIO(P.DisableAdvancedFeatures)SUB(ConsSystimeDif,ProdSystimeDif,Val_MySystimeDif);]]>
</Text>
</Rung>
<Rung Number="95" Type="N">
<Text>
<![CDATA[[XIC(Val_FirstScan) ,XIC(P.DisableAdvancedFeatures) ]CLR(TimeDifIntegrator)CLR(AccSystimeDif)CLR(Val_MySystimeDif);]]>
</Text>
</Rung>
<Rung Number="96" Type="N">
<Text>
<![CDATA[XIO(P.DisableAdvancedFeatures)ADD(AccSystimeDif,Val_MySystimeDif,AccSystimeDif)DIV(AccSystimeDif,1000000,AccSystimeDif_sec);]]>
</Text>
</Rung>
<Rung Number="97" Type="N">
<Text>
<![CDATA[XIO(P.DisableAdvancedFeatures)GRT(AccSystimeDif_sec,0)[LES(TimeDifIntegrator,AccSystimeDif_sec) ADD(TimeDifIntegrator,0.0000001,TimeDifIntegrator) ,GEQ(TimeDifIntegrator,AccSystimeDif_sec) CLR(AccSystimeDif) CLR(TimeDifIntegrator) ];]]>
</Text>
</Rung>
<Rung Number="98" Type="N">
<Text>
<![CDATA[XIO(P.DisableAdvancedFeatures)LES(AccSystimeDif_sec,0)[GRT(TimeDifIntegrator,AccSystimeDif_sec) SUB(TimeDifIntegrator,0.0000001,TimeDifIntegrator) ,LEQ(TimeDifIntegrator,AccSystimeDif_sec) CLR(AccSystimeDif) CLR(TimeDifIntegrator) ];]]>
</Text>
</Rung>
<Rung Number="99" Type="N">
<Text>
<![CDATA[XIO(P.DisableAdvancedFeatures)EQU(AccSystimeDif_sec,0)[GRT(TimeDifIntegrator,0) SUB(TimeDifIntegrator,0.0000001,TimeDifIntegrator) ,LES(TimeDifIntegrator,0) ADD(TimeDifIntegrator,0.0000001,TimeDifIntegrator) ];]]>
</Text>
</Rung>
<Rung Number="100" Type="N">
<Comment>
<![CDATA[predict delta position since produced data calculation time]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="101" Type="N">
<Text>
<![CDATA[DIV(P.CU_P_us,1000000,CU_P_sec);]]>
</Text>
</Rung>
<Rung Number="102" Type="N">
<Text>
<![CDATA[XIC(P.UseActual)ADD(CU_Local_us_Mul2,P.Producer_ActualDelay_us,MasterDelayCompensation);]]>
</Text>
</Rung>
<Rung Number="103" Type="N">
<Text>
<![CDATA[XIO(P.UseActual)SUB(CU_Local_us_Mul2,P.Producer_CommandDelay_us,MasterDelayCompensation);]]>
</Text>
</Rung>
<Rung Number="104" Type="N">
<Text>
<![CDATA[ADD(DifTime_ProducerConsumer,CU_Local_us,TargetTime_us)ADD(TargetTime_us,MasterDelayCompensation,TargetTime1_us)ADD(TargetTime1_us,MyAdditionalDelaycompensation,TargetTime2_us)SUB(TargetTime2_us,AccSystimeDif,TargetTime3_us)DIV(TargetTime3_us,1000000,TargetTime4_sec)ADD(TargetTime4_sec,TimeDifIntegrator,Val_TotalDelayFromProducer_Sec);]]>
</Text>
</Rung>
<Rung Number="105" Type="N">
<Text>
<![CDATA[XIC(Inp_DisableAllDelayCompensations)CLR(Val_TotalDelayFromProducer_Sec);]]>
</Text>
</Rung>
<Rung Number="106" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(Val_TotalDelayFromProducer_Sec,C.Val_TotalDelayFromProducer_Sec)MOV(TargetTime_us,C.TargetTime_us)MOV(AccSystimeDif,C.AccSystimeDif)MOV(TimeDifIntegrator,C.TimeDifIntegrator);]]>
</Text>
</Rung>
<Rung Number="107" Type="N">
<Comment>
<![CDATA[1st order extrapolation]]>
</Comment>
<Text>
<![CDATA[[EQU(P.ExtrapolationType,1) ,EQU(P.ExtrapolationType,0) XIC(P.UseActual) ]CPT(Val_ExtrapolationDistance,P.Velocity  * Val_TotalDelayFromProducer_Sec);]]>
</Text>
</Rung>
<Rung Number="108" Type="N">
<Comment>
<![CDATA[2nd order extrapolation
This is a special equation because the motion planners P.Velocity is calculated from 1st order polynomial and P.acceleration from 2nd order polynomial
Used Velocity has to be adjusted by "0.5 * p.Acceleration * CU_P_sec" to match 2nd order polynomial]]>
</Comment>
<Text>
<![CDATA[[EQU(P.ExtrapolationType,2) ,EQU(P.ExtrapolationType,0) XIO(P.UseActual) ]CPT(Val_ExtrapolationDistance,(P.Velocity + 0.5 * P.Acceleration * CU_P_sec + 0.5 * P.Acceleration * Val_TotalDelayFromProducer_Sec) * Val_TotalDelayFromProducer_Sec);]]>
</Text>
</Rung>
<Rung Number="109" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(Val_ExtrapolationDistance,C.Val_ExtrapolationDistance);]]>
</Text>
</Rung>
<Rung Number="110" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)[XIC(Val_FirstScan) OTL(C.Val_FirstScan) ,XIO(Val_FirstScan) OTU(C.Val_FirstScan) ];]]>
</Text>
</Rung>
<Rung Number="111" Type="N">
<Comment>
<![CDATA[---------------------------------------------------------------------------------------------------------------------
Restart in first scan
---------------------------------------------------------------------------------------------------------------------

]]>
</Comment>
<Text>
<![CDATA[XIC(Val_FirstScan)CLR(Val_DeltaP)MOV(P.Counter,OldCounter)MOV(P.Position,OldProducerPosition)CLR(NoOfCourseUpdates_on_P_CPU)CLR(Old_ExtrapolationDistance)MRP(Out_Axis_Consumed,MI_MRP_1stScan,Absolute,Command,P.Position)CLR(average_difference)CLR(average_count)RES(TON_Compensation)JMP(NoVelSum);]]>
</Text>
</Rung>
<Rung Number="112" Type="N">
<Comment>
<![CDATA[---------------------------------------------------------------------------------------------------------------------
Algorithm to move axis with P.DisableAdvancedFeatures=1 (simplified Algorithm)
---------------------------------------------------------------------------------------------------------------------

]]>
</Comment>
<Text>
<![CDATA[XIC(P.DisableAdvancedFeatures)[ADD(P.Position,Val_ExtrapolationDistance,Val_MAMAbsolutePosition) ,XIC(P.RotaryAxis) [MOD(Val_MAMAbsolutePosition,MyUnwindPosition,Val_MAMAbsolutePosition) ,LES(Val_MAMAbsolutePosition,0) ADD(Val_MAMAbsolutePosition,MyUnwindPosition,Val_MAMAbsolutePosition) ] ];]]>
</Text>
</Rung>
<Rung Number="113" Type="N">
<Text>
<![CDATA[XIC(P.DisableAdvancedFeatures)OTU(MI_MAM_AxisConsumedAbs.EN)MAM(Out_Axis_Consumed,MI_MAM_AxisConsumedAbs,MAM_MoveType,Val_MAMAbsolutePosition,1000000000,Units per sec,2000000000,Units per sec2,2000000000,Units per sec2,Trapezoidal,0,0,% of Time,Disabled,Programmed,0,None,0,0)JMP(EndOfExtrapolation);]]>
</Text>
</Rung>
<Rung Number="114" Type="N">
<Comment>
<![CDATA[---------------------------------------------------------------------------------------------------------------------
Algorithm to move axis with P.DisableAdvancedFeatures=0 (advanced Algorithm)
---------------------------------------------------------------------------------------------------------------------

]]>
</Comment>
<Text>
<![CDATA[SUB(P.Counter,OldCounter,NoOfCourseUpdates_on_P_CPU)LES(NoOfCourseUpdates_on_P_CPU,0)ADD(NoOfCourseUpdates_on_P_CPU,1000,NoOfCourseUpdates_on_P_CPU);]]>
</Text>
</Rung>
<Rung Number="115" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(NoOfCourseUpdates_on_P_CPU,C.NoOfCourseUpdates_on_P_CPU);]]>
</Text>
</Rung>
<Rung Number="116" Type="N">
<Comment>
<![CDATA[Sum up velocities to get to position delta since last update from producer]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="117" Type="N">
<Text>
<![CDATA[GRT(NoOfCourseUpdates_on_P_CPU,20)MOV(20,NoOfCourseUpdates_on_P_CPU);]]>
</Text>
</Rung>
<Rung Number="118" Type="N">
<Text>
<![CDATA[MOV(NoOfCourseUpdates_on_P_CPU,Velocity_Cnt)MOV(P.VelocityPnt,VelocityPnt)CLR(Velocity_Sum);]]>
</Text>
</Rung>
<Rung Number="119" Type="N">
<Text>
<![CDATA[EQU(Velocity_Cnt,1)MOV(P.VelocityBuffer[VelocityPnt],Velocity_Sum)JMP(End_new_velocities);]]>
</Text>
</Rung>
<Rung Number="120" Type="N">
<Text>
<![CDATA[EQU(Velocity_Cnt,0)JMP(End_new_velocities);]]>
</Text>
</Rung>
<Rung Number="121" Type="N">
<Text>
<![CDATA[LBL(SumLoop)ADD(Velocity_Sum,P.VelocityBuffer[VelocityPnt],Velocity_Sum);]]>
</Text>
</Rung>
<Rung Number="122" Type="N">
<Text>
<![CDATA[SUB(VelocityPnt,1,VelocityPnt)LES(VelocityPnt,0)MOV(19,VelocityPnt);]]>
</Text>
</Rung>
<Rung Number="123" Type="N">
<Text>
<![CDATA[SUB(Velocity_Cnt,1,Velocity_Cnt)GRT(Velocity_Cnt,0)JMP(SumLoop);]]>
</Text>
</Rung>
<Rung Number="124" Type="N">
<Text>
<![CDATA[LBL(End_new_velocities)NOP();]]>
</Text>
</Rung>
<Rung Number="125" Type="N">
<Text>
<![CDATA[MUL(Velocity_Sum,CU_P_sec,Val_DeltaP);]]>
</Text>
</Rung>
<Rung Number="126" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(Velocity_Sum,C.Velocity_Sum)MOV(Val_DeltaP,C.Val_DeltaP);]]>
</Text>
</Rung>
<Rung Number="127" Type="N">
<Text>
<![CDATA[LBL(NoVelSum)NOP();]]>
</Text>
</Rung>
<Rung Number="128" Type="N">
<Comment>
<![CDATA[Add extrapolation distance to incremental move of producer]]>
</Comment>
<Text>
<![CDATA[ADD(Val_DeltaP,Val_ExtrapolationDistance,Incr_Move1)SUB(Incr_Move1,Old_ExtrapolationDistance,Val_Incr_Move);]]>
</Text>
</Rung>
<Rung Number="129" Type="N">
<Comment>
<![CDATA[Acceleration Limit]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="130" Type="N">
<Text>
<![CDATA[SUB(Val_DeltaP,Old_Val_DeltaP,Accel_PosUnits_Producer)MOV(Val_DeltaP,Old_Val_DeltaP);]]>
</Text>
</Rung>
<Rung Number="131" Type="N">
<Text>
<![CDATA[XIC(Inp_DynamicsLimit)ABS(Accel_PosUnits_Producer,Abs_ProducerAccel)GRT(Abs_ProducerAccel,Accel_Limit1)OTE(NewDynamicsLimit);]]>
</Text>
</Rung>
<Rung Number="132" Type="N">
<Text>
<![CDATA[XIC(NewDynamicsLimit)MOV(Abs_ProducerAccel,Accel_Limit1)MUL(Accel_Limit1,2,Accel_Limit_PosUnits)NEG(Accel_Limit_PosUnits,NEG_Accel_LimitPosUnits)NEQ(Val_CoarseUpdate_Sec,0)DIV(Accel_Limit_PosUnits,Val_CoarseUpdate_Sec,Acc1)DIV(Acc1,Val_CoarseUpdate_Sec,Val_AccelLimit_UnitsSecSqu);]]>
</Text>
</Rung>
<Rung Number="133" Type="N">
<Text>
<![CDATA[SUB(Val_Incr_Move,Old_Val_Incr_Move,Accel_PosUnits);]]>
</Text>
</Rung>
<Rung Number="134" Type="N">
<Text>
<![CDATA[XIC(Inp_DynamicsLimit)LES(Accel_PosUnits,0)SUB(NEG_Accel_LimitPosUnits,Accel_PosUnits,Accel_Delta)GRT(Accel_Delta,0)ADD(Val_Incr_Move,Accel_Delta,Val_Incr_Move)ADD(Val_ExtrapolationDistance,Accel_Delta,Val_ExtrapolationDistance);]]>
</Text>
</Rung>
<Rung Number="135" Type="N">
<Text>
<![CDATA[XIC(Inp_DynamicsLimit)GRT(Accel_PosUnits,0)SUB(Accel_Limit_PosUnits,Accel_PosUnits,Accel_Delta)LES(Accel_Delta,0)ADD(Val_Incr_Move,Accel_Delta,Val_Incr_Move)ADD(Val_ExtrapolationDistance,Accel_Delta,Val_ExtrapolationDistance);]]>
</Text>
</Rung>
<Rung Number="136" Type="N">
<Text>
<![CDATA[MOV(Val_Incr_Move,Old_Val_Incr_Move);]]>
</Text>
</Rung>
<Rung Number="137" Type="N">
<Comment>
<![CDATA[Limit extrapolation for No_NegativeMovement and No_PositiveMovement configuration]]>
</Comment>
<Text>
<![CDATA[[XIC(Inp_NoNegativeMovement) GEQ(Val_DeltaP,0) LES(Val_Incr_Move,0) ,XIC(Inp_NoPositiveMovement) LEQ(Val_DeltaP,0) GRT(Val_Incr_Move,0) ]CLR(Val_Incr_Move)SUB(Old_ExtrapolationDistance,Val_DeltaP,Val_ExtrapolationDistance);]]>
</Text>
</Rung>
<Rung Number="138" Type="N">
<Text>
<![CDATA[XIC(Inp_NoNegativeMovement)LES(Val_DeltaP,0)OTL(Val_ProducerMovedNegative);]]>
</Text>
</Rung>
<Rung Number="139" Type="N">
<Text>
<![CDATA[XIC(Inp_NoPositiveMovement)GRT(Val_DeltaP,0)OTL(Val_ProducerMovedPositive);]]>
</Text>
</Rung>
<Rung Number="140" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(Incr_Move1,C.Incr_Move1)MOV(Val_Incr_Move,C.Val_Incr_Move_S1)MOV(Old_ExtrapolationDistance,C.Old_ExtrapolationDistance);]]>
</Text>
</Rung>
<Rung Number="141" Type="N">
<Text>
<![CDATA[MOV(Val_ExtrapolationDistance,Old_ExtrapolationDistance);]]>
</Text>
</Rung>
<Rung Number="142" Type="N">
<Comment>
<![CDATA[in first scan: dont determine MRP or go through quantization compensation]]>
</Comment>
<Text>
<![CDATA[XIC(Val_FirstScan)JMP(MAM_Start);]]>
</Text>
</Rung>
<Rung Number="143" Type="N">
<Comment>
<![CDATA[Determine MRP situation]]>
</Comment>
<Text>
<![CDATA[OTU(trigger_MRP)OTU(Val_MRP_Detected)NOP();]]>
</Text>
</Rung>
<Rung Number="144" Type="N">
<Text>
<![CDATA[ADD(OldProducerPosition,Val_DeltaP,Absolute_Position)MOV(P.Position,OldProducerPosition);]]>
</Text>
</Rung>
<Rung Number="145" Type="N">
<Text>
<![CDATA[XIC(P.RotaryAxis)[MOD(Absolute_Position,MyUnwindPosition,Absolute_Position) ,LES(Absolute_Position,0) ADD(Absolute_Position,MyUnwindPosition,Absolute_Position) ];]]>
</Text>
</Rung>
<Rung Number="146" Type="N">
<Text>
<![CDATA[SUB(P.Position,Absolute_Position,Val_PosDifferenceMRPCheck);]]>
</Text>
</Rung>
<Rung Number="147" Type="N">
<Text>
<![CDATA[XIC(P.RotaryAxis)[GRT(Val_PosDifferenceMRPCheck,UnwindDifLimit) SUB(Val_PosDifferenceMRPCheck,MyUnwindPosition,Val_PosDifferenceMRPCheck) ,LES(Val_PosDifferenceMRPCheck,UnwindDifLimitNeg) ADD(Val_PosDifferenceMRPCheck,MyUnwindPosition,Val_PosDifferenceMRPCheck) ];]]>
</Text>
</Rung>
<Rung Number="148" Type="N">
<Comment>
<![CDATA[MRP Detection

Check if PosDifference is larger than 8 x Quantization error of Absolute_Position (32bit float)

Threshold is 2^-20 which is 8x 2^-23 which is the least signifficant bit of the mantissa

If yes assume that this is an MRP/Home or change in unwind on produced axis]]>
</Comment>
<Text>
<![CDATA[NEQ(MaxProducedPosition,0)NEQ(Val_PosDifferenceMRPCheck,0)MOV(MaxProducedPosition,Val_MaxProducedPosition)MOV(Val_PosDifferenceMRPCheck,Val_CapPosDifMRPCheck)DIV(Val_PosDifferenceMRPCheck,MaxProducedPosition,CheckQuantizationError)ABS(CheckQuantizationError,CheckQuantizationError)GRT(CheckQuantizationError,0.00000095367431640625)OTL(trigger_MRP);]]>
</Text>
</Rung>
<Rung Number="149" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)[MOV(Val_PosDifferenceMRPCheck,C.Val_PosDifferenceMRPCheck) MOV(CheckQuantizationError,C.CheckQuantizationError) MOV(Val_MaxProducedPosition,C.Val_MaxProducedPosition) ,XIC(trigger_MRP) OTL(C.trigger_MRP) ,XIO(trigger_MRP) OTU(C.trigger_MRP) ];]]>
</Text>
</Rung>
<Rung Number="150" Type="N">
<Comment>
<![CDATA[MRP/HOME/Change in conversion constant or unwind position]]>
</Comment>
<Text>
<![CDATA[XIC(trigger_MRP)CLR(average_difference)CLR(average_count)RES(TON_Compensation)CLR(PosDifferenceQuantizationSum);]]>
</Text>
</Rung>
<Rung Number="151" Type="N">
<Text>
<![CDATA[XIC(trigger_MRP)[XIO(P.RotaryAxis) MRP(Out_Axis_Consumed,MI_MRP_Linear,Relative,Command,Val_PosDifferenceMRPCheck) ,XIC(P.RotaryAxis) [ADD(Out_Axis_Consumed.CommandPosition,Val_PosDifferenceMRPCheck,MRP_Absolute) MOD(MRP_Absolute,MyUnwindPosition,MRP_Absolute) ,LES(MRP_Absolute,0) ADD(MRP_Absolute,MyUnwindPosition,MRP_Absolute) ,MRP(Out_Axis_Consumed,MI_MRP_Rotary,Absolute,Command,MRP_Absolute) ] ];]]>
</Text>
</Rung>
<Rung Number="152" Type="N">
<Text>
<![CDATA[XIC(trigger_MRP)OTL(Val_MRP_Detected)OTL(One_MRP)JMP(MAM_Start);]]>
</Text>
</Rung>
<Rung Number="153" Type="N">
<Comment>
<![CDATA[adjust rounding errors that result from adding up velocity values continously]]>
</Comment>
<Text>
<![CDATA[[ADD(Out_Axis_Consumed.CommandPosition,Val_Incr_Move,My_AbsolutePosition) ,XIC(RG_Debug) MOV(My_AbsolutePosition,C.My_AbsolutePosition_Step1) ]XIC(P.RotaryAxis)[MOD(My_AbsolutePosition,MyUnwindPosition,My_AbsolutePosition) ,LES(My_AbsolutePosition,0) ADD(My_AbsolutePosition,MyUnwindPosition,My_AbsolutePosition) ];]]>
</Text>
</Rung>
<Rung Number="154" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(My_AbsolutePosition,C.My_AbsolutePosition_Step2);]]>
</Text>
</Rung>
<Rung Number="155" Type="N">
<Text>
<![CDATA[[ADD(P.Position,Val_ExtrapolationDistance,P_AbsolutePosition) ,XIC(RG_Debug) MOV(P_AbsolutePosition,C.P_AbsolutePosition_Step1) ]XIC(P.RotaryAxis)[MOD(P_AbsolutePosition,MyUnwindPosition,P_AbsolutePosition) ,LES(P_AbsolutePosition,0) ADD(P_AbsolutePosition,MyUnwindPosition,P_AbsolutePosition) ];]]>
</Text>
</Rung>
<Rung Number="156" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(P_AbsolutePosition,C.P_AbsolutePosition_Step2);]]>
</Text>
</Rung>
<Rung Number="157" Type="N">
<Text>
<![CDATA[SUB(P_AbsolutePosition,My_AbsolutePosition,PosDifferenceQuantizationSum);]]>
</Text>
</Rung>
<Rung Number="158" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(PosDifferenceQuantizationSum,C.PosDifferenceQuantizationSum_Step1);]]>
</Text>
</Rung>
<Rung Number="159" Type="N">
<Text>
<![CDATA[XIC(P.RotaryAxis)[GRT(PosDifferenceQuantizationSum,UnwindDifLimit) SUB(PosDifferenceQuantizationSum,MyUnwindPosition,PosDifferenceQuantizationSum) ,LES(PosDifferenceQuantizationSum,UnwindDifLimitNeg) ADD(PosDifferenceQuantizationSum,MyUnwindPosition,PosDifferenceQuantizationSum) ];]]>
</Text>
</Rung>
<Rung Number="160" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(PosDifferenceQuantizationSum,C.PosDifferenceQuantizationSum_Step2);]]>
</Text>
</Rung>
<Rung Number="161" Type="N">
<Text>
<![CDATA[ADD(average_difference,PosDifferenceQuantizationSum,average_difference)ADD(average_count,1,average_count);]]>
</Text>
</Rung>
<Rung Number="162" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(average_difference,C.average_difference)MOV(average_count,C.average_count);]]>
</Text>
</Rung>
<Rung Number="163" Type="N">
<Text>
<![CDATA[TON(TON_Compensation,?,?);]]>
</Text>
</Rung>
<Rung Number="164" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(TON_Compensation.ACC,C.TON_Compensation_acc);]]>
</Text>
</Rung>
<Rung Number="165" Type="N">
<Text>
<![CDATA[ABS(PosDifferenceQuantizationSum,AbsPosDifferenceQuantizationSum)GEQ(AbsPosDifferenceQuantizationSum,QuantizationLimit)OTL(QuantizationCorrection);]]>
</Text>
</Rung>
<Rung Number="166" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)[MOV(QuantizationLimit,C.QuantizationLimit) ,XIC(QuantizationCorrection) OTL(C.QuantizationCorrection) ,XIO(QuantizationCorrection) OTU(C.QuantizationCorrection) ];]]>
</Text>
</Rung>
<Rung Number="167" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)OTU(C.DoCorrection);]]>
</Text>
</Rung>
<Rung Number="168" Type="N">
<Text>
<![CDATA[[XIC(QuantizationCorrection) ,XIC(TON_Compensation.DN) ]RES(TON_Compensation)OTU(QuantizationCorrection)[DIV(average_difference,average_count,CompensationValue) CLR(average_difference) CLR(average_count) ADD(Val_Incr_Move,CompensationValue,Val_Incr_Move) ,XIC(RG_Debug) [OTL(C.DoCorrection) ,MOV(CompensationValue,C.CompensationValue) MOV(Val_Incr_Move,C.Val_Incr_Move_Step2) ] ];]]>
</Text>
</Rung>
<Rung Number="169" Type="N">
<Text>
<![CDATA[LBL(MAM_Start)NOP();]]>
</Text>
</Rung>
<Rung Number="170" Type="N">
<Text>
<![CDATA[NEQ(Val_CoarseUpdate_Sec,0)DIV(Val_Incr_Move,Val_CoarseUpdate_Sec,Incr_Velocity);]]>
</Text>
</Rung>
<Rung Number="171" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(Val_CoarseUpdate_Sec,C.Val_CoarseUpdate_Sec)MOV(Incr_Velocity,C.Incr_Velocity);]]>
</Text>
</Rung>
<Rung Number="172" Type="N">
<Comment>
<![CDATA[Use MAJ to move consumed axis by Incr_Move distance in the next coarse udpate]]>
</Comment>
<Text>
<![CDATA[OTU(MI_MAJ_AxisConsumed.EN)MAJ(Out_Axis_Consumed,MI_MAJ_AxisConsumed,0,Incr_Velocity,Units per sec,2000000000,Units per sec2,2000000000,Units per sec2,Trapezoidal,0,0,% of Time,Disabled,Programmed,0,None);]]>
</Text>
</Rung>
<Rung Number="173" Type="N">
<Text>
<![CDATA[LBL(EndOfExtrapolation)NOP();]]>
</Text>
</Rung>
<Rung Number="174" Type="N">
<Text>
<![CDATA[MOV(P.Counter,OldCounter);]]>
</Text>
</Rung>
<Rung Number="175" Type="N">
<Text>
<![CDATA[[XIC(MI_MAJ_AxisConsumed.IP) ,XIC(MI_MAM_AxisConsumedAbs.IP) ,XIC(MI_MAJ_to_0.IP) NEQ(Out_Axis_Consumed.CommandVelocity,0) ]OTE(Sts_IP);]]>
</Text>
</Rung>
<Rung Number="176" Type="N">
<Text>
<![CDATA[XIO(RG_Debug)[XIO(Inp_CalcPositionDeviationFromProducer) ,XIC(Val_FirstScan) ,LES(MyState,20) ]TND();]]>
</Text>
</Rung>
<Rung Number="177" Type="N">
<Comment>
<![CDATA[Calculate position deviation from producer]]>
</Comment>
<Text>
<![CDATA[GRT(Val_TotalDelayFromProducer_Sec,0)SUB(CSTTime_Producer,MyAdditionalDelaycompensation,InterpolationTime)SUB(InterpolationTime,MasterDelayCompensation,InterpolationTime)SSV(Axis,Out_Axis_Consumed,InterpolationTime,InterpolationTime)GSV(Axis,Out_Axis_Consumed,InterpolatedCommandPosition,ConsumerPosition)SUB(ConsumerPosition,P.Position,PositionDeviationFromProducer);]]>
</Text>
</Rung>
<Rung Number="178" Type="N">
<Comment>
<![CDATA[if we are deleaying data from the producer instaed of compensating delays -> no deviation calculation]]>
</Comment>
<Text>
<![CDATA[LEQ(Val_TotalDelayFromProducer_Sec,0)CLR(PositionDeviationFromProducer);]]>
</Text>
</Rung>
<Rung Number="179" Type="N">
<Text>
<![CDATA[XIC(P.RotaryAxis)[GRT(PositionDeviationFromProducer,UnwindDifLimit) SUB(PositionDeviationFromProducer,MyUnwindPosition,PositionDeviationFromProducer) ,LES(PositionDeviationFromProducer,UnwindDifLimitNeg) ADD(PositionDeviationFromProducer,MyUnwindPosition,PositionDeviationFromProducer) ];]]>
</Text>
</Rung>
<Rung Number="180" Type="N">
<Text>
<![CDATA[MOV(PositionDeviationFromProducer,Val_PositionDeviationFromProducer);]]>
</Text>
</Rung>
<Rung Number="181" Type="N">
<Text>
<![CDATA[XIC(RG_Debug)MOV(Val_PositionDeviationFromProducer,C.Val_PositionDeviationFromProducer);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Prescan" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTL(PrepareRestart)OTU(Sts_ER)CLR(Err_No);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[OTU(RG_Debug)OTU(RG_DoubleCheck_CSTAccuarcy);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
