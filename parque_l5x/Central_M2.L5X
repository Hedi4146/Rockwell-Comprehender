<Routine Name="R000_Carro" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[*******************************************************
Rung control enable servo
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[Servo_Manager(ServoManager_M23,M23,Axis.GroupSynced,Stacker_CMD.FaultReset,M23_CMD.Enable,M23_Status.Enable_On,M23_Status.Homed) ,XIC(M23_Status.Enable_On) XIC(M23_Status.Homed) OTE(M23_Status.Ready) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(M23_Status.Homed) MOV(1,Soft_Overtravel_Fault_Action_2) ,XIO(M23_Status.Homed) MOV(3,Soft_Overtravel_Fault_Action_2) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[GSV(Axis,M23,TorqueFeedback,M23_Status.Torque)SSV(Axis,M23,SoftOvertravelFaultAction,Soft_Overtravel_Fault_Action_2);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[
*******************************************************
 Homing Sequence
*******************************************************]]>
</Comment>
<Text>
<![CDATA[XIC(Stacker_CMD.Homing)ONS(BIT[3].0)OTL(M23_CMD.Homing);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(M23_Status.Enable_On)XIC(M23_CMD.Homing)[[XIO(Stacker_InPut.Homing_Servo_Car) XIO(M23_MAJ.IP) MAJ(M23,M23_MAJ,M23_MAJ_Direction,Speed_Jog_M23,Units per sec,10,% of Maximum,10,% of Maximum,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None) ,XIC(Stacker_InPut.Homing_Servo_Car) XIO(M23_MAS.IP) MAS(M23,M23_MAS,Jog,Yes,1000,Units per sec2,No,1000,Units per sec3) XIC(M23_MAS.PC) OTL(CMD_Home_M23) ] ,XIC(CMD_Home_M23) XIC(Stacker_InPut.Homing_Servo_Car) XIO(M23_MAH.IP) MAH(M23,M23_MAH) XIC(M23_MAH.PC) OTL(M23_CMD.Home_To_Pos_01) OTU(M23_CMD.Homing) OTU(CMD_Home_M23) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[
*******************************************************
Control Position 1
*******************************************************]]>
</Comment>
<Text>
<![CDATA[XIC(M23_Status.Ready)[[XIC(M23_CMD.Home_To_Pos_01) ,XIC(M21_POS_01_Motion_Completed) ] XIC(Move_Side_Dr) ,XIC(Pos_02_M23.Ok) XIC(M22_POS_02_Motion_Completed) [XIC(Move_Side_Op_Dr) ,XIC(Move_Side_Op) ] ]XIO(M23_CMD.Homing)XIO(Reset_Time.TT)[XIC(Pos_01_M20.Ok) XIC(Pos_01_M21.Ok) ,XIC(Reset_Time.TT) ]ONS(BIT[3].1)OTL(M23_CMD.Pos_01)OTU(M23_CMD.Home_To_Pos_01);]]>
</Text>
</Rung>
