<Text>
<![CDATA[[XIC(ResetAxAlarm) ,XIC(PhysicalAx.InhibitStatus) ][XIC(Data.Motion.Stop.ER) CLR(Data.Motion.Stop.FLAGS) ,XIC(Data.Motion.Gear.ER) CLR(Data.Motion.Gear.FLAGS) ,XIC(Data.Motion.ManualPhMamFw.ER) CLR(Data.Motion.ManualPhMamFw.FLAGS) ,XIC(Data.Motion.ManualPhMamBk.ER) CLR(Data.Motion.ManualPhMamBk.FLAGS) ,CLR(IstFaultCode) ,CLR(DriveFaultCode) ];]]>
