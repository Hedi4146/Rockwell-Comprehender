<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(AxEnabled) XIC(AxStart) XIO(PhysicalAx.GearingStatus) NEQ(Data.Motion.HmiGearAccelRate,0) GEQ(VMaster.ActualVelocity,0) [CPT(Data.Motion.GearRatio,1/Data.Input.AxPar.HmiRollDiameter) CPT(LocGearAccelRate,Data.Motion.HmiGearAccelRate) ,XIC(MAG_Gear_On) MAG(PhysicalAx,VMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,Data.Motion.GearRatio,Data.Motion.GearSlaveCounts,360,Command,Real,Enabled,LocGearAccelRate,Units per sec2) ] ,[XIO(AxEnabled) ,XIO(AxStart) ] ONS(Aux9) [MOV(PhysicalAx.ActualPosition,Data.Motion.MemPhisicalAxActualposition) ,OTU(Data.Motion.GearAbsoluteAxPhased) ] ,XIC(AxEnabled) XIO(Data.Motion.GearAbsoluteAxPhasing) [XIC(Data.Motion.PhaseForwardCommand) XIO(Data.Motion.ManualPhMamFw.IP) ONS(Aux7) [CPT(LocStepManPhase,Data.Motion.HmiManualPhaserStep/1) ,MAM(PhysicalAx,Data.Motion.ManualPhMamFw,1,LocStepManPhase,Data.Motion.HmiManualPhaserVelocity,Units per sec,50,Units per sec2,50,Units per sec2,Trapezoidal,100,100,% of Maximum,Disabled,0,0,None,0,0) ,LES(Data.Motion.ManualPhaseOffset,Data.Input.AxPar.ModuleAx) ADD(Data.Motion.ManualPhaseOffset,Data.Motion.HmiManualPhaserStep,Data.Motion.ManualPhaseOffset) ,GEQ(Data.Motion.ManualPhaseOffset,Data.Input.AxPar.ModuleAx) MOV(0,Data.Motion.ManualPhaseOffset) ] ,XIC(Data.Motion.PhaseBackwardCommand) XIO(Data.Motion.ManualPhMamBk.IP) ONS(Aux8) [CPT(LocStepManPhase,Data.Motion.HmiManualPhaserStep/-1) ,MAM(PhysicalAx,Data.Motion.ManualPhMamBk,1,LocStepManPhase,Data.Motion.HmiManualPhaserVelocity,Units per sec,50,Units per sec2,50,Units per sec2,Trapezoidal,100,100,% of Maximum,Disabled,0,0,None,0,0) ,GRT(Data.Motion.ManualPhaseOffset,0) SUB(Data.Motion.ManualPhaseOffset,Data.Motion.HmiManualPhaserStep,Data.Motion.ManualPhaseOffset) ,LEQ(Data.Motion.ManualPhaseOffset,0) MOV(Data.Input.AxPar.ModuleAx,Data.Motion.ManualPhaseOffset) ] ] ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[Servo_Manager_1(Data.Motion.ServoManager,PhysicalAx,GroupSincro,ResetAxAlarm,AxEnable,AxEnabled);]]>
