<Routine Name="R006_General" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
EMERGENCY ON
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[XIC(INPUT_Emergency_Restored)OTE(PowerOK);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
Machine STILL - Machine MOVING
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[[XIO(HmiEnableSimulation) ABS(Master.AverageVelocity,ABS_Master_Velocity) LES(ABS_Master_Velocity,2) ,XIC(HmiEnableSimulation) LES(Vmaster1.AverageVelocity,1) ] [TON(AuxTON[0],?,?) ,XIC(AuxTON[0].DN) OTE(MachineStill) ] ,XIO(MachineStill) OTE(MachineMoving) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
START MOTORS SIGNALS
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[XIC(PowerOK)[[XIO(HmiEnableSimulation) XIC(INPUT_MachineStartMotors) ,XIC(HmiEnableSimulation) XIC(HmiStartMotor) ] [TON(AuxTON[4],?,?) ,XIC(AuxTON[4].DN) OTE(StartMotorsSignal) OTE(StartMotors) ] ,XIC(StartMotors) OTE(MotorRunning) TON(AuxTON[6],?,?) ,XIC(AuxTON[6].DN) OTE(MotorRunning_Delayed) OTE(HMI_MotorRunning) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(PowerOK) ,XIO(HmiEnableSimulation) ]OTU(HmiStartMotor);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
START MACHINE
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[XIC(PowerOK)XIO(AlarmPresence)XIC(MotorRunning_Delayed)[XIC(HmiEnableSimulation) XIC(HmiStartSimulation) ,XIO(HmiEnableSimulation) ]OTL(Start_Machine);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(OFF) XIC(HmiEnableSimulation) XIO(HmiStartSimulation) ,XIO(HmiEnableSimulation) XIO(StartMotorsSignal) ]OTE(StopReqest);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(OFF) XIC(StopReqest) XIC(MachineStill) ,XIC(OFF) XIC(AlarmPresence) ,XIO(PowerOK) ,XIO(MotorRunning_Delayed) ]OTU(Start_Machine);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIO(HmiEnableSimulation) ,XIO(PowerOK) ]OTU(HmiStartSimulation);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
START VIRTUAL MASTER
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[XIC(Start_Machine)[XIO(StopReqest) ,XIO(HmiEnableSimulation) XIC(Start_Machine) ]TON(Timer_Start_Master,?,?);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Timer_Start_Master.DN)OTE(StartVmaster);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
ENABLE AXIS
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[XIC(PowerOK)XIC(Start_Machine)OTE(Enable_Virtual_Axis);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[MOV(HmiSizeSelector,DATOS.HmiSizeSelector)MOV(HmiProductLength,DATOS.HmiProductLength)MOV(HmiStatusMachine,DATOS.HmiStatusMachine);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(msg_off)[[GRT(Timer_Msg.ACC,700) ,XIC(ResetAlarm) ,XIC(Timer_Msg_1.DN) ] XIO(MSG_To_Sp.EN) MSG(MSG_To_Sp) ,XIC(ResetAlarm) XIC(MSG_To_Sp.ER) CLR(MSG_To_Sp.Flags) ,XIC(MSG_To_Sp.DN) TON(Timer_Msg,?,?) ,XIO(MSG_To_Sp.DN) TON(Timer_Msg_1,?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
