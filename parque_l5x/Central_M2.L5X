<Rung Number="5" Type="N">
<Text>
<![CDATA[MOV(sm1_date.servo_sync.ERR,Error[0])MOV(sm2_date.servo_sync.ERR,Error[1])MOV(SM1dancerSTOP.ERR,Error[2])MOV(SM1dancerJOG.ERR,Error[3]);]]>
