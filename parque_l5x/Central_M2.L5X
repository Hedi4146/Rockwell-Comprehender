<Routine Name="R004_ChangeSize_LengthProduct" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
In caso di errore nella impostazione del formato, carico il valore di default
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[LES(HmiSizeSelector,1) ,GRT(HmiSizeSelector,5) ]MOV(1,HmiSizeSelector);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
CHANGE SIZE DATA MANAGEMENT (length product and offset of motors)
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
SIZE 1 / SIZE S
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[NEQ(HmiSizeSelector,1)JMP(Size2);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOV(HmiProductLength_S,HmiProductLength)MOV(HmiFrontalLength_S,HmiFrontalLength)MOV(HmiTapeLength_S,HmiTapeLength)MOV(HmiPadLength_S,HmiPadLength);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[MOV(Mx_HMI_Offset_LenProd_S[4],M4Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_S[6],M6Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_S[9],M9Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_S[10],M10Data.Input.AxPar.HmiOfsetLength) ,MOV(Mx_HMI_Offset_LenProd_S[11],M11Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_S[13],M13Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_S[14],M14Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_S[15],M15Data.Input.AxPar.HmiOfsetLength) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JMP(EndChangeSize);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
SIZE 2 / SIZE M
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[LBL(Size2)NEQ(HmiSizeSelector,2)JMP(Size3);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[MOV(HmiProductLength_M,HmiProductLength)MOV(HmiFrontalLength_M,HmiFrontalLength)MOV(HmiTapeLength_M,HmiTapeLength)MOV(HmiPadLength_M,HmiPadLength);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[MOV(Mx_HMI_Offset_LenProd_M[4],M4Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_M[6],M6Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_M[9],M9Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_M[10],M10Data.Input.AxPar.HmiOfsetLength) ,MOV(Mx_HMI_Offset_LenProd_M[11],M11Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_M[13],M13Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_M[14],M14Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_M[15],M15Data.Input.AxPar.HmiOfsetLength) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[JMP(EndChangeSize);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
SIZE 3 / SIZE L
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[LBL(Size3)NEQ(HmiSizeSelector,3)JMP(Size4);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[MOV(HmiProductLength_L,HmiProductLength)MOV(HmiFrontalLength_L,HmiFrontalLength)MOV(HmiTapeLength_L,HmiTapeLength)MOV(HmiPadLength_L,HmiPadLength);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[MOV(Mx_HMI_Offset_LenProd_L[4],M4Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_L[6],M6Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_L[9],M9Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_L[10],M10Data.Input.AxPar.HmiOfsetLength) ,MOV(Mx_HMI_Offset_LenProd_L[11],M11Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_L[13],M13Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_L[14],M14Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_L[15],M15Data.Input.AxPar.HmiOfsetLength) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[JMP(EndChangeSize);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
SIZE 4 / SIZE XL
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[LBL(Size4)NEQ(HmiSizeSelector,4)JMP(Size5);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[MOV(HmiProductLength_XL,HmiProductLength)MOV(HmiFrontalLength_XL,HmiFrontalLength)MOV(HmiTapeLength_XL,HmiTapeLength)MOV(HmiPadLength_XL,HmiPadLength);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[MOV(Mx_HMI_Offset_LenProd_XL[4],M4Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_XL[6],M6Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_XL[9],M9Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_XL[10],M10Data.Input.AxPar.HmiOfsetLength) ,MOV(Mx_HMI_Offset_LenProd_XL[11],M11Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_XL[13],M13Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_XL[14],M14Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_XL[15],M15Data.Input.AxPar.HmiOfsetLength) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[JMP(EndChangeSize);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
SIZE 5 / SIZE XXL
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[LBL(Size5)NEQ(HmiSizeSelector,5)JMP(Size6);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[MOV(HmiProductLength_XXL,HmiProductLength)MOV(HmiFrontalLength_XXL,HmiFrontalLength)MOV(HmiTapeLength_XXL,HmiTapeLength)MOV(HmiPadLength_XXL,HmiPadLength);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[[MOV(Mx_HMI_Offset_LenProd_XXL[4],M4Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_XXL[6],M6Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_XXL[9],M9Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_XXL[10],M10Data.Input.AxPar.HmiOfsetLength) ,MOV(Mx_HMI_Offset_LenProd_XXL[11],M11Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_XXL[13],M13Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_XXL[14],M14Data.Input.AxPar.HmiOfsetLength) MOV(Mx_HMI_Offset_LenProd_XXL[15],M15Data.Input.AxPar.HmiOfsetLength) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[JMP(EndChangeSize);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
PRODUCT LENGTH CALCULATION for DRIVES (product length + offset)
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[LBL(EndChangeSize)ADD(HmiFrontalLength,M11Data.Input.AxPar.HmiOfsetLength,M11Data.Input.AxPar.ProductLength);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[ADD(HmiProductLength,M4Data.Input.AxPar.HmiOfsetLength,M4Data.Input.AxPar.ProductLength)ADD(HmiProductLength,M6Data.Input.AxPar.HmiOfsetLength,M6Data.Input.AxPar.ProductLength);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[ADD(HmiProductLength,M9Data.Input.AxPar.HmiOfsetLength,M9Data.Input.AxPar.ProductLength)ADD(HmiProductLength,M10Data.Input.AxPar.HmiOfsetLength,M10Data.Input.AxPar.ProductLength);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[ADD(HmiProductLength,M13Data.Input.AxPar.HmiOfsetLength,M13Data.Input.AxPar.ProductLength)ADD(HmiProductLength,M14Data.Input.AxPar.HmiOfsetLength,M14Data.Input.AxPar.ProductLength)ADD(HmiProductLength,M15Data.Input.AxPar.HmiOfsetLength,M15Data.Input.AxPar.ProductLength);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(Cmd_Cargar_Talla)TON(Timer[5],?,?)XIC(Timer[5].DN)[OTL(CMD_Cambio_Talla) ,MOV(HmiSizeSelector,NewHmiSizeSelector) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[NEQ(HmiSizeSelector,NewHmiSizeSelector)OTU(CMD_Cambio_Talla);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[EQU(HmiSizeSelector,1) OTE(Size_S) ,EQU(HmiSizeSelector,2) OTE(Size_M) ,EQU(HmiSizeSelector,3) OTE(Size_L) ,EQU(HmiSizeSelector,4) OTE(Size_XL) ,EQU(HmiSizeSelector,5) OTE(Size_XXL) ,OTU(Cmd_Cargar_Talla) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R005_Utilities" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(ON)OTL(ON);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(OFF)OTU(OFF);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
CLOCK 2 sec
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[XIO(AuxTON[1].DN) TON(AuxTON[1],?,?) ,[XIC(AuxTON[1].DN) ,XIC(Clock0_5Hz) ] [XIO(AuxTON[1].DN) ,XIO(Clock0_5Hz) ] OTE(Clock0_5Hz) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
CLOCK 1 sec
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[XIO(AuxTON[2].DN) TON(AuxTON[2],?,?) ,[XIC(AuxTON[2].DN) ,XIC(Clock1Hz) ] [XIO(AuxTON[2].DN) ,XIO(Clock1Hz) ] OTE(Clock1Hz) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
CLOCK 0,5 sec
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[XIO(AuxTON[7].DN) TON(AuxTON[7],?,?) ,[XIC(AuxTON[7].DN) ,XIC(Clock0_5sec) ] [XIO(AuxTON[7].DN) ,XIO(Clock0_5sec) ] OTE(Clock0_5sec) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
CLOCK 100 mmsec
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[XIO(AuxTON[3].DN) TON(AuxTON[3],?,?) ,[XIC(AuxTON[3].DN) ,XIC(Clock10Hz) ] [XIO(AuxTON[3].DN) ,XIO(Clock10Hz) ] OTE(Clock10Hz) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[---------------------------------------------------------------------------------------------------------------------------------------------------------
CLOCK FASATORE
---------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[XIO(AuxTON[5].DN) TON(AuxTON[5],?,?) ,[XIC(AuxTON[5].DN) ,XIC(Clock_fasatore) ] [XIO(AuxTON[5].DN) ,XIO(Clock_fasatore) ] [OTE(Clock_fasatore) ,OTE(Clock_100ms) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
PHASERS MANAGEMENT
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[EQU(HMI_Phaser_Selected,1) [OTE(Phaser_ON.1) ,MOV(HMI_Delta_to_Move,Delta_to_Move_M1) ] ,EQU(HMI_Phaser_Selected,2) [OTE(Phaser_ON.2) ,MOV(HMI_Delta_to_Move,Delta_to_Move_M2) ] ,EQU(HMI_Phaser_Selected,3) [OTE(Phaser_ON.3) ,MOV(HMI_Delta_to_Move,Delta_to_Move_M3) ] ,EQU(HMI_Phaser_Selected,5) [OTE(Phaser_ON.5) ,MOV(HMI_Delta_to_Move,Delta_to_Move_M5) ] ,EQU(HMI_Phaser_Selected,8) [OTE(Phaser_ON.8) ,MOV(HMI_Delta_to_Move,Delta_to_Move_M8) ] ,EQU(HMI_Phaser_Selected,12) [OTE(Phaser_ON.12) ,MOV(HMI_Delta_to_Move,Delta_to_Move_M12) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[NEQ(HMI_Phaser_Selected,1)NEQ(HMI_Phaser_Selected,2)NEQ(HMI_Phaser_Selected,3)NEQ(HMI_Phaser_Selected,5)NEQ(HMI_Phaser_Selected,8)NEQ(HMI_Phaser_Selected,12)MOV(0,HMI_Phaser_Selected);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[

MENSAJE PARA COMPARTIR CON DEMÁS PLC´S


]]>
</Comment>
<Text>
<![CDATA[MOV(HmiSizeSelector,Datos_Compartidos.HmiSizeSelector);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[
CONTADOR DE CORTE DE CUCHILLA SISTEMA DE CINTA FRONTAL

]]>
</Comment>
<Text>
<![CDATA[[LIM(180,M8.ActualPosition,300) ONS(ONS.0) CTU(Contador_Corte_Cinta_Frontal,?,?) ,XIC(HMI_Reset_Contador_CF) RES(Contador_Corte_Cinta_Frontal) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[---------------------------------------------------------------------------
----------------------------------------------------------------------------

LECTURA DE TEMPERATURA SERVO MOTORES PLC CENTRAL
----------------------------------------------------------------------------
----------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[XIC(BIT[12].15)[[XIC(READ_TEMP_CENTRAL) ONS(BIT[12].4) MSG(MSGM1) ,XIC(MSGM1.DN) ONS(BIT[12].5) [MSG(MSGM2) ,CLR(MSGM1.Flags) ] ,XIC(MSGM2.DN) ONS(BIT[12].7) [MSG(MSGM10) ,CLR(MSGM2.Flags) ] ,XIC(MSGM10.DN) ONS(BIT[12].8) [MSG(MSGM4) ,CLR(MSGM10.Flags) ] ,XIC(MSGM4.DN) ONS(BIT[12].11) [MSG(MSGM5) ,CLR(MSGM4.Flags) ] ,XIC(MSGM5.DN) ONS(BIT[12].10) [MSG(MSGM6) ,CLR(MSGM5.Flags) ] ,XIC(MSGM6.DN) ONS(BIT[12].12) [MSG(MSGM15) ,CLR(MSGM6.Flags) ] ] ,XIC(BIT[12].14) [MOV(0,Temp_M1) MOV(0,Temp_M2) MOV(0,Temp_M10) MOV(0,Temp_M4) ,MOV(0,Temp_M5) MOV(0,Temp_M6) MOV(0,Temp_M15) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[[XIC(MSGM15.DN) ONS(BIT[13].1) [MSG(MSGM7) ,CLR(MSGM15.Flags) ] ,XIC(MSGM7.DN) ONS(BIT[13].2) [MSG(MSGM8) ,CLR(MSGM7.Flags) ] ,XIC(MSGM8.DN) ONS(BIT[13].4) [MSG(MSGM9) ,CLR(MSGM8.Flags) ] ,XIC(MSGM9.DN) ONS(BIT[13].5) [MSG(MSGM3) ,CLR(MSGM9.Flags) ] ,XIC(MSGM3.DN) ONS(BIT[13].6) [MSG(MSGM11) ,CLR(MSGM3.Flags) ] ,XIC(MSGM11.DN) ONS(BIT[13].6) [MSG(MSGM12) ,CLR(MSGM11.Flags) ] ,XIC(MSGM12.DN) ONS(BIT[13].7) [MSG(MSGM13) ,CLR(MSGM12.Flags) ] ,XIC(MSGM13.DN) ONS(BIT[13].8) [MSG(MSGM14) ,CLR(MSGM13.Flags) ] ] ,XIC(BIT[13].0) [MOV(0,Temp_M7) MOV(0,Temp_M8) MOV(0,Temp_M9) MOV(0,Temp_M3) ,MOV(0,Temp_M11) MOV(0,Temp_M12) MOV(0,Temp_M13) MOV(0,Temp_M14) ] ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------
LECTURA DE TEMP SERVO DRIVES STACKER
---------------------------------------------------------------------------------------
-------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[[XIC(MSGM14.DN) ONS(BIT[13].9) [MSG(MSGM20) ,CLR(MSGM14.Flags) ] ,XIC(MSGM20.DN) ONS(BIT[13].11) [MSG(MSGM21) ,CLR(MSGM20.Flags) ] ,XIC(MSGM21.DN) ONS(BIT[13].12) [MSG(MSGM22) ,CLR(MSGM21.Flags) ] ,XIC(MSGM22.DN) ONS(BIT[13].13) [MSG(MSGM23) OTE(BIT[13].3) ,CLR(MSGM22.Flags) ] ,XIC(MSGM23.DN) ONS(BIT[13].14) [MSG(MSGM24) OTE(BIT[13].3) ,CLR(MSGM23.Flags) ] ,XIC(MSGM24.DN) ONS(BIT[13].15) [MSG(MSGM25) ,CLR(MSGM24.Flags) ] ,XIC(MSGM25.DN) ONS(BIT[14].0) [MSG(MSGM27) ,CLR(MSGM25.Flags) ] ,XIC(MSGM27.DN) ONS(BIT[14].1) [OTE(BIT[13].3) ,CLR(MSGM27.Flags) ] ] ,XIC(BIT[13].10) [MOV(0,Temp_M20) MOV(0,Temp_M21) MOV(0,Temp_M22) MOV(0,Temp_M23) ,MOV(0,Temp_M24) MOV(0,Temp_M25) MOV(0,Temp_M27) ] ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[--------------------------------------------------------------------------------------
--------------------------------------------------------------------------------------
LECTURA DE TEMP SERVO DRIVES LAMINADOR
---------------------------------------------------------------------------------------
-------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[XIC(BIT[14].4) ONS(BIT[14].6) OTE(BIT[14].5) ,XIC(BIT[14].2) XIC(BIT[14].3) [MOV(0,Temp_SM7) MOV(0,Temp_SM8) MOV(0,Temp_SM5) ,MOV(0,Temp_SM6) MOV(0,Temp_SM4) MOV(0,Temp_SM3) ] ];]]>
</Text>
</Rung>
