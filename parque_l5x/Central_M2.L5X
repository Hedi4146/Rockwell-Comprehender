</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[JSR(Reset,0);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[JSR(Move,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Move" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(Stacker_CMD.Move_Man_Auto)XIC(Start_Simulation)[CPT(Simulation_Pulse,60000/Speed_Simulation/2) MOV(Simulation_Pulse,Off_Time) MOV(Simulation_Pulse,On_Time) ,XIC(Stacker_Status.All_Servos_Ready) Blink(Blink[1],Pulse.1,Off_Time,On_Time) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(Stacker_Status.Alarm_Present) ,XIC(Stacker_CMD.Move_Man_Auto) ]OTU(Start_Simulation);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Reset" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
*******************************************************
Reset Sequence
requirements to Enable reset
*******************************************************]]>
</Comment>
<Text>
<![CDATA[XIO(Stacker_InPut.E_Stop_Op)XIO(Stacker_InPut.E_Stop_Front)XIO(Stacker_InPut.E_Stop_Main)XIO(Stacker_InPut.Torque_Safe_Off)XIO(Stacker_InPut.Torque_Safe_Off_Vertical)XIO(Stacker_InPut.Upper_Guard)XIO(Stacker_InPut.Lower_Guard)XIO(Stacker_InPut.Back_Guard)XIO(Stacker_InPut.Operator_Guard)XIO(BIT[1].11)XIO(BIT[1].13)XIC(Stacker_InPut.Homing_Servo_Exp_Op)XIC(Stacker_InPut.Homing_Servo_Exp_Dr)XIO(Stacker_InPut.Thermal_Alarm_220Vac)OTE(Enable_To_Reset);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[
*******************************************************
Start Reset Sequence
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[[XIC(Stacker_InPut.PB_Reset) ,XIC(Reset_Time.TT) ] XIC(Enable_To_Reset) XIO(Stacker_Status.Ready_to_Operate) XIO(Reset_Time.DN) TON(Reset_Time,?,?) OTE(Stacker_CMD.FaultReset_Sequence) ,LIM(100,Reset_Time.ACC,2000) OTE(Stacker_CMD.FaultReset_Time) ,LIM(2000,Reset_Time.ACC,3000) XIO(Stacker_Status.Alarm_Present) OTE(Stacker_CMD.Enable_Servos) ,LIM(5000,Reset_Time.ACC,7000) XIC(Stacker_Status.All_Servos_On) XIC(Pulse.3) OTL(Stacker_Status.All_Servos_Positioning) OTL(Stacker_CMD.Homing) ,XIC(Stacker_Status.Ready_to_Operate) OTU(Stacker_CMD.Homing) ,[XIC(Stacker_Status.All_Servos_Homed) ,XIC(Stacker_Status.Alarm_Present) ] OTU(Stacker_CMD.Homing) ];]]>
</Text>
</Rung>
</RLLContent>
