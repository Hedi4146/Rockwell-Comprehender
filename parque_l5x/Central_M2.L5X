<Text>
<![CDATA[XIC(M20_Status.Ready)XIO(M20_CMD.Homing)ADD(Pos_03_M20.Position,3,Pos_03_M20.High)SUB(Pos_03_M20.Position,3,Pos_03_M20.Low)LIM(Pos_03_M20.Low,M20.ActualPosition,Pos_03_M20.High)OTE(Pos_03_M20.Ok);]]>
