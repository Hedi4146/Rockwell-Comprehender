<Text>
<![CDATA[[AHT_Enable_DriveAxis(EDA_M13,StartMotors,MachineMoving,OFF,HMI_Enable_M13) ,OTU(M13Data.Input.Dancer.HmiEnable) OTU(M13Data_MARK.Input.Dancer.HmiEnable) ,MOV(HMI_M13_RollDiameter,M13Data.Input.AxPar.HmiRollDiameter) MOV(HMI_M13_AccRate,M13Data_MARK.Motion.HmiGearAccelRate) ,MOV(HMI_M13_RollDiameter,M13Data_MARK.Input.AxPar.HmiRollDiameter) MOV(HMI_M13_AccRate,M13Data.Motion.HmiGearAccelRate) ,AHT_DriveRoll_withoutDancer(DB_M13,EDA_M13.Enable_Cond,Start_Machine,ResetAlarm,M13,Vmaster1,Axis.GroupSynced,M13Data) ,XIC(Jog_Manual_Laminador) XIO(M13_MAJ.IP) MAJ(M13,M13_MAJ,M13_MAJ_Direction,Speed_Jog_M13,Units per sec,50,Units per sec2,50,% of Maximum,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None) ,XIO(Jog_Manual_Laminador) ONS(ONS.2) MAS(M13,M13_MAS,Jog,Yes,1000,Units per sec2,No,1000,Units per sec3) ,GSV(Axis,M13,ConversionConstant,ConvConstant_M13) GSV(Axis,M13,DriveResolution,DriveResolution_M13) ,GRT(SpeedPPM,10) CPT(RPM_M13_1,ConvConstant_M13*M13.AverageVelocity/DriveResolution_M13*60) ,ABS(RPM_M13_1,RPM_M13) CPT(BackSheet_Actual_Veloc,RPM_M13/3*3.1416*205) ];]]>
