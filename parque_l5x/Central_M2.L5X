<![CDATA[XIC(HMI_Cmd_Confirm)SSV(Axis,Ref_ServoAxis,VelocityLimitNegative,HMI_Axis_VLN)SSV(Axis,Ref_ServoAxis,VelocityLimitPositive,HMI_Axis_VLP)SSV(Axis,Ref_ServoAxis,TorqueLimitNegative,HMI_Axis_TLN)SSV(Axis,Ref_ServoAxis,TorqueLimitPositive,HMI_Axis_TLP);]]>
