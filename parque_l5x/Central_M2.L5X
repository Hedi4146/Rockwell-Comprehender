***************************************************************************************]]>
</Comment>
<Text>
<![CDATA[EQU(Master.AverageVelocity,0)[[XIC(Glue_Rack_3:0:I.0) ,XIC(BIT_PURGA.0) ,XIC(Glue_Rack_3:0:I.1) ,XIC(BIT_PURGA.1) ] OTE(Glue_Gun_Manual.0) OTE(Glue_Gun_Manual.1) ,[XIC(Glue_Rack_3:0:I.2) ,XIC(BIT_PURGA.2) ] OTE(Glue_Gun_Manual.2) ,[XIC(Glue_Rack_3:0:I.3) ,XIC(BIT_PURGA.3) ] OTE(Glue_Gun_Manual.3) ,[XIC(Glue_Rack_3:0:I.4) ,XIC(BIT_PURGA.4) ] OTE(Glue_Gun_Manual.4) ,[XIC(Glue_Rack_3:0:I.5) ,XIC(BIT_PURGA.5) ] OTE(Glue_Gun_Manual.5) ,[XIC(Glue_Rack_3:0:I.6) ,XIC(BIT_PURGA.6) ] OTE(Glue_Gun_Manual.6) ,[XIC(BIT_PURGA.7) ,XIC(BIT_PURGA.7) ] OTE(Glue_Gun_Manual.7) ,[XIC(Glue_Rack_3:0:I.8) ,XIC(BIT_PURGA.8) ] OTE(Glue_Gun_Manual.8) ,[XIC(BIT[9].15) ,XIC(BIT_PURGA.9) ] OTE(Glue_Gun_Manual.9) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[GRT(Master.AverageVelocity,1)MOV(0,BIT_PURGA);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[****************************************************************************************************************
ENTRADAS CONTROL MANUAL VALVULAS ADHESIVOS CONTINUAS
***************************************************************************************]]>
</Comment>
<Text>
<![CDATA[EQU(Master.AverageVelocity,0)[[XIC(Glue_Rack_3:0:I.14) ,XIC(BIT_PURGA.10) ] OTE(Glue_Gun_Manual.16) ,[XIC(Glue_Rack_3:0:I.15) ,XIC(BIT_PURGA.11) ] OTE(Glue_Gun_Manual.17) ,[XIC(Glue_Rack_3:1:I.0) ,XIC(BIT_PURGA.12) ] OTE(Glue_Gun_Manual.18) ,[XIC(Glue_Rack_3:0:I.14) ,XIC(Glue_Rack_3:0:I.15) ,XIC(Glue_Rack_3:1:I.0) ] OTE(Selector_Adh_Activado) ,[XIC(Glue_Rack_3:1:I.1) ,XIC(BIT_PURGA.13) ] OTE(Glue_Gun_Manual.19) ,[XIC(Glue_Rack_3:1:I.2) ,XIC(BIT_PURGA.14) ] OTE(Glue_Gun_Manual.20) ,[XIC(Glue_Rack_3:1:I.3) ,XIC(BIT_PURGA.15) ] OTE(Glue_Gun_Manual.21) ,[XIC(Glue_Rack_3:1:I.4) ,XIC(BIT_PURGA.16) ] OTE(Glue_Gun_Manual.22) ,[XIC(BIT_PURGA.17) ,XIC(BIT_PURGA.17) ] XIC(OFF) OTE(Glue_Gun_Manual.23) ,[XIC(Glue_Rack_3:0:I.13) ,XIC(BIT_PURGA.18) ] OTE(Glue_Gun_Manual.24) ,[XIC(Glue_Rack_3:1:I.12) ,XIC(BIT_PURGA.19) ] OTE(Glue_Gun_Manual.25) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[****************************************************************************************************************
ENTRADAS FALLAS TANQUES ADHESIVOS
***************************************************************************************]]>
</Comment>
<Text>
<![CDATA[[XIO(Glue_Rack_3:1:I.10) OTE(Glue_Fault.0) ,XIO(Glue_Rack_3:1:I.5) OTE(Glue_Fault.1) ,XIO(Glue_Rack_3:1:I.9) OTE(Glue_Fault.2) ,XIO(Glue_Rack_3:1:I.6) OTE(Glue_Fault.3) ,XIO(Glue_Rack_3:1:I.7) OTE(Glue_Fault.4) ,XIO(Glue_Rack_3:1:I.8) OTE(Glue_Fault.5) ,XIC(Glue_Rack_3:1:I.11) OTE(Glue_Fault.6) ,XIC(OFF) OTE(Glue_Fault.7) ,[AFI() XIO(Glue_Rack_3:1:I.13) ,XIC(BIT[1].2) [XIC(BIT[4].6) XIC(IO2:1:I.1) ,XIO(IO2:1:I.2) ] TON(TON2,?,?) XIC(TON2.DN) ] OTE(Glue_Fault.8) ,XIC(OFF) OTE(Glue_Fault.9) ,AFI() XIC(BIT[0].11) OTE(Glue_Fault.10) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------
BIT DESACTIVACIÓN SERVOS PLC CENTRAL CON SEÑAL DE GUARDAS ABIERTAS
----------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[XIC(BIT[4].14)[XIC(BIT[5].11) XIC(Glue_Rack_3:7:I.5) ,XIC(PROD_SP.0) ][OTE(NODE_Z1:2:O.0) ,XIC(MachineStill) TOF(OPEN_GUARDS_OFF_TMR,?,?) XIC(OPEN_GUARDS_OFF_TMR.DN) OTE(BIT[4].13) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(PROD_SP.1)OTE(BIT[5].14);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Glue_Rack_3:1:I.3)CTU(ctu_FR,?,?);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(OFF)XIC(PROD_SP.2)OTE(BIT[8].8);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(PROD_SP.4)XIC(MachineStill)[OTE(BIT[6].11) ,CTU(CTU_GUARD_TRANS,?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
