</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(BIT[7].11)[[[XIO(HmiEnableSimulation) XIC(HMI_Main_Enable_MOTORS) ,XIC(HmiEnableSimulation) XIC(HmiStartMotor) ] TON(TON_STRT_MTRS_M2,?,?) ,XIC(TON_STRT_MTRS_M2.DN) OTE(StartMotors_M2) ,XIC(StartMotors_M2) TON(TON_M2_STRT,?,?) ,XIC(TON_M2_STRT.DN) [XIC(HmiEnableSimulation) XIC(HmiStartSimulation) ,XIO(HmiEnableSimulation) ] OTE(start_machine_M2) ] ,XIO(BIT[7].13) OTE(M2_EN_BIT) ,[XIC(BIT[4].13) OTE(BIT[7].12) ,XIC(BIT[7].14) ] OTE(M2_DIS_BIT) ,XIC(M2_EN_BIT) XIC(M2_DIS_BIT) [TON(M2_DIS_TON,?,?) ,XIC(M2_DIS_TON.DN) OTU(BIT[7].13) ] ];]]>
</Text>
</Rung>
