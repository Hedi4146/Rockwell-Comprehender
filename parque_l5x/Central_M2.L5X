<![CDATA[[XIO(Glue_Gun_Manual.21) [GEQ(machineSpeed_DINT,HotMeltMotorAutoOutputSpeed[21]) XIC(BITJPFRONTAL) ,GEQ(machineSpeed_DINT,230) ] ,XIC(Glue_Gun_Manual.21) ]XIC(Motor_Glue_Enable_HMI.21)OTE(Out_Motor_Glue_Enable.21);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
