</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(Stacker_Status.Start_Cycle) ,XIC(MachineStill) XIC(Stacker_InPut.PB_Reset) ]ONS(BIT[6].4)RES(Diapers_Counter);]]>
