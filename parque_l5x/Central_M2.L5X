<![CDATA[XIC(M20_Status.Ready)[[XIC(M20_POS_03.IP) ,XIC(TON[3].TT) ] TON(TON[3],?,?) ,XIO(M20_POS_03.IP) ONS(BIT[0].12) [MOV(TON[3].ACC,Reg[3]) ,GRT(TON[3].ACC,0) CPT(Speed_Travel_Pos_03_M20,(Pos_03_M20.Position-Pos_01_M20.Position)*1000/Reg[3]) ] ];]]>
