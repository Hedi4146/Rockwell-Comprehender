<Routine Name="R000_Alarm" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(Object_Sercos[0].Sts_ER) OTL(hmi_alarm.0) ,AFI() XIC(Object_Sercos[1].Sts_ER) OTL(hmi_alarm.1) ,XIC(Object[3].Sts_ER) OTL(hmi_alarm.2) ,XIC(Object[4].Sts_ER) OTL(hmi_alarm.3) ,[XIC(Object[5].Sts_ER) ,XIC(BIT[2].9) XIO(Object[5].Sts_DriveEnableStatus) XIC(Cmd_ServoSelect[5]) XIC(IO2:4:O.7) ] OTL(hmi_alarm.4) ,[XIC(Object[6].Sts_ER) ,XIC(BIT[2].10) XIO(Object[6].Sts_DriveEnableStatus) XIC(Cmd_ServoSelect[6]) XIC(IO2:4:O.7) ] OTL(hmi_alarm.5) ,XIC(Object[7].Sts_ER) OTL(hmi_alarm.6) ,XIC(Object[8].Sts_ER) OTL(hmi_alarm.7) ,XIO(IO1:2:I.2) OTL(hmi_alarm.8) ,XIC(NW_TENSION.EM_Fault) OTE(hmi_alarm.9) ,XIC(PE_TENSION.EM_Fault) OTE(hmi_alarm.10) ,[XIC(Cmd_Stop_1) ,XIC(IO1:2:I.0) ] OTL(hmi_alarm.11) ,XIO(HmiEnableSimulation) [XIO(Cmd_Servo_Enable) ,XIC(BIT[3].13) XIO(Cmd_Enable[3]) ,XIC(BIT[3].13) XIO(Cmd_Enable[4]) ,XIC(BIT[3].13) XIC(sm3_date.MAJ_EN) ,XIC(BIT[3].13) XIC(sm4_date.MAJ_EN) ] [[GRT(machineSpeed_DINT,2) ,EQU(machineSpeed_DINT,0) ] ,XIC(BIT[3].7) ] OTL(hmi_alarm.12) ,XIO(IO1:1:I.0) OTL(hmi_alarm.13) ,[XIC(IO2:2:I.7) XIC(Object[8].Sts_EnableDone) TON(TON_GUARD_DER_POLY,?,?) ,XIC(IO2:2:I.0) XIC(Object[7].Sts_EnableDone) TON(TON_GUARD_IZQ_POLY,?,?) ] ,[XIC(IO2:2:I.5) ,XIO(IO2:2:I.2) XIC(BIT[12].0) ,XIC(IO2:2:I.7) XIC(sm8_date.servo_jog.EN) ,XIC(IO2:2:I.0) XIC(sm7_date.servo_jog.EN) ,XIC(TON_GUARD_DER_POLY.DN) ,XIC(TON_GUARD_IZQ_POLY.DN) ] OTL(hmi_alarm.14) ,XIC(IO2:2:I.6) OTL(hmi_alarm.15) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(IO1:1:I.4) [TON(T1,?,?) ,XIC(T1.DN) OTL(hmi_alarm1.0) ] ,XIO(IO2:1:I.4) [TON(T2,?,?) ,XIC(T2.DN) OTL(hmi_alarm1.1) ] ,XIO(IO1:1:I.2) OTL(hmi_alarm1.2) ,[GRT(hmi_alarm,0) ,GRT(hmi_alarm1,0) ,XIO(IO1:1:I.2) ,XIC(IO2:2:I.5) ,XIC(IO2:2:I.6) ] OTE(Laminator_Alarm_Present) OTE(Glue_Rack_3:5:O.11) ,[XIC(HMI_Err_Rst) ,XIC(ResetAlarm) ] CLR(hmi_alarm) CLR(hmi_alarm1) ];]]>
</Text>
</Rung>
</RLLContent>
