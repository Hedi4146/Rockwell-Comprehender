<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(ER_Clearing)[XIC(Wrk_MI_MAJ.ER) CLR(Wrk_MI_MAJ.FLAGS) ,XIC(Wrk_MI_MAS_ALL.ER) CLR(Wrk_MI_MAS_ALL.FLAGS) ,XIC(Wrk_MI_Home.ER) CLR(Wrk_MI_Home.FLAGS) ];]]>
