</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
PARAMETRI DA IMPOSTARE SU HMI
HMI_POLYMark_SetPosition / Hmi_POLYMark_gain / HMI_POLYMark_MaxCorr / HMI_POLYMark_SpeedGain
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
AxRegistration1InputStatus e' la Tag relativa a
ASSE.Registration1InputStatus dell'asse in cui e' cablato il sensore di tacca 
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[AFI()[XIC(HMI_Enable_PolyMark) GRT(M14.AverageVelocity,300) OTE(Start_Phase_Correction) ,GRT(Master.AverageVelocity,500) TON(time_change_gain,?,?) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIO(time_change_gain.DN) ONS(ONS.6) MOV(gain_Start,HMI_POLYMark_MaxCorr) ,XIC(time_change_gain.DN) ONS(ONS.7) MOV(Gain_Run,HMI_POLYMark_MaxCorr) ,MOV(HMI_POLYMark_MaxCorr,PhaseErrorHLimit) MUL(HMI_POLYMark_MaxCorr,-1,PhaseErrorLLimit) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(Start_Phase_Correction) TON(retardo_MAR,?,?) XIC(retardo_MAR.DN) [XIO(Poly_Reg_ReArmed) MAR(M2,ServoAxis_MAR,Positive_Edge,Disabled,0,360,2) ,[[XIC(ServoAxis_MAR.IP) ,XIC(ServoAxis_MAR.EN) ] ,XIO(ServoAxis_MAR.PC) XIC(Poly_Reg_ReArmed) ] OTE(Poly_Reg_ReArmed) ] ,XIO(Start_Phase_Correction) ONS(ONS.4) MDR(M2,ServoAxisMDR,2) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(ServoAxis_MAR.PC)ONS(ONS.10)[MOV(Error_actual_1,Error_Next_1) MOV(ErrorValue,Error_actual_1) ,SUB(ErrorValue,Error_Next_1,Ruidos) ABS(Ruidos,Ruido_Poly) ADD(HMI_POLYMark_MaxCorr,5,Correcion_Lim_Ruido) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(open_Calc)XIC(ServoAxis_MAR.PC)ONS(ONS.8)[CTU(Counter_Taca,?,?) ADD(ErrorValue,ErrorValue_Acc,ErrorValue_Acc) ,XIC(Counter_Taca.DN) RES(Counter_Taca) [CPT(Everage_ErrorValue,ErrorValue_Acc/Counter_Taca.PRE) ,MOV(0,ErrorValue_Acc) ] ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(Start_Phase_Correction)XIC(ServoAxis_MAR.PC)ONS(ONS.5)[SUB(M2.Registration2Position,HMI_POLYMark_SetPosition,ErrorValue_2) SUB(M2.Registration2Position,HMI_POLYMark_SetPosition,ErrorValue) ,GRT(ErrorValue,180.0) SUB(ErrorValue,360.0,ErrorAngle) ,LES(ErrorValue,-180.0) ADD(ErrorValue,360.0,ErrorAngle) ,LIM(-180.0,ErrorValue,180.0) MOV(ErrorValue,ErrorAngle) ,CPT(Error_Taca_mm,HmiProductLength/360.0*ErrorAngle) ,CPT(ErrorLength,360/(HMI_M13_RollDiameter*3.1415927)*Error_Taca_mm) ,LIM(PhaseErrorLLimit,ErrorLength,PhaseErrorHLimit) MOV(ErrorLength,CorrectionValue) ,LIM(PhaseErrorHLimit,ErrorLength,PhaseErrorLLimit) [GRT(ErrorLength,PhaseErrorHLimit) MOV(PhaseErrorHLimit,CorrectionValue) ,LES(ErrorLength,PhaseErrorLLimit) MOV(PhaseErrorLLimit,CorrectionValue) ] ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Start_Phase_Correction)LES(Ruido_Poly,15)GRT(M6.AverageVelocity,1000)XIC(retardo_MAR.DN)XIC(M14.ServoActionStatus)XIC(ServoAxis_MAR.PC)ONS(ONS10.0)[MUL(M13.AverageVelocity,SpeedRatio,PhaseCorrectionSpeed) ,MAM(M13,ServoAxis_MCM_MAM,1,CorrectionValue,PhaseCorrectionSpeed,Units per sec,AccelRate,% of Maximum,DecelRate,% of Maximum,Trapezoidal,100,100,% of Time,Disabled,Programmed,0,None,0,0) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[[XIC(ServoAxis_MAR.ER) OTE(ErrorMarkPolyPhase) ,XIC(ServoAxis_MCM_MAM.ER) OTE(ErrorMAMPolyPhase) ] ,XIC(ResetAlarm) [XIC(ServoAxis_MAR.ER) CLR(ServoAxis_MAR.FLAGS) ,XIC(ServoAxis_MCM_MAM.ER) CLR(ServoAxis_MCM_MAM.FLAGS) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
