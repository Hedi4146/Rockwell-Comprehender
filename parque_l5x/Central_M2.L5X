<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Cmd_Enable)[EQU(Ref_Axis_CD.CIPAxisState,2) XIO(Ref_Axis_CD.ServoActionStatus) XIO(Ref_Axis_CD.DriveEnableStatus) XIO(Cmd_Disable) XIO(Sts_ER) MSO(Ref_Axis_CD,Wrk_MI_Enable) ,XIC(Ref_Axis_CD.PowerStructureEnabledStatus) XIC(Ref_Axis_CD.ServoActionStatus) OTE(Sts_EnableDone) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Cmd_Disable)[MSF(Ref_Axis_CD,Wrk_MI_Disable) ,[XIC(Wrk_MI_Disable.DN) ,XIC(Wrk_MI_Disable.ER) ] XIO(Ref_Axis_CD.ServoActionStatus) OTE(Sts_DisableDone) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Cmd_FaultReset)XIC(Sts_ER)MAFR(Ref_Axis_CD,Wrk_MI_FaultReset);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Cmd_Stop)XIC(Wrk_MI_Enable.DN)MAS(Ref_Axis_CD,MC_MAS,All,No,0,Units per sec2,0,0,Units per sec3);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[LIM(11,Ref_Axis_CD.CIPAxisState,0) AFI() ,EQU(Ref_Axis_CD.CIPAxisState,8) ,NEQ(Ref_Axis_CD.AxisFault,0) ,NEQ(Ref_Axis_CD.ModuleFaults,0) ,NEQ(Ref_Axis_CD.GuardFaults,0) ,[XIC(Ref_Axis_CD.SoftTravelLimitPositiveFault) ,XIC(Ref_Axis_CD.HardwareOvertravelPositiveFault) ] ,[XIC(Ref_Axis_CD.SoftTravelLimitNegativeFault) ,XIC(Ref_Axis_CD.HardwareOvertravelNegativeFault) ] ,XIC(Ref_Axis_CD.FeedbackDeviceFault) ,[XIC(Ref_Axis_CD.ConverterPreChargeOverloadFLFault) ,XIC(Ref_Axis_CD.MotorThermalOverloadFLFault) ,XIC(Ref_Axis_CD.InverterThermalOverloadFLFault) ,XIC(Ref_Axis_CD.ConverterThermalOverloadFLFault) ,XIC(Ref_Axis_CD.BusRegulatorThermalOverloadFLFault) ,XIC(Ref_Axis_CD.ModuleVoltageMismatchFault) ,XIC(Ref_Axis_CD.MotorCommutationFault) ,XIC(Ref_Axis_CD.InverterOvercurrentFault) ,XIC(Ref_Axis_CD.BusOvervoltageFLFault) ,XIC(Ref_Axis_CD.BusUndervoltageFLFault) ,XIC(Ref_Axis_CD.ConverterACSinglePhaseLossFault) ] ,[XIC(Ref_Axis_CD.MotorOvertemperatureFLFault) ,XIC(Ref_Axis_CD.InverterOvertemperatureFLFault) ,XIC(Ref_Axis_CD.ConverterOvertemperatureFLFault) ,XIC(Ref_Axis_CD.BusRegulatorOvertemperatureFLFault) ] ,XIC(Ref_Axis_CD.ExcessivePositionErrorFault) ,XIC(Ref_Axis_CD.GuardFault) ]OTE(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(Sts_ER)XIC(Inp_MotionGroup.GroupSynced)XIO(Ref_Axis_CD.InitializationFault)XIO(Ref_Axis_CD.ModuleFault)XIO(Ref_Axis_CD.ShutdownStatus)OTE(Sts_AxisOk);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Ref_Axis_CD.DCBusUpStatus)OTE(Sts_DCBusUpStatus);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Ref_Axis_CD.ServoActionStatus)OTE(Sts_ServoActionStatus);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Ref_Axis_CD.DriveEnableStatus)OTE(Sts_DriveEnableStatus);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="Axis_Object_Sercos" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2013-01-20T06:10:30.906Z" CreatedBy="Not Available" EditedDate="2016-08-15T17:19:37.651Z" EditedBy="WIN-SKR9MNL7BFS\Pc" SoftwareRevision="v24.00">
