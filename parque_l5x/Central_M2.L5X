<![CDATA[XIC(Stacker_CMD.FaultReset)CLR(M20_POS_01.FLAGS)CLR(M20_POS_02.FLAGS)CLR(M20_POS_03.FLAGS)CLR(Servo_Home_M20.FLAGS)OTU(M20_CMD.Pos_01)OTU(M20_CMD.Pos_02)OTU(M20_CMD.Pos_03);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[-----------------------------------------------------------------------------

 100 DIAPERS BAG PACKING INTERFACE
----------------------------------------------------
POS 03 EXP OP EMPAQUE X 100 XG= 540
POS 03 EXP OP EMPAQUE OTRO XG= 465

---------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[XIC(BIT[2].14)EQU(Stacker_HMI.Move,1)XIC(M20_POS_03_Motion_Completed)OTL(BIT[3].3);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(BIT[3].3)[TON(TON3,?,?) ,XIC(TON3.DN) OTE(NODE_Z1:2:O.1) ,TON(TON4,?,?) XIC(TON4.DN) OTU(BIT[3].3) ,XIC(BIT[3].11) [XIC(Size_L) MOV(Pos_03_M20_L_SIZE,Pos_03_M20.Position) ,XIC(Size_XL) MOV(Pos_03_M20_XL_SIZE,Pos_03_M20.Position) ,XIC(Size_XXL) MOV(Pos_03_M20_XXL_SIZE,Pos_03_M20.Position) ] ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIO(BIT[2].14)XIC(BIT_47)MOV(Pos_03_M20_NO_BAGGER,Pos_03_M20.Position);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[14-JUN-2021: 
VALOR PARAMETRO  Pos_03_M20.position para TALLA  "L"= 540 (BAGGER RUNNING)
VALOR PARAMETRO  Pos_03_M20.position para TALLA  "XL"= 540 (BAGGER RUNNING)
VALOR PARAMETRO  Pos_03_M20.position para TALLA  "XL"= 470 (NO BAGGER)]]>
</Comment>
<Text>
<![CDATA[[SUB(Pos_03_M20.Position,20,P03_M20F) MOV(Pos_03_M20.Position,P03_M20R) ,LIM(P03_M20F,M20.ActualPosition,P03_M20R) OTE(NODE_Z1:2:O.2) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIC(BIT[2].14)[EQU(Stacker_HMI.Move,2) ,]XIO(NODE_Z1:4:I.4)OTE(BIT[2].12);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIO(NODE_Z1:4:I.4)CTU(CTU15,?,?);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R010_0_Master_Consumed" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[
*******************************************************
GrandMaster from Side Panel to Central    
*******************************************************
]]>
</Comment>
<Text>
<![CDATA[[AxisConsumeCIPSync_AOI(AOI_AxisConsumeCIPSync,ConsumedAxisData,Master,Axis,Axis_CSTAid,HmiResetAlarm) ,XIC(AOI_AxisConsumeCIPSync.Sts_ER) OTE(Alarm_Master_Consumed) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R010_Master" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
AUTOMATIC MODE - SIMULATION MODE SELECTION
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[XIO(StartVmaster)[XIO(HmiEnableSimulation) EQU(Vmaster1.AverageVelocity,0) EQU(Master.AverageVelocity,0) [MOV(4,Virtual1Data.Input.AxPar.HmiOpMode) ,MOV(0,Virtual1Data.Motion.HmiGearAccelRate) ] ,XIC(HmiEnableSimulation) EQU(Vmaster1.AverageVelocity,0) EQU(Master.AverageVelocity,0) [MOV(1,Virtual1Data.Input.AxPar.HmiOpMode) ,MOV(Percen_Of_Max_AccRate,Virtual1Data.Motion.HmiAccelRate) ,MOV(Percen_Of_Max_AccRate,Virtual1Data.Motion.HmiDecelRate) ] ,OTU(Virtual1Data.Motion.GearAbsoluteEnableAutoPhase) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------

----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[XIO(Start_Machine)ONS(Aux_Bit.4)XIC(StartMotors)MOV(Vmaster1.ActualPosition,MemVMasterPosition);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(System_Ready) LES(MachineSpeed_PPM,50) NEQ(Master.ActualPosition,Vmaster1.ActualPosition) MRP(Vmaster1,VirtualMRP,Absolute,Actual,Master.ActualPosition) ,SUB(Master.ActualPosition,Vmaster1.ActualPosition,error_Master) NOP() ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
REPOSITION OF GLUE AXIS WHIT REFERENCE TO THE MASTER VIRTUAL POSITION
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[CPT(Master_Scaling_pos,Master.ActualPosition*(HmiProductLength/360)) SUB(Master_Scaling_pos,GlueAxis.ActualPosition,Diff_Master_Glue) ABS(Diff_Master_Glue,Diff_Master_Glue_Abs) ,XIC(Axis.GroupSynced) EQU(Glue_Gun_Manual,0) GRT(Diff_Master_Glue_Abs,5) LES(MachineSpeed_PPM,50) MRP(GlueAxis,GlueAxisMRP,Absolute,Actual,Master_Scaling_pos) ,XIC(GlueAxisMRP.ER) CLR(GlueAxisMRP.FLAGS) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
INCREASE-DECREASE SIMULATED SPEED
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[AFI() XIC(HmiStartSimulation) ONS(Aux_Bit.6) XIC(HmiEnableSimulation) MOV(10,HmiSimulatedSpeed) ,XIC(HmiEnableSimulation) XIC(HmiStartSimulation) [XIC(HMI_SimulatedSpeedUP) ONS(Aux_Bit.7) XIO(HMI_SimulatedSpeedDOWN) ADD(HmiSimulatedSpeed,5,HmiSimulatedSpeed) ,XIC(HMI_SimulatedSpeedDOWN) ONS(Aux_Bit.8) XIO(HMI_SimulatedSpeedUP) SUB(HmiSimulatedSpeed,5,HmiSimulatedSpeed) ] ,[LES(HmiSimulatedSpeed,0) ,XIC(HmiEnableSimulation) XIO(HmiStartSimulation) ,XIC(AlarmPresence) ,XIO(HmiEnableSimulation) ,XIO(Glue_Rack_3:2:I.9) ,XIC(Glue_Rack_3:7:I.6) XIC(BIT[3].12) ] MOV(0,HmiSimulatedSpeed) ,GEQ(HmiSimulatedSpeed,HMI_MaxSimulatedSpeed) MOV(HMI_MaxSimulatedSpeed,HmiSimulatedSpeed) ,[XIC(AlarmPresence) ,XIO(Glue_Rack_3:2:I.9) ] TON(Delay_Stop_Fault,?,?) XIC(Delay_Stop_Fault.DN) [OTU(HmiStartSimulation) ,OTU(HmiStartMotor) ] ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VIRTUAL MASTER JOG SPEED CALCULATION
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[XIC(StartVmaster)NEQ(HmiSimulatedSpeed,LocSimulatedSpeed)[MUL(HmiSimulatedSpeed,6,Virtual1Data.Motion.HmiJogSpeed) ,MOV(HmiSimulatedSpeed,LocSimulatedSpeed) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
VIRTUAL AXIS BLOCK
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[VirtualAxisBlock(AB_Virtual1,Enable_Virtual_Axis,StartVmaster,ResetAlarm,Vmaster1,Master,Axis.GroupSynced,Virtual1Data);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
MACHINE SPEED CALCULATION (PPM) for PROGRAM and HMI
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[ABS(Master.AverageVelocity,ABS_Master_AverageVelocity) ABS(Vmaster1.AverageVelocity,ABS_VirtualMaster_AverageVelocity) ,LES(ABS_VirtualMaster_AverageVelocity,5) MUL(ABS_VirtualMaster_AverageVelocity,0,MachineSpeed_PPM) ,GEQ(ABS_VirtualMaster_AverageVelocity,5) CPT(MachineSpeed_PPM,ABS_VirtualMaster_AverageVelocity*60/360) ,LES(MachineSpeed_PPM,0) MOV(0,MachineSpeed_PPM) ,MOV(MachineSpeed_PPM,machineSpeed_DINT) MOV(ABS_VirtualMaster_AverageVelocity,MachineAverageVelocity) ,XIC(MachineStill) MOV(Master.ActualPosition,HMI_Master_ActualPosition) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[-------------------------------------------------------------------------------------------------------------------
Rutina de control axis glue-- Eje virtual de adhesivos
-------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[XIC(PowerOK) EQU(Master.AverageVelocity,0) ,XIC(servo_off_mtto) NEQ(Glue_Gun_Manual,0) ][TON(Delay_Stop_MAG_Glue,?,?) ,[LIM(2000,Delay_Stop_MAG_Glue.ACC,4000) ,XIC(Time_Change_Size.EN) ] MAS(GlueAxis,Stop_MAG_Glue,Gear,Yes,10000,Units per sec2,No,1000,Units per sec3) ,NEQ(Glue_Gun_Manual,0) XIO(JogModePurge.IP) MAJ(GlueAxis,JogModePurge,0,200,Units per sec,1500,Units per sec2,1500,Units per sec2,Trapezoidal,1000,1000,% of Time,Disabled,Programmed,0,None) ,EQU(Glue_Gun_Manual,0) MAS(GlueAxis,Stop_MAS_ManGlue,Jog,Yes,10000,Units per sec2,No,1000,Units per sec3) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(PowerOK)XIC(Enable_Virtual_Axis)XIC(Axis.GroupSynced)[XIO(GlueAxisMAG.IP) XIO(Stop_MAG_Glue.EN) MAG(GlueAxis,Master,GlueAxisMAG,0,1.0,Glue_Lenght,360000,Command,Fraction_slave_master_counts,Disabled,10000,Units per sec2) ,XIC(MachineMoving) ONS(ONS.11) MAS(GlueAxis,Stop_MAS_Man_Glue,Jog,Yes,10000,Units per sec2,No,1000,Units per sec3) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
