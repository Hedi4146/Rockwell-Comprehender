<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIO(Data.Motion.GearAbsoluteAxPhasing)XIC(Data.Motion.PhaseBackwardCommand)XIO(Data.Motion.ManualPhMamBk.IP)ONS(Aux8)CPT(LocStepManPhase,Data.Motion.HmiManualPhaserStep/-1)[MAM(PhysicalAx,Data.Motion.ManualPhMamBk,1,LocStepManPhase,Data.Motion.HmiManualPhaserVelocity,Units per sec,50,Units per sec2,50,Units per sec2,Trapezoidal,100,100,% of Maximum,Disabled,0,0,None,0,0) ,GRT(Data.Motion.ManualPhaseOffset,0) SUB(Data.Motion.ManualPhaseOffset,Data.Motion.HmiManualPhaserStep,Data.Motion.ManualPhaseOffset) ,LEQ(Data.Motion.ManualPhaseOffset,0) MOV(Data.Input.AxPar.ModuleAx,Data.Motion.ManualPhaseOffset) ];]]>
