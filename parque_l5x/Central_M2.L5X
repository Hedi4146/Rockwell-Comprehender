</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[// Datos de entrada
CHAIN_PITCH = 19.05;         // mm por producto/revolución (master)
ACTUATOR_PITCH = 176;        // mm por revolución (slave)

// Cálculo del ratio para MAG
// Ratio = (Distancia_slave / Revoluciones_slave) / (Distancia_master / Revoluciones_master)
MAG_RATIO = CHAIN_PITCH / ACTUATOR_PITCH;    // = 19.05/176 = 0.10823

// En el programa del servo:
MAG_NUMERATOR = 1082;       // Multiplicado por 10000 para precisión
MAG_DENOMINATOR = 10000;     

// Cálculo de velocidad lineal
PROCEDURE CalculateLinearSpeed(productsPerMinute)
    // Velocidad en mm/s
    linearSpeed = (productsPerMinute * CHAIN_PITCH) / 60;
    RETURN linearSpeed;
END_PROCEDURE

// Ejemplo para 500 ppm:
// linearSpeed = (500 * 19.05) / 60 = 158.75 mm/s]]>
</Comment>
<Text>
<![CDATA[XIC(M25_Status.Ready)[XIC(M25_CMD.Pos_02) ,XIC(Stacker_Status.Start_Cycle) ][XIC(BIT[15].1) XIC(Pulse.5) MAM(M25,M25_POS_02,0,Pos_02_M25.Position,Pos_02_M25.Speed,Units per sec,Pos_02_M25.Accel,% of Maximum,Pos_02_M25.Decel,% of Maximum,S-Curve,Pos_02_M25.Accel_Jerk,Pos_02_M25.Decel_Jerk,% of Time,Enabled,Programmed,0,None,0,0) ,XIO(BIT[15].1) XIO(Gear_Vertical_Axe.IP) MAG(M25,M7,Gear_Vertical_Axe,0,Gear_Vertical_Axe_Ratio,0,0,Command,Real,Enabled,Gear_Vertical_Axe_Accel,% of Maximum) ];]]>
</Text>
</Rung>
