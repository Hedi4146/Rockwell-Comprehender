<Routine Name="R025_Frontal_Tape" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
M11 - DRIVE ROLL FRONTAL TAPE
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
ENABLE and SPEED MOTOR MANAGEMENT
(sono evidenziati i parametri fondamentali da impostare e che precedentemente erano in INIT)
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
SELECTION of DRIVE RUNNING DIRECTION
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[AHT_Enable_DriveAxis(EDA_M11,StartMotors,MachineMoving,OFF,HMI_Enable_M11) ,MOV(HMI_M11_RollDiameter,M11Data.Input.AxPar.HmiRollDiameter) MOV(HMI_M11_AccRate,M11Data.Motion.HmiGearAccelRate) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[OTU(M11Data.Input.Dancer.HmiEnable) ,AHT_DriveRoll_withoutDancer(DB_M11,EDA_M11.Enable_Cond,Out_Glue_Continuos.5,ResetAlarm,M11,Vmaster1,Axis.GroupSynced,M11Data) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
M8 - FRONTAL TAPE UNIT
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
ENABLE and SPEED MOTOR MANAGEMENT
(sono evidenziati i parametri fondamentali da impostare e che precedentemente erano in INIT)
(NOTA - nel caso il gruppo facesse due pezzi per giro encoder, mettere 2 nel HMIRollDiameter)
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[[AHT_Enable_DriveAxis(EDA_M8,StartMotors,MachineMoving,OFF,HMI_Enable_M8) ,MOV(1,M8Data.Input.AxPar.HmiRollDiameter) ,XIO(BIT[7].12) XIC(Clock_100ms) [[XIC(HMI_M8_PhaseForward_Button) ,XIC(Input_SEL_PhaseFOR_M8) ,XIC(Phaser_ON.8) XIC(HMI_Main_PhaserFORW) ] OTE(M8Data.Motion.PhaseForwardCommand) ,[XIC(HMI_M8_PhaseBack_Button) ,XIC(Input_SEL_PhaseREV_M8) ,XIC(Phaser_ON.8) XIC(HMI_Main_PhaserREV) ] OTE(M8Data.Motion.PhaseBackwardCommand) ] ,[XIC(M8Data.Motion.PhaseForwardCommand) ,XIC(M8Data.Motion.PhaseBackwardCommand) ] TOF(Timer_M8_MemPosition,?,?) ,MOV(HMI_M8_StepPhaser,M8Data.Motion.HmiManualPhaserStep) MOV(HMI_M8_SpeedPhaser,M8Data.Motion.HmiManualPhaserVelocity) MOV(HMI_M8_AccRate,M8Data.Motion.HmiGearAccelRate) ,AHT_SyncroAxis(DB_M8,EDA_M8.Enable_Cond,Start_Machine,ResetAlarm,M8,Vmaster1,Axis.GroupSynced,M8Data) ,XIC(MachineStill) [XIC(DB_M8.AxEnabled) XIC(HMI_Move_Belta_Button) XIC(Phaser_ON.8) MAM(M8,MAM_M8_DELTA,1,Delta_to_Move_M8,100,Units per sec,500,Units per sec2,500,Units per sec2,Trapezoidal,500,500,Units per sec3,Disabled,Programmed,0,None,0,0) ,XIC(MAM_M8_DELTA.ER) XIC(HmiResetAlarm) CLR(MAM_M8_DELTA.FLAGS) ] ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Cam" TestEdits="false" MainRoutineName="CamSwitch" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="CamSwitch" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[[NEQ(HmiProductLength,NewProductLength) ,XIO(Enable_Virtual_Axis) ONS(ONS.13) ,XIC(Time_Change_Size.EN) ] XIO(Time_Change_Size.DN) [TON(Time_Change_Size,?,?) MOV(HmiProductLength,NewProductLength) ,XIC(Pulse.2) MUL(HmiProductLength,1000,Glue_Lenght) SSV(Axis,GlueAxis,PositionUnwind,Glue_Lenght) MOV(HmiProductLength,Cam_End_Pos) ] ,XIO(MachineStill) XIO(Time_Change_Size.EN) GSV(Axis,GlueAxis,PositionUnwind,Glue_Lenght_Actual) NEQ(Glue_Lenght_Actual,Glue_Lenght) SSV(Axis,GlueAxis,PositionUnwind,Glue_Lenght) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(ResetAlarm) [XIC(Axis.GroupSynced) ,XIC(servo_off_mtto) ] [XIO(GlueCamSwitchControl.IP) XIO(GlueCamSwitchControlOff.ER) MAOC(GlueAxis,0,GlueCamSwitchControl,Local:4:O.Data,GlueGunEnable,GlueCamSwitch[0],0,Cam_End_Pos,GlueCompensation[0],Continuous,Forward Only,0.0,0.0,Actual) ,XIO(GlueCamSwitchControl2.IP) XIO(GlueCamSwitchControlOff2.ER) MAOC(GlueAxis,1,GlueCamSwitchControl2,Local:5:O.Data,GlueGunEnable2,GlueCamSwitch2[0],0,Cam_End_Pos,GlueCompensation2[0],Continuous,Bi-Directional,0,0,Actual) ] ,XIC(MachineStill) [XIC(GlueCamSwitchControl.ER) ,XIC(GlueCamSwitchControl2.ER) ,XIC(ResetAlarm) ,XIC(HmiEnableSimulation) ,XIC(S:FS) ] MDOC(GlueAxis,0,GlueCamSwitchControlOff,All) MDOC(GlueAxis,1,GlueCamSwitchControlOff2,All) ,[XIC(NODE_Z1:5:I.1) ,XIC(Pulso_Cyclo_Manual.TT) ] XIO(Pulso_Cyclo_Manual.DN) TON(Pulso_Cyclo_Manual,?,?) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[LIM(0,Master.ActualPosition,180) OTE(Master_cam_Pulser) ,LIM(0,M5.ActualPosition,180) OTE(M5_cam_Pulser) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(NODE_Z1:8:I.6) XIO(Folding_Cam_Enable) ,XIC(M5_cam_Pulser) XIC(Folding_Cam_Enable) ]OTE(Cull_Shift_Time);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[
*******************************************************
Diapers Presence Warning Horn-Light **
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[GEQ(Master.AverageVelocity,200) XIO(MachineStill) ,XIC(BIT[8].8) ][[XIC(NODE_Z1:7:I.3) TON(TON[27],?,?) ,XIC(BIT[6].1) XIO(NODE_Z1:8:I.7) TON(TON_STCKR_DR,?,?) ] ,[[[XIC(NODE_Z1:7:I.3) XIC(TON[27].DN) ,XIO(NODE_Z1:8:I.7) XIC(TON_STCKR_DR.DN) ] ,XIC(O01011) ] XIO(TON[26].DN) ,XIC(Pulse.0) XIC(BIT[8].4) ,XIC(BIT[8].8) ] [OTE(O01011) ,OTE(Stacker_OutPut.CR_warning_counter_diapers) ] ,XIC(O01011) TON(TON[26],?,?) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
