<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(HMI_Do_MAJ_Clutch)[XIC(Input_Switch) MOV(0,Wrk_MAJDirection) TON(Switch_ON_T,?,?) ,XIO(Input_Switch) MOV(1,Wrk_MAJDirection) TON(Switch_OFF_T,?,?) ];]]>
