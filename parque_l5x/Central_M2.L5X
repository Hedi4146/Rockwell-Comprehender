<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Enable_Stacker)XIO(Emergency_Stacker)OTL(EnableStacker);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(Enable_Stacker) ,XIC(Emergency_Stacker) ]OTU(EnableStacker);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[Servo_Manager_1(ServoManager,PhysicalAx,1,ResetAlarm,EnableStacker,MotionReady);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(FTC_Start_Stacker)OTE(StartStacker);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(FTC_Start_Stacker)ONS(Aux1)XIC(EnableStacker)XIO(EnableStacker)XIC(Stacker_Aut_Mode)OTL(StartStacker);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(FTC_PreControl)ONS(Aux2)XIC(EnableStacker)XIO(EnableStacker)XIC(Stacker_Aut_Mode)TOF(TOF_Start_Stacker,?,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(EnableStacker)XIC(EnableStacker)[XIO(FTC_Stop_Stacker) XIC(FTC_Stop_Stacker) ,XIO(FTC_Start_Stacker) ]ONS(Aux3)OTE(FdS_StopStacker);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(EnableStacker)XIC(EnableStacker)[XIC(FdS_StopStacker) [XIO(EnablePreControl) ,XIC(EnablePreControl) XIO(TOF_Start_Stacker.DN) ] ,XIO(EnableStacker) ,XIO(Stacker_Aut_Mode) ]OTU(StartStacker);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(EnableStacker)XIC(Stacker_Aut_Mode)[XIC(StartStacker) MAG(PhysicalAx,Master,GEARstacker,0,Gear_Ratio,0,0,Command,Real,Enabled,90,% of Maximum) ,XIO(StartStacker) MAS(PhysicalAx,MAS,3,No,90,% of Maximum,No,10000,% of Maximum) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(MotionReady)XIO(Stacker_Aut_Mode)[XIC(StartManualStacker) NEQ(ManualSpeedChain,manualSpeedChain_new) [MAJ(PhysicalAx,MAJ,0,ManualSpeedChain,Units per sec,100,Units per sec2,100,Units per sec2,Trapezoidal,100,100,% of Maximum,Enabled,Programmed,0,None) ,MOV(ManualSpeedChain,manualSpeedChain_new) ] ,XIO(StartManualStacker) MAS(PhysicalAx,MASJ,1,No,1000,Units per sec2,No,10000,% of Maximum) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(ResetAlarm)[XIC(MAJ.ER) CLR(MAJ.FLAGS) ,XIC(GEARstacker.ER) CLR(GEARstacker.FLAGS) ,XIC(MAS.ER) CLR(MAS.FLAGS) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
