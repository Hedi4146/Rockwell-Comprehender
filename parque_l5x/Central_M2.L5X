</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[[XIC(Glue_Gun_Manual.23) ,XIC(IO2:4:O.3) ][XIC(Motor_Glue_Enable_HMI.23) ,XIC(ON) ]OTE(Out_Motor_Glue_Enable.23);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(MachineMoving)GEQ(machineSpeed_DINT,0)TON(Start_Glue,?,?);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[[LES(Start_Glue.ACC,10000) MOV(Starting_Glue,K_Ref_Glue) ,GRT(Start_Glue.ACC,10000) MOV(Running_Glue,K_Ref_Glue) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[[XIC(MachineMoving) XIO(HmiEnableSimulation) GEQ(machineSpeed_DINT,50) CPT(GlueSpeedReference,32600*machineSpeed_DINT/MachineHighSpeedLimit*K_Ref_Glue) ,AFI() XIO(MachineMoving) NEQ(Glue_Gun_Manual,0) CPT(GlueSpeedReference,32600*HMI_MachineSpeed_ManualGlue/MachineHighSpeedLimit) ,[EQU(Glue_Gun_Manual,0) LEQ(machineSpeed_DINT,0) ,XIC(HmiEnableSimulation) ] MOV(0,GlueSpeedReference) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[MOV(500,MachineHighSpeedLimit)MOV(GlueSpeedReference,Glue_Rack_3:6:O.Ch0OutputData);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[XIC(HmiEnableSimulation)MOV(0,Out_Motor_Glue_Enable)MOV(0,Out_Glue_Continuos);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="R103_IN_Interface_Glue" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[****************************************************************************************************************
