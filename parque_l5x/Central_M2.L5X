<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Group_Sinced)XIO(Axis.SERCOSRingFault)XIO(Axis.PhysicalAxisFault)XIO(Axis.ModuleFault)XIO(Axis.ConfigFault)XIC(Axis.BusReadyStatus)OTE(Axis_Ready);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Axis_Ready)XIC(Enable_Axis)XIO(Axis.ServoActionStatus)MSO(Axis,Servo_On);]]>
