<Rung Number="3" Type="N">
<Text>
<![CDATA[FB_Tension_Servo_new(PE_TENSION,S06N114_DANCER_POLY,sm3_date.VLN,sm3_date.VLP,PE_TLN,PE_TLP,PE_Dancer_spd,sm3_date.Accel,sm3_date.Decal,sm3_date.MAJ_EN,sm3_date.Cmd_home,PE_Cmd_confirm,S06N114_DANCER_POLY.ServoActionStatus,sm3_date.input_switch,Cmd_Reset);]]>
