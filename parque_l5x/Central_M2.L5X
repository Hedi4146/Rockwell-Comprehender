<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Kp_Reference" DataType="REAL" Radix="Float" ExternalAccess="None">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Rewind_Speed" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData>F4 01 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="500"/>
</DefaultData>
</LocalTag>
<LocalTag Name="Diameter_Min" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(Cmd_Press_ON) ,XIC(HMI_Diameter_Enter) TON(Diameter_Enter_Timer,?,?) XIC(Diameter_Enter_Timer.DN) ][MOV(HMI_Start_Diameter,Dia_Actual) ,MOV(HMI_Start_Diameter,Diameter_Avg) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Machine_Running)XIC(Cmd_Enable)XIO(Rewind_Actived)[GRT(Web_Speed,0) TON(Calc_Diameter_Timer,?,?) ,XIC(Calc_Diameter_Timer.DN) OTE(Enable_Calc_Diameter) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Enable_Calc_Diameter)[CPT(Dia_Actual,Web_Speed/RPM_Feed_Back/3.14159) ,GRT(Dia_Actual,Diameter_Avg) ADD(Diameter_Avg,Kp_Diameter,Diameter_Avg) ,LES(Dia_Actual,Diameter_Avg) SUB(Diameter_Avg,Kp_Diameter,Diameter_Avg) ,GRT(Diameter_Avg,H_Lim_Diameter_Avg) MOV(H_Lim_Diameter_Avg,Diameter_Avg) ,LES(Diameter_Avg,L_Lim_Diameter_Avg) MOV(L_Lim_Diameter_Avg,Diameter_Avg) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Enable_Calc_Diameter)CPT(Reference_Avg,Web_Speed/(3.14159*Diameter_Avg));]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[GEQ(Diameter_Avg,Diameter_Min) MOV(L_Lim_Dancer_Gain,Gain_Dancer) ,LES(Diameter_Avg,Diameter_Min) MOV(H_Lim_Dancer_Gain,Gain_Dancer) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[CPT(Dancer_Error,(Dancer_Actual_Position-Dancer_SP)*Gain_Dancer)MOV(Diameter_Avg,Diameter_Actual);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Enable_Calc_Diameter)[CPT(RPM_Reference,Reference_Avg+Dancer_Error) ,GEQ(RPM_Reference,900) MOV(900,RPM_Reference) ,LES(RPM_Reference,0) MOV(0,RPM_Reference) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(Enable_Calc_Diameter) XIO(Rewind_Actived) MUL(RPM_Reference,Kp_Reference,PF_525_FreqCommand) ,XIO(Enable_Calc_Diameter) XIO(Rewind_Actived) MOV(0,PF_525_FreqCommand) ,XIO(Enable_Calc_Diameter) XIC(Rewind_Actived) MOV(Rewind_Speed,PF_525_FreqCommand) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
