<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(HMI_Cmd_Home_Delay.DN)OTU(Sts_Homed)[MAH(Ref_ServoAxis,Wrk_MI_Home) ,XIC(Wrk_MI_Home.DN) OTL(Sts_Homed) ];]]>
