<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Cmd_Enable)[EQU(Ref_Axis_CD.AxisFault,0) XIO(Ref_Axis_CD.ServoActionStatus) XIO(Ref_Axis_CD.DriveEnableStatus) XIO(Cmd_Disable) XIO(Sts_ER) MSO(Ref_Axis_CD,Wrk_MI_Enable) ,XIC(Ref_Axis_CD.ServoActionStatus) OTE(Sts_EnableDone) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Cmd_Disable)[MSF(Ref_Axis_CD,Wrk_MI_Disable) ,[XIC(Wrk_MI_Disable.DN) ,XIC(Wrk_MI_Disable.ER) ] XIO(Ref_Axis_CD.ServoActionStatus) OTE(Sts_DisableDone) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Cmd_FaultReset)[XIC(Sts_ER) MAFR(Ref_Axis_CD,Wrk_MI_FaultReset) ,XIC(Ref_Axis_CD.ShutdownStatus) MASR(Ref_Axis_CD,Wrk_MI_FaultReset_SR) ]CLR(MC_MAS.FLAGS)CLR(Wrk_MI_Disable.FLAGS)CLR(Wrk_MI_Enable.FLAGS);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Cmd_Stop)XIC(Wrk_MI_Enable.DN)MAS(Ref_Axis_CD,MC_MAS,All,No,0,Units per sec2,0,0,Units per sec3);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[NEQ(Ref_Axis_CD.AxisFault,0) ,NEQ(Ref_Axis_CD.ModuleFaults,0) ,NEQ(Ref_Axis_CD.GuardFaults,0) ,XIC(MC_MAS.ER) ,XIC(Wrk_MI_Disable.ER) ,XIC(Wrk_MI_Enable.ER) ]OTE(Sts_ER);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(Sts_ER)XIC(Inp_MotionGroup.GroupSynced)XIO(Ref_Axis_CD.SERCOSRingFault)XIO(Ref_Axis_CD.ModuleFault)XIO(Ref_Axis_CD.ShutdownStatus)OTE(Sts_AxisOk);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Ref_Axis_CD.BusReadyStatus)OTE(Sts_DCBusUpStatus);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Ref_Axis_CD.ServoActionStatus)OTE(Sts_ServoActionStatus);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Ref_Axis_CD.DriveEnableStatus)OTE(Sts_DriveEnableStatus);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
