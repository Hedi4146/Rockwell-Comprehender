<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(cmd_left)XIC(cmd_right)[OTU(bool1.15) ,OTU(bool1.16) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(cmd_left) ,XIC(cmd_right) ]TON(timer10,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIO(bool1.15)XIO(bool1.16)XIC(timer10.DN)ONS(ons.8)[XIC(cmd_left) OTL(bool1.15) ,XIC(cmd_right) OTL(bool1.16) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[GEQ(change_dia,left_present_dia) XIC(bool1.15) ,GEQ(change_dia,right_present_dia) XIC(bool1.16) ]XIC(running)OTE(final);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[GEQ(200,left_present_dia) XIC(bool1.15) XIO(bool1.4) ,GEQ(200,right_present_dia) XIC(bool1.16) XIO(bool1.6) ]XIC(running)OTE(ready_slow);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(auto_manual)XIO(bool1.17)XIC(running)[XIC(bool1.15) GEQ(change_dia,left_present_dia) OTL(bool1.1) ,XIC(bool1.16) GEQ(change_dia,right_present_dia) OTL(bool1.2) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(pulse)[XIC(bool1.1) ADD(word62,1,word62) ,XIC(bool1.2) ADD(word63,1,word63) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(bool1.16)XIC(cmd_ready)ONS(ons.1)OTE(bool1.3);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(bool1.3)OTL(bool1.4);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(bool1.4) ,XIC(left_dia_enter) ][TON(timer60,?,?) ,MUL(left_first_dia,left_first_dia,word100) ,MUL(word100,3.14159,word102) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(bool1.4) ,XIC(left_dia_enter) ][MOV(0,left_counterREAL) ,MOV(0,word112) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(timer60.DN)XIC(bool1.3)OTU(bool1.4);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(bool1.4) XIC(Iutput_Blink1) ,XIC(bool1.15) ]OTE(left_lamp);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(bool1.15)XIC(cmd_ready)ONS(ons.2)OTE(bool1.5);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(bool1.5)OTL(bool1.6);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[XIC(bool1.6) ,XIC(right_dia_enter) ][TON(timer61,?,?) ,MUL(right_first_dia,right_first_dia,word104) ,MUL(word104,3.14159,word106) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[XIC(bool1.6) ,XIC(right_dia_enter) ][MOV(0,right_counterREAL) ,MOV(0,word114) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(timer61.DN)XIC(bool1.5)OTU(bool1.6);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[XIC(bool1.6) XIC(Iutput_Blink1) ,XIC(bool1.16) ]OTE(right_lamp);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[[GEQ(word62,left_splice_delay) ,XIC(cmd_right) ]XIC(bool1.6)[OTL(bool1.7) ,OTU(bool1.1) ,MOV(0,word62) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[GEQ(word63,right_splice_delay) ,XIC(cmd_left) ]XIC(bool1.4)[OTL(bool1.8) ,OTU(bool1.2) ,MOV(0,word63) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[[XIC(bool1.7) ,XIC(bool1.8) ][TON(timer62,?,?) ,OTE(bool1.17) ,[XIC(timer62.DN) ,XIC(bool1.9) ,XIC(bool1.10) ] TON(timer63,?,?) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(bool1.17)ONS(ons.3)[XIC(bool1.15) OTL(bool1.13) ,XIC(bool1.16) OTL(bool1.14) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIO(bool1.17)MOV(torque,torque_output);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(bool1.17)DIV(torque,-1,torque_output);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[GEQ(timer63.ACC,20)[XIC(bool1.7) OTU(bool1.15) ,XIC(bool1.8) OTU(bool1.16) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIC(bool1.4)OTE(left_press);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIC(bool1.6)OTE(right_press);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[GEQ(timer63.ACC,100)[XIC(bool1.7) OTL(left_cutter) ,XIC(bool1.8) OTL(right_cutter) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[GEQ(timer63.ACC,300)[OTU(bool1.4) ,OTU(bool1.6) ];]]>
