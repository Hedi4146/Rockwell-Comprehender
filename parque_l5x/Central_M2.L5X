<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[LIM(90,M7.ActualPosition,180) OTL(bitcontar) ,LIM(190,M7.ActualPosition,225) OTU(bitcontar) ,LIM(250,M2.ActualPosition,70) OTE(bit_Gemco_M2) ];]]>
</Text>
