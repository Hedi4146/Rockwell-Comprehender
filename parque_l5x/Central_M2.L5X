<Rung Number="20" Type="N">
<Comment>
<![CDATA[
*******************************************************
Alarm Manager
*******************************************************]]>
</Comment>
<Text>
<![CDATA[[XIC(ServoManager_M20.ER) ,XIC(M20_POS_01.ER) ,XIC(M20_POS_02.ER) ,XIC(M20_POS_03.ER) ,XIC(Servo_Home_M20.ER) ]OTE(M20_Status.Alarm_Present);]]>
