<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[Servo_Manager_1(Data.Motion.ServoManager,PhysicalAx,GroupSincro,ResetAxAlarm,AxEnable,AxEnabled);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)GEQ(VMaster.ActualVelocity,0)NEQ(Data.Motion.HmiGearAccelRate,0)[XIO(PhysicalAx.GearingStatus) ,NEQ(Data.Input.AxPar.ProductLength,LocProductLength) ]CPT(Data.Motion.GearRatio,Data.Input.AxPar.ProductLength/(3.14159*Data.Input.AxPar.HmiRollDiameter))CPT(LocGearAccelRate,Data.Motion.HmiGearAccelRate)[MAG(PhysicalAx,VMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,Data.Motion.GearRatio,Data.Motion.GearSlaveCounts,360,Command,Real,Enabled,LocGearAccelRate,Units per sec2) ,MOV(Data.Input.AxPar.ProductLength,LocProductLength) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIO(AxEnabled) ONS(LocAux2) ,XIO(AxStart) ONS(LocAux1) ][XIC(PhysicalAx.JogStatus) ,XIC(PhysicalAx.GearingStatus) LES(VMaster.ActualVelocity,1) ,XIC(PhysicalAx.HomingStatus) ,XIC(PhysicalAx.MoveStatus) ]MAS(PhysicalAx,Data.Motion.Stop,All,No,LocGearDecelRate,Units per sec2,No,100,% of Maximum);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(AxStart)ONS(LocAux12)XIC(PhysicalAx.GearingStatus)GRT(VMaster.ActualVelocity,1)CPT(LocGearDecelRate,Data.Motion.HmiGearAccelRate)MAS(PhysicalAx,Data.Motion.Stop,All,Yes,LocGearDecelRate,Units per sec2,Yes,10,% of Maximum);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(PhysicalAx.GearingLockStatus)OTE(AxSyncro);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(PhysicalAx.AxisHomedStatus)OTE(AxHomed);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(AxEnabled)ONS(aux5)[CLR(Data.Motion.Stop.FLAGS) ,CLR(Data.Motion.Gear.FLAGS) ,CLR(IstFaultCode) ,CLR(DriveFaultCode) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(Data.Motion.Stop.ER) MOV(Data.Motion.Stop.ERR,IstFaultCode) ,XIC(Data.Motion.Gear.ER) MOV(Data.Motion.Gear.ERR,IstFaultCode) ,XIC(Data.Motion.ServoManager.ER) MOV(Data.Motion.ServoManager.IstError,IstFaultCode) ]OTE(Er);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(ResetAxAlarm) ,XIC(PhysicalAx.InhibitStatus) ][XIC(Data.Motion.Stop.ER) CLR(Data.Motion.Stop.FLAGS) ,XIC(Data.Motion.Gear.ER) CLR(Data.Motion.Gear.FLAGS) ,CLR(IstFaultCode) ,CLR(DriveFaultCode) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(PhysicalAx.InhibitStatus)[XIC(PhysicalAx.AxisFault.0) ,XIC(PhysicalAx.AxisFault.1) ,XIC(PhysicalAx.AxisFault.2) ][OTE(AxFault) ,MOV(PhysicalAx.DriveFault,DriveFaultCode) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
