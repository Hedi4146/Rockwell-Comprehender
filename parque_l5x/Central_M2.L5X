<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(MAG_Gear_On)[[XIO(AxEnabled) ONS(LocAux2) ,XIO(AxStart) ONS(LocAux1) ] [XIC(PhysicalAx.JogStatus) ,XIC(PhysicalAx.GearingStatus) LES(VMaster.ActualVelocity,1) ,XIC(PhysicalAx.HomingStatus) ,XIC(PhysicalAx.MoveStatus) ] [MAS(PhysicalAx,Data.Motion.Stop,All,No,90,% of Maximum,No,100,% of Maximum) ,OTU(Data.Motion.GearAbsoluteAxPhasing) ] ,XIO(AxStart) ONS(LocAux12) XIC(PhysicalAx.GearingStatus) GRT(VMaster.ActualVelocity,1) CPT(LocGearDecelRate,Data.Motion.HmiGearAccelRate) [MAS(PhysicalAx,Data.Motion.Stop,All,Yes,LocGearDecelRate,Units per sec2,Yes,10,% of Maximum) ,OTU(Data.Motion.GearAbsoluteAxPhasing) ] ];]]>
