<Rung Number="27" Type="N">
<Text>
<![CDATA[MOV(1,LocRewAxA);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(Data.OutputSplice.RewindA)XIC(Data.AxAEnabled)XIC(LocAxAStopped)ONS(LocAux5)MAJ(AxA,LocJogRewA,LocRewAxA,100,Units per sec,500,Units per sec2,500,Units per sec2,Trapezoidal,100,100,% of Maximum,Enabled,Programmed,0,None);]]>
