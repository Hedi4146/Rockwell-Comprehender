<Rung Number="32" Type="N">
<Text>
<![CDATA[XIO(Data.OutputSplice.StartA)XIO(Data.OutputSplice.RewindA)XIO(AxA.StoppingStatus)XIO(LocAxAStopped)[CPT(LocGearDcelRate,AxA.AverageVelocity/Data.HmiGearDecRate) ,LES(LocGearDcelRate,1) MOV(500,LocGearDcelRate) ,MAS(AxA,LocMasA,All,Yes,80,% of Maximum,Yes,100,% of Maximum) ];]]>
