</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(TimerSpliceEnd.DN)[OTU(EVSpliceA) ,OTU(EVSpliceB) ,OTU(MemManSplice) ,XIC(Loc_SplicePreparedA) [OTL(StartA) ,OTL(RewindB) ,OTU(StartForSplice) ] ,XIC(Loc_SplicePreparedB) [OTL(StartB) ,OTL(RewindA) ,OTU(StartForSplice) ] ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(RewindEndA) ,XIO(Enable) ]OTU(RewindA);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[XIC(RewindEndB) ,XIO(Enable) ]OTU(RewindB);]]>
