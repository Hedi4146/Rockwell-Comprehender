</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(ShieldCloserd)XIC(ReadyforSplice)[XIO(MemManSplice) XIC(OkForSplice) ,XIC(MemManSplice) XIO(PBManualSplice) ]XIC(AxAStopped)XIC(AxBStopped)ONS(Locaux3)[XIC(Loc_SplicePreparedA) [OTL(EVSpliceB) ,XIC(KnifeBBackwardward) [OTL(EVKnifeBForward) ,OTU(EVKnifeBBackward) ] ,XIC(KnifeBForward) [OTL(EVKnifeBBackward) ,OTU(EVKnifeBForward) ] ] ,XIC(Loc_SplicePreparedB) [OTL(EVSpliceA) ,XIC(KnifeABackwardward) [OTL(EVKnifeAForward) ,OTU(EVKnifeABackward) ] ,XIC(KnifeAForward) [OTL(EVKnifeABackward) ,OTU(EVKnifeAForward) ] ] ];]]>
