<Routine Name="Alarm" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(HmiResetAlarm) ,XIC(ResetAlarmSignal) ,XIC(CPU_Run) ONS(Aux70) ,XIC(PowerOK) ONS(Aux71) ][OTE(ResetAlarm) ,CLR(Alarm0) ,CLR(Alarm1) ,CLR(Alarm2) ,CLR(Alarm3) ,CLR(Warning0) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(ON)[NEQ(Alarm0,0) ,NEQ(Alarm1,0) ,NEQ(Alarm2,0) ,NEQ(Alarm3,0) ][OTE(AlarmPresence) ,OTE(O01010) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(OFF)XIO(to_Remove)OTE(By_Pass_Alarm);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(PowerOK)TON(TONA,?,?)XIC(TONA.DN)OTL(Alarm0.0)JMP(step100);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(By_Pass_Alarm)XIC(StartMotors)XIC(OFF)OTL(Alarm0.3);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(By_Pass_Alarm)XIC(StartMotors)XIC(OFF)OTL(Alarm0.4);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(By_Pass_Alarm)XIC(StartMotors)XIC(OFF)OTL(Alarm0.5);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(PowerOK)XIO(I01016)OTL(Alarm0.6);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(By_Pass_Alarm)XIC(PowerOK)XIC(OFF)OTL(Alarm0.7);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(I01013)TON(TON1[0],?,?);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIO(I01014)TON(TON1[1],?,?);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIO(I01015)TON(TON1[2],?,?);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIO(HmiDryRun) ,XIC(ON) ]XIC(MachineMoving)[XIC(TON1[0].DN) OTL(Alarm0.10) ,XIC(TON1[2].DN) OTL(Alarm0.11) ,XIC(TON1[1].DN) OTL(Alarm0.12) ,XIO(I01017) OTL(Alarm0.13) ,XIO(I01012) TON(TON2,?,?) XIC(TON2.DN) OTL(Alarm0.14) ,XIC(OFF) OTL(Alarm0.15) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIO(OFF)AHT_RackAxisFault(Rack1_AxisFault,UNW_TAPE.AxFault,OFF,DB_M3.AxFault,DB_M4.AxFault,OFF,OFF,OFF,OFF,By_Pass_Alarm)XIC(Rack1_AxisFault.RackFault)OTE(AXIS_Fault);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(OFF)[AHT_MotionAxisError(MAE_M4,DB_M4.Er,OFF,OFF,By_Pass_Alarm) XIC(MAE_M4.MotionError) ,AHT_MotionAxisError(MAE_M3,DB_M3.Er,OFF,OFF,By_Pass_Alarm) XIC(MAE_M3.MotionError) ,AHT_MotionAxisError(MAE_UNW_TAPE,UNW_TAPE.ER,OFF,OFF,By_Pass_Alarm) XIC(MAE_UNW_TAPE.MotionError) ]OTE(AXIS_MotionFault);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIO(OFF)NEQ(HMI_FaultCode_Master,32)[OTL(Alarm1.0) ,OTE(HMI_EncoderFault) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIO(OFF)[XIC(AXIS_Fault) ,XIC(AXIS_MotionFault) ]OTE(Alarm1.1);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIO(By_Pass_Alarm)[XIC(UNW_TAPE.AxFault) ,XIC(MAE_UNW_TAPE.MotionError) XIC(OFF) ]OTL(Alarm1.2);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(OFF)OTL(Alarm1.3);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIO(By_Pass_Alarm)[XIC(DB_M3.AxFault) ,XIC(MAE_M3.MotionError) XIC(OFF) ]OTL(Alarm1.4);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIO(By_Pass_Alarm)[XIC(DB_M4.AxFault) ,XIC(MAE_M4.MotionError) XIC(OFF) ]OTL(Alarm1.5);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[LBL(step100)XIO(OFF)[NEQ(LedStatCpu,3) OTL(Alarm2.0) ,EQU(LedStatCpu,3) OTE(CPU_Run) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIO(OFF)AHT_RackSercosFault(Rack1_SF,By_Pass_Alarm,M1.SERCOSRingFault,M2.SERCOSRingFault,M3.SERCOSRingFault,M4.SERCOSRingFault,OFF,OFF,OFF,OFF)[XIC(Rack1_SF.SercosFault) OTL(Alarm2.1) ,XIO(Rack1_SF.SercosFault) OTE(SERCOS_Ready) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(OFF)[XIO(NodeZ1_OK) OTL(Alarm2.2) ,XIC(NodeZ1_OK) OTE(IO_Ready) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIO(PowerOK)JMP(end);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(OFF)OTE(Warning0.0);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIC(OFF)OTL(Warning0.7);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[[GSV(Axis,M1,DriveFaultBits,DriveFaultBits_M1) ,GSV(Axis,M2,DriveFaultBits,DriveFaultBits_M2) ,GSV(Axis,M3,DriveFaultBits,DriveFaultBits_M3) ,GSV(Axis,M4,DriveFaultBits,DriveFaultBits_M4) ,GSV(Axis,Master,DriveFaultBits,DriveFaultBits_Master) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[AHT_DriveFaultBit_Decoding(DFD_M1,DriveFaultBits_M1,HMI_FaultCode_M1);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[AHT_DriveFaultBit_Decoding(DFD_M2,DriveFaultBits_M2,HMI_FaultCode_M2);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[AHT_DriveFaultBit_Decoding(DFD_M3,DriveFaultBits_M3,HMI_FaultCode_M3);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[AHT_DriveFaultBit_Decoding(DFD_M4,DriveFaultBits_M4,HMI_FaultCode_M4);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[AHT_DriveFaultBit_Decoding(DFD_Master,DriveFaultBits_Master,HMI_FaultCode_Master);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[MOV(DB_M3.IstFaultCode,HMI_MotionFaultCode_M3);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[MOV(DB_M4.IstFaultCode,HMI_MotionFaultCode_M4);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[MOV(UNW_TAPE.IstFaultCode,HMI_MotionFaultCode_UNW_TAPE);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[MOV(AB_Virtual1.IstFaultCode,HMI_MotionFaultCode_MASTER);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[LBL(end)OTE(aux100);]]>
</Text>
</Rung>
