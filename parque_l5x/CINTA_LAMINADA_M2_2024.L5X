<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIO(EnableSensorSplicer) ,XIC(EnableSensorSplicer) XIO(SensorPresenceRollB) ]LES(ReelRadiusB,MinRadus)[XIC(StartB) XIC(Loc_SplicePreparedA) OTL(StartCounterB) ,OTE(LocMustBeSpliceB) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(StartA)XIO(RewindA)XIC(StartCounterA)[LIM(0,AxA_ActualPosition,20) ONS(aux20) ,LIM(90,AxA_ActualPosition,110) ONS(aux21) ,LIM(180,AxA_ActualPosition,200) ONS(aux22) ,LIM(270,AxA_ActualPosition,290) ONS(aux23) ]LES(Counter_for_SpliceA,HMI_TuneCounter_SpliceA)ADD(Counter_for_SpliceA,1,Counter_for_SpliceA);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(StartB)[CLR(Counter_for_SpliceA) ,OTU(StartCounterA) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(StartB)XIO(RewindB)XIC(StartCounterB)[LIM(0,AxB_ActualPosition,20) ONS(aux30) ,LIM(90,AxB_ActualPosition,110) ONS(aux31) ,LIM(180,AxB_ActualPosition,200) ONS(aux32) ,LIM(270,AxB_ActualPosition,290) ONS(aux33) ]LES(Counter_for_SpliceB,HMI_TuneCounter_SpliceB)ADD(Counter_for_SpliceB,1,Counter_for_SpliceB);]]>
