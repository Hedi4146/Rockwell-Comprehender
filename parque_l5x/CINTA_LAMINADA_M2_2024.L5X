</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(EN)XIO(EN)OTU(EVMandrelA)OTU(EVMandrelB)OTU(EVPrepareA)OTU(EVPrepareB)OTU(EVSpliceA)OTU(EVSpliceB)OTU(Loc_SplicePreparedA)OTU(Loc_SplicePreparedB)OTU(LocMemManSplice)OTU(LocMustBeSpliceA)OTU(LocMustBeSpliceB)OTU(ReadyforSplice)OTU(RewindA)OTU(RewindB)OTU(SplicePrepared)OTU(StartForSplice)OTU(EN);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[LBL(END)OTE(Locaux2);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTL(EN);]]>
