<Routines>
<Routine Name="Drive_Rolls" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(StartMachine)GRT(Vmaster1.AverageVelocity,2)OTE(start_M3);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[AHT_Enable_DriveAxis(EDA_M3,MotorRunning,MachineMoving,OFF,HMI_Enable_M3) ,DIV(AI_01040,100,dato5) SUB(100,dato5,M3Data.Input.Dancer.Position) ,AHT_DriveRoll_withDancer(DB_M3,EDA_M3.Enable_Cond,start_M3,ResetAlarm,M3,Vmaster1,Axis.GroupSynced,M3Data) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[AHT_Enable_DriveAxis(EDA_M4,MotorRunning,MachineMoving,OFF,HMI_Enable_M4) ,AHT_DriveRoll_withoutDancer(DB_M4,EDA_M4.Enable_Cond,StartMachine,ResetAlarm,M4,Vmaster1,Axis.GroupSynced,M4Data) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(ON)[XIO(HMI_ChangeDirection_M4) MOV(1,M4_Direction) ,XIC(HMI_ChangeDirection_M4) MOV(2,M4_Direction) ,SSV(Axis,M4,DrivePolarity,M4_Direction) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[JSR(Master,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Drive_Rolls,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(Unwinders,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Master" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(ON)XIO(StartVmaster)[XIO(HmiEnableSimulation) [MOV(4,Virtual1Data.Input.AxPar.HmiOpMode) ,MOV(0,Virtual1Data.Motion.HmiGearAccelRate) ] ,XIC(HmiEnableSimulation) [MOV(1,Virtual1Data.Input.AxPar.HmiOpMode) ,MOV(Percen_Of_Max_AccRate,Virtual1Data.Motion.HmiAccelRate) ,MOV(Percen_Of_Max_AccRate,Virtual1Data.Motion.HmiDecelRate) ] ,OTU(Virtual1Data.Motion.GearAbsoluteEnableAutoPhase) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(StartMachine)ONS(ONS.24)XIC(StartMotors)MOV(Vmaster1.ActualPosition,MemVMasterPosition);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(DelayGrupSynced2.DN)ONS(ONS.7)XIC(ON)MRP(Vmaster1,VirtualMRP,Absolute,Actual,Master.ActualPosition);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(ON)[XIC(HmiStartSimulation) ONS(aux55) XIC(HmiEnableSimulation) MOV(10,HmiSimulatedSpeed) ,XIC(HMI_SimulatedSpeedUP) XIC(Clock_Hz) ONS(aux52) XIO(HMI_SimulatedSpeedDOWN) ADD(HmiSimulatedSpeed,2,HmiSimulatedSpeed) ,XIC(HMI_SimulatedSpeedDOWN) XIC(Clock_Hz) ONS(aux53) XIO(HMI_SimulatedSpeedUP) SUB(HmiSimulatedSpeed,2,HmiSimulatedSpeed) ,[LES(HmiSimulatedSpeed,0) ,XIC(HmiEnableSimulation) XIO(HmiStartSimulation) ,XIC(AlarmPresence) ] MOV(0,HmiSimulatedSpeed) ,GEQ(HmiSimulatedSpeed,HMI_MaxSimulatedSpeed) MOV(HMI_MaxSimulatedSpeed,HmiSimulatedSpeed) ,XIC(AlarmPresence) [OTU(HmiStartSimulation) ,OTU(HmiStartMotor) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(StartVmaster)NEQ(HmiSimulatedSpeed,LocSimulatedSpeed)[MUL(HmiSimulatedSpeed,6,Virtual1Data.Motion.HmiJogSpeed) ,MOV(HmiSimulatedSpeed,LocSimulatedSpeed) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[VirtualAxisBlock(AB_Virtual1,EnableAxis,StartVmaster,ResetAlarm,Vmaster1,Master,Axis.GroupSynced,Virtual1Data);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[[LES(Vmaster1.AverageVelocity,5) MUL(Vmaster1.AverageVelocity,0,MachineSpeed_PPM) ,GEQ(Vmaster1.AverageVelocity,5) MOV(HMI_TapeLength,Tape_Length) CPT(MachineSpeed_PPM,Vmaster1.AverageVelocity*60/360*(Unwind_ProductLength/Tape_Length)) ] ,MOV(MachineSpeed_PPM,machineSpeed_DINT) ,MOV(Vmaster1.AverageVelocity,MachineAverageVelocity) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
