<Rung Number="11" Type="N">
<Text>
<![CDATA[AHT_CtcSplicer(AHT_CtcSplicer,AxEnable,ResetAxAlarm,Data.InputSplice.OkForSplice,Data.InputSplice.ShieldCloserd,Data.InputSplice.PbPrepare,Data.InputSplice.PBManualSplice,Data.InputSplice.RewindEndA,Data.InputSplice.RewindEndB,Data.AxAEnabled,Data.AxBEnabled,LocHmiMinRadius,Data.InputSplice.HmiTimeSpliceEnd,Data.ReelRadiusA,Data.ReelRadiusB,Data.OutputSplice.StartForSplice,Data.OutputSplice.EnableA,Data.OutputSplice.EnableB,Data.OutputSplice.StartA,Data.OutputSplice.StartB,Data.OutputSplice.SplicePrepared,Data.OutputSplice.EVPrepareA,Data.OutputSplice.EVPrepareB,Data.OutputSplice.EVSpliceA,Data.OutputSplice.EVSpliceB,Data.OutputSplice.EVMandrelA,Data.OutputSplice.EVMandrelB,Data.OutputSplice.RewindA,Data.OutputSplice.RewindB,LocAxAStopped,LocAxBStopped,Data.OutputSplice.ReadyForSplice,AxStart,Data.HmiEnableSensorForSplicer,Data.InputSplice.SensorPresenceRollA,Data.InputSplice.SensorPresenceRollB,AxA.ActualPosition,AxB.ActualPosition,HMI_CounterDelay_SpliceA,HMI_CounterDelay_SpliceB);]]>
