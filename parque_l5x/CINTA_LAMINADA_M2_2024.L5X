<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[Servo_Manager(Data.Motion.ServoManager,PhysicalAx,GroupSincro,ResetAxAlarm,AxEnable,AxEnabled);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)EQU(Data.Motion.HmiGearAccelRate,0)[XIO(PhysicalAx.GearingStatus) ,NEQ(Data.Input.AxPar.ProductLength,LocProductLength) ]CPT(Data.Motion.GearRatio,Data.Input.AxPar.ProductLength/(3.14159*Data.Input.AxPar.HmiRollDiameter))[MAG(PhysicalAx,VMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,Data.Motion.GearRatio,1,1,Command,Real,Disabled,10000,Units per sec2) ,MOV(Data.Input.AxPar.ProductLength,LocProductLength) ,OTE(aux01) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)GRT(VMaster.ActualVelocity,1)NEQ(Data.Motion.HmiGearAccelRate,0)[XIO(PhysicalAx.GearingStatus) ,NEQ(Data.Input.AxPar.ProductLength,LocProductLength) ]CPT(Data.Motion.GearRatio,Data.Input.AxPar.ProductLength/(3.14159*Data.Input.AxPar.HmiRollDiameter))CPT(LocGearAccelRate,(VMaster.ActualVelocity*Data.Motion.GearRatio)/Data.Motion.HmiGearAccelRate)[MAG(PhysicalAx,VMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,Data.Motion.GearRatio,1,1,Command,Real,Enabled,LocGearAccelRate,Units per sec2) ,MOV(Data.Input.AxPar.ProductLength,LocProductLength) ,OTE(aux02) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)LES(VMaster.ActualVelocity,1)NEQ(Data.Motion.HmiGearAccelRate,0)[XIO(PhysicalAx.GearingStatus) ,NEQ(Data.Input.AxPar.ProductLength,LocProductLength) ]CPT(Data.Motion.GearRatio,Data.Input.AxPar.ProductLength/(3.14159*Data.Input.AxPar.HmiRollDiameter))[MAG(PhysicalAx,VMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,Data.Motion.GearRatio,1,1,Command,Real,Disabled,LocGearAccelRate,Units per sec2) ,MOV(Data.Input.AxPar.ProductLength,LocProductLength) ,OTE(aux03) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[MUL(Data.Input.Dancer.HmiMaxCorrection,1,MaxCorrectionPositive)MUL(Data.Input.Dancer.HmiMaxCorrection,-1,MaxCorrectionNegative);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Data.Input.Dancer.HmiEnable)XIC(AxEnabled)XIC(AxStart)XIC(PhysicalAx.GearingLockStatus)[CPT(Data.Input.Dancer.SpeedCorrection,(Data.Input.Dancer.HmiSetpoint - Data.Input.Dancer.Position) * Data.Input.Dancer.HmiPgain) ,[GRT(Data.Input.Dancer.SpeedCorrection,MaxCorrectionPositive) MOV(MaxCorrectionPositive,Data.Input.Dancer.SpeedCorrection) ,LES(Data.Input.Dancer.SpeedCorrection,MaxCorrectionNegative) MOV(MaxCorrectionNegative,Data.Input.Dancer.SpeedCorrection) ,XIO(DancCorr.DN) TON(DancCorr,?,?) ,XIC(DancCorr.DN) MAJ(PhysicalAx,Data.Motion.JogDancer,0,Data.Input.Dancer.SpeedCorrection,Units per sec,10000,Units per sec2,10000,Units per sec2,Trapezoidal,100,100,% of Maximum,Disabled,Programmed,0,None) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIO(AxEnabled) ONS(LocAux2) ,XIO(AxStart) ONS(LocAux1) ][XIC(PhysicalAx.GearingStatus) LES(VMaster.ActualVelocity,1) ,XIC(PhysicalAx.HomingStatus) ,XIC(PhysicalAx.MoveStatus) ]MAS(PhysicalAx,Data.Motion.Stop,All,Yes,90,% of Maximum,No,100,% of Maximum);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(AxStart)ONS(LocAux12)XIC(PhysicalAx.GearingStatus)GRT(VMaster.ActualVelocity,1)CPT(LocGearDecelRate,(VMaster.ActualVelocity*Data.Motion.GearRatio)/Data.Motion.HmiGearAccelRate)MAS(PhysicalAx,Data.Motion.Stop,All,Yes,90,% of Maximum,No,100,% of Maximum);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(PhysicalAx.GearingLockStatus)OTE(AxSyncro);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(PhysicalAx.AxisHomedStatus)OTE(AxHomed);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIO(AxEnabled)ONS(aux5)[CLR(Data.Motion.JogDancer.FLAGS) ,CLR(Data.Motion.Stop.FLAGS) ,CLR(Data.Motion.Gear.FLAGS) ,CLR(IstFaultCode) ,CLR(DriveFaultCode) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(Data.Motion.Stop.ER) MOV(Data.Motion.Stop.ERR,IstFaultCode) ,XIC(Data.Motion.Gear.ER) MOV(Data.Motion.Gear.ERR,IstFaultCode) ,XIC(Data.Motion.JogDancer.ER) MOV(Data.Motion.JogDancer.ERR,IstFaultCode) ,XIC(Data.Motion.ServoManager.ER) MOV(Data.Motion.ServoManager.IstError,IstFaultCode) ]OTE(Er);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(ResetAxAlarm) ,XIC(PhysicalAx.InhibitStatus) ][XIC(Data.Motion.JogDancer.ER) CLR(Data.Motion.JogDancer.FLAGS) ,XIC(Data.Motion.Stop.ER) CLR(Data.Motion.Stop.FLAGS) ,XIC(Data.Motion.Gear.ER) CLR(Data.Motion.Gear.FLAGS) ,CLR(IstFaultCode) ,CLR(DriveFaultCode) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIO(PhysicalAx.InhibitStatus)[XIC(PhysicalAx.AxisFault.0) ,XIC(PhysicalAx.AxisFault.1) ,XIC(PhysicalAx.AxisFault.2) ][OTE(AxFault) ,MOV(PhysicalAx.DriveFault,DriveFaultCode) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
