<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(AxEnable)XIC(GroupSincro)XIO(VirtualAx.PhysicalAxisFault)XIO(VirtualAx.ModuleFault)XIO(VirtualAx.ConfigFault)OTE(AxEnabled);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,1)XIC(AxEnabled)XIC(AxStart)[XIO(VirtualAx.JogStatus) ,NEQ(Data.Motion.HmiJogSpeed,LocJogSpeed) ][MAJ(VirtualAx,Data.Motion.Jog,Data.Motion.HmiJogDirection,Data.Motion.HmiJogSpeed,Units per sec,Data.Motion.HmiAccelRate,% of Maximum,Data.Motion.HmiDecelRate,% of Maximum,Trapezoidal,100,100,% of Maximum,Disabled,Programmed,0,None) ,MOV(Data.Motion.HmiJogSpeed,LocJogSpeed) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,3)XIC(AxEnabled)XIC(AxStart)EQU(Data.Motion.HmiGearAccelRate,0)XIO(VirtualAx.GearingStatus)MAG(VirtualAx,PhysicalMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,1,Data.Motion.GearSlaveCounts,360,Actual,Real,Disabled,0,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,3)XIC(AxEnabled)XIC(AxStart)GRT(PhysicalMaster.ActualVelocity,1)NEQ(Data.Motion.HmiGearAccelRate,0)XIO(VirtualAx.GearingStatus)CPT(LocGearAccelRate,PhysicalMaster.ActualVelocity*PhysicalMaster.ActualVelocity/(2*Data.Motion.HmiGearAccelRate* 360))MAG(VirtualAx,PhysicalMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,1,1,1,Actual,Real,Enabled,LocGearAccelRate,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,3)XIC(AxEnabled)XIC(AxStart)LES(PhysicalMaster.ActualVelocity,1)NEQ(Data.Motion.HmiGearAccelRate,0)XIO(VirtualAx.GearingStatus)MAG(VirtualAx,PhysicalMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,1,1,1,Actual,Real,Disabled,LocGearAccelRate,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,4)XIC(AxEnabled)XIC(AxStart)XIO(VirtualAx.GearingStatus)[EQU(Data.Motion.HmiGearAccelRate,0) ,LIM(-2,PhysicalMaster.ActualVelocity,2) ]MAG(VirtualAx,PhysicalMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,1,1,1,Actual,Real,Disabled,0,Units per sec2);]]>
</Text>
