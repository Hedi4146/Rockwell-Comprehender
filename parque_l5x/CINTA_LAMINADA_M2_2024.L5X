<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(TimerSpliceEnd.DN)[OTU(EVSpliceA) ,OTU(EVSpliceB) ,OTU(LocMemManSplice) ,XIC(Loc_SplicePreparedA) OTL(StartA) ,XIC(Loc_SplicePreparedB) OTL(StartB) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIC(RewindEndA) ONS(Aux4) ,XIO(Enable) ][OTU(RewindA) ,OTU(StartForSplice) ];]]>
