</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIO(Enable)[OTU(EVSpliceA) ,OTU(EVSpliceB) ,OTU(MemManSplice) ,OTU(RewindA) ,OTU(RewindB) ,OTU(StartForSplice) ,XIC(StartA) XIC(StartB) OTU(StartB) ];]]>
