</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[[XIC(LocMagA.ER) MOV(LocMagA.ERR,IstFaultCode) ,XIC(LocMagB.ER) MOV(LocMagB.ERR,IstFaultCode) ,XIC(LocMagA1.ER) MOV(LocMagA1.ERR,IstFaultCode) ,XIC(LocMagB1.ER) MOV(LocMagB1.ERR,IstFaultCode) ,XIC(LocJogRewA.ER) MOV(LocJogRewA.ERR,IstFaultCode) ,XIC(LocJogRewB.ER) MOV(LocJogRewB.ERR,IstFaultCode) ,XIC(LocMasA.ER) MOV(LocMasA.ERR,IstFaultCode) ,XIC(LocMasA1.ER) MOV(LocMasA1.ERR,IstFaultCode) ,XIC(LocMasB.ER) MOV(LocMasB.ERR,IstFaultCode) ,XIC(LocMasB1.ER) MOV(LocMasB1.ERR,IstFaultCode) ,XIC(Data.ServoManagerA.ER) MOV(Data.ServoManagerA.IstError,IstFaultCode) ,XIC(Data.ServoManagerB.ER) MOV(Data.ServoManagerB.IstError,IstFaultCode) ]OTE(ER);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Text>
<![CDATA[XIC(ResetAxAlarm)[XIC(LocMagA.ER) CLR(LocMagA.FLAGS) ,XIC(LocMagA1.ER) CLR(LocMagA1.FLAGS) ,XIC(LocMagB.ER) CLR(LocMagB.FLAGS) ,XIC(LocMagB1.ER) CLR(LocMagB1.FLAGS) ,XIC(LocJogRewA.ER) CLR(LocJogRewA.FLAGS) ,XIC(LocJogRewB.ER) CLR(LocJogRewB.FLAGS) ,XIC(LocMasA.ER) CLR(LocMasA.FLAGS) ,XIC(LocMasA1.ER) CLR(LocMasA1.FLAGS) ,XIC(LocMasB.ER) CLR(LocMasB.FLAGS) ,XIC(LocMasB1.ER) CLR(LocMasB1.FLAGS) ,CLR(IstFaultCode) ,CLR(DriveFaultCode) ];]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[[XIC(AxA.AxisFault.0) ,XIC(AxA.AxisFault.1) ,XIC(AxB.AxisFault.0) ,XIC(AxB.AxisFault.1) ,XIC(AxC.AxisFault.0) ,XIC(AxC.AxisFault.1) ,XIC(AxC.AxisFault.2) ]OTE(AxFault);]]>
