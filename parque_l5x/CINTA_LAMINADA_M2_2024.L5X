<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(ShieldCloserd)XIC(ReadyforSplice)[XIO(LocMemManSplice) XIC(OkForSplice) ,XIC(LocMemManSplice) XIO(PBManualSplice) ][XIC(AxAStopped) XIC(AxBStopped) ,XIC(EnableSensorSplicer) ][XIC(Loc_SplicePreparedA) [OTL(EVSpliceB) ,XIC(Enable) OTL(RewindB) ] ,XIC(Loc_SplicePreparedB) [OTL(EVSpliceA) ,XIC(Enable) OTL(RewindA) ] ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(EVSpliceB) ,XIC(EVSpliceA) ]MOV(TimeSpliceEnd,TimerSpliceEnd.PRE)TON(TimerSpliceEnd,?,?);]]>
