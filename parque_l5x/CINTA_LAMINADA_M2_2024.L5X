<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(EN)XIO(EN)OTU(EnableC)OTU(EVMandrelA)OTU(EVMandrelB)OTU(EVSpliceA)OTU(EVSpliceB)OTU(EVSplice)OTU(Loc_SplicePreparedA)OTU(Loc_SplicePreparedB)OTU(LocMemManSplice)OTU(LocMustBeSpliceA)OTU(LocMustBeSpliceB)OTU(ReadyForSplice)OTU(LocStartEVSpliceA)OTU(LocStartEVSpliceB)OTU(RewindA)OTU(RewindB)OTU(SplicePrepared)OTU(StartC)OTU(StartForSplice)OTU(EN);]]>
