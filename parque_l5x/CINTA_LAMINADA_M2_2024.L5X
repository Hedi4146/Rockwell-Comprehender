<Rung Number="25" Type="N">
<Text>
<![CDATA[XIC(Data.OutputSplice.EnableA)XIC(Data.OutputSplice.StartA)XIC(AxStart)XIC(Data.AxAEnabled)XIO(Data.OutputSplice.RewindA)[XIO(AxA.GearingStatus) ,NEQ(Data.GearRatioA,LocGearRatio) ][XIO(LocMemSplice) MAG(AxA,VMaster,LocMagA,Data.HmiAxADirection,Data.GearRatioA,1,1,Command,Real,Disabled,10000,Units per sec2) ,XIC(LocMemSplice) [CPT(LocGearAccelRate,(VMaster.AverageVelocity*Data.GearRatioA)/Data.HmiGearAccelRate) ,MAG(AxA,VMaster,LocMagA1,Data.HmiAxADirection,Data.GearRatioA,1,1,Command,Real,Enabled,10000,Units per sec2) ] ,MOV(Data.GearRatioA,LocGearRatio) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[XIC(Data.OutputSplice.EnableB)XIC(Data.OutputSplice.StartB)XIC(AxStart)XIC(Data.AxBEnabled)XIO(Data.OutputSplice.RewindB)[XIO(AxB.GearingStatus) ,NEQ(Data.GearRatioB,LocGearRatio) ][XIO(LocMemSplice) MAG(AxB,VMaster,LocMagB,Data.HmiAxBDirection,Data.GearRatioB,1,1,Command,Real,Disabled,500,Units per sec2) ,XIC(LocMemSplice) [CPT(LocGearAccelRate,(VMaster.AverageVelocity*Data.GearRatioB)/Data.HmiGearAccelRate) ,MAG(AxB,VMaster,LocMagB1,Data.HmiAxBDirection,Data.GearRatioB,1,1,Command,Real,Enabled,LocGearAccelRate,Units per sec2) ] ,MOV(Data.GearRatioB,LocGearRatio) ];]]>
