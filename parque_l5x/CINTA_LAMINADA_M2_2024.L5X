<Rung Number="7" Type="N">
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,4)XIC(AxEnabled)XIC(AxStart)XIO(VirtualAx.GearingStatus)NEQ(Data.Motion.HmiGearAccelRate,0)GRT(PhysicalMaster.ActualVelocity,2)CPT(LocGearAccelRate,PhysicalMaster.ActualVelocity*PhysicalMaster.ActualVelocity/(2*Data.Motion.HmiGearAccelRate*360))MAG(VirtualAx,PhysicalMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,1,1,1,Actual,Real,Enabled,LocGearAccelRate,Units per sec2);]]>
