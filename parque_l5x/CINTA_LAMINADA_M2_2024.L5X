<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(ShieldCloserd)[XIC(Loc_SplicePreparedA) ,XIC(Loc_SplicePreparedB) ][XIC(PBManualSplice) ,XIC(LocEnableAxManSplice) ]XIO(MemManSplice)OTE(LocEnableAxManSplice);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(LocEnableAxManSplice)[XIC(Loc_SplicePreparedA) [XIC(AxAEnabled) ,XIO(Enable) ] ,XIC(Loc_SplicePreparedB) [XIC(AxBEnabled) ,XIO(Enable) ] ]OTL(MemManSplice);]]>
