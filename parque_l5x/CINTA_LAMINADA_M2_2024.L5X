<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(FTC)ONS(aux1)OTL(FdS_FTC);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Trigger)XIC(BLS_Source)[OTU(BLS_Source) ,OTU(FdS_FTC) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(FdS_FTC)XIC(Trigger)XIO(BLS_Source)OTL(BLS_Source);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[MOV(Delay,BSLControl.LEN);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(Trigger)BSL(istance.Arrey,BSLControl,BLS_Source,?);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(BSLControl.UL)ONS(aux2)OTL(aux3);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(aux3)XIC(Trigger)ADD(counter,1,counter);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[GEQ(counter,To_Reject)[OTU(aux3) ,MUL(counter,0,counter) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(aux3)OTE(out);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(FTC)[MOV(time_sensor_check,timer.PRE) ,TON(timer,?,?) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(timer.DN)OTE(alarm_sensor);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
