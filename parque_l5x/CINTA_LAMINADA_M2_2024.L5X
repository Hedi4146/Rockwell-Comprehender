<Routine Name="Glue" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIO(HMI_Glue_CapTest) XIC(MachineMoving) CPT(NODE_Z1:2:O.Ch0Data,10000*MachineSpeed_PPM/max_machine_speed) ,XIC(HMI_Glue_CapTest) CPT(NODE_Z1:2:O.Ch0Data,100*Glue_speed_test) ,XIC(test) MOV(ref_test,NODE_Z1:2:O.Ch0Data) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[GRT(MachineSpeed_PPM,HMI_LimitGlueOn)OTE(LimitGlueSpeed);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[ADD(HMI_LimitGlueOn,HMI_DelayGlueValve,LimitGluePumpOn) ,GRT(MachineSpeed_PPM,LimitGluePumpOn) OTE(LimitGluePump) ];]]>
