<Rung Number="24" Type="N">
<Text>
<![CDATA[[XIC(Data.OutputSplice.StartForSplice) OTL(LocMemSplice) ,XIC(LocMemSplice) XIO(Data.OutputSplice.StartForSplice) [TON(EndAccmandrel,?,?) ,XIC(EndAccmandrel.DN) OTU(LocMemSplice) ] ];]]>
