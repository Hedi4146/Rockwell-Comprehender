<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(CutterA) ,XIC(CutterB) ,XIC(Start) ]ONS(Aux4)[MOV(InitRadius,RadiusComputation_actual) MOV(InitRadius,RadiusComputation_Avg) MOV(InitRadius,RadiusComputation) ,CPT(Ratio,(LenghtProduct /3.1416) / (RadiusComputation * 2)) ,CLR(Counter) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Start)XIC(TriggerProduct)[GEQ(Counter,FreqUpdateRadius) CLR(Counter) ,LES(Counter,FreqUpdateRadius) ADD(Counter,1,Counter) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(StopRequest)CLR(Counter);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[GEQ(Counter,FreqUpdateRadius) ,XIC(Not_FreqUpdateRadius) ][CPT(RadiusComputation_actual,(MasterSpeed * LenghtProduct / 6.2831)/AxSpeed) ,GRT(RadiusComputation_actual,RadiusComputation_Avg) ADD(RadiusComputation_Avg,K_Diam,RadiusComputation_Avg) ,LES(RadiusComputation_actual,RadiusComputation_Avg) SUB(RadiusComputation_Avg,K_Diam,RadiusComputation_Avg) ,LES(RadiusComputation_Avg,45) MOV(45,RadiusComputation_Avg) ,GRT(RadiusComputation_Avg,520) MOV(520,RadiusComputation_Avg) ,MOV(RadiusComputation_Avg,RadiusComputation) CPT(Ratio,(LenghtProduct /3.1416) / (RadiusComputation * 2)) ,CLR(Counter) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(LoadManRadius)MOV(ManRadius,RadiusComputation_actual)MOV(ManRadius,RadiusComputation_Avg)MOV(ManRadius,RadiusComputation)[CPT(Ratio,(LenghtProduct /3.1416) / (RadiusComputation * 2)) ,CLR(Counter) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
