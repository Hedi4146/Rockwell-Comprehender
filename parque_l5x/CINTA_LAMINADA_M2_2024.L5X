<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(PBStopMotor) MOV(90,LocDancerSetpoint) ,XIO(PBStopMotor) MOV(DancerSetpoint,LocDancerSetpoint) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)TON(T1,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)XIC(MachineStart)XIC(T1.DN)[GRT(MasterSpeed,0) [XIC(CAMBIO_1) CPT(LocCorrection,MasterSpeed * GainCorrection  * Ratio * ((LocDancerSetpoint - DancerPosition)/50)) ,XIC(CAMBIO_2) CPT(LocCorrection,(LocDancerSetpoint - DancerPosition)* GainCorrection) ] ,EQU(MasterSpeed,0) CPT(LocCorrection,LocDancerSetpoint - DancerPosition) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)XIC(MachineStart)XIO(T1.DN)CPT(LocCorrection,(MasterSpeed * GainCorrection  * Ratio * ((LocDancerSetpoint - DancerPosition)/50))/GainCorrectionSplicer);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(AxStart)XIO(AutocalcRaduisRunning)XIC(EnablePreStart)[XIC(AutoCalcRadiusDone) ,XIO(EnableInitRadiusAutocalc) ]CPT(LocCorrection,(((1200-ReelRadius)/Kp1DancerCorreection)*((20-DancerPosition)/2))/2);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(EnableRewinder)MUL(LocCorrection,-1,LocCorrection);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(HmiDisableCorrPrepared)XIC(AxPrepared)XIO(EnableInitRadiusAutocalc)XIO(AxStart)CLR(LocCorrection);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(AxStart) ,XIO(AxEnabled) ][OTU(AutoCalcRadiusDone) ,OTU(AutocalcRaduisRunning) ,OTU(StartJogAutoCalc) ,CLR(LocAutocalc) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(RewinderEnable) MUL(LocCorrection,-1,LocCorrection1) ,XIO(RewinderEnable) MOV(LocCorrection,LocCorrection1) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(RewinderEnable)XIC(AxEnabled)XIC(AxStart)NEQ(LocCorrection,Aux1LocCorrection)[MAJ(Ax,LocMAJ1,Direction,LocCorrection1,Units per sec,100,% of Maximum,100,% of Maximum,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None) ,MOV(LocCorrection,Aux1LocCorrection) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIO(RewinderEnable)[[XIO(AxEnabled) ,XIO(AxStart) ] XIC(Ax.JogStatus) ,XIO(AxEnabled) XIC(AxEnabled) XIC(Ax.JogStatus) EQU(LocCorrection1,0) ,XIO(AxStart) ]MAS(Ax,LocMAS2,Jog,Yes,100,% of Maximum,Yes,100,% of Maximum);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
