<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIC(Loc_SplicePreparedA) XIC(LocMustBeSpliceB) ,XIC(Loc_SplicePreparedB) XIC(LocMustBeSpliceA) ,XIC(MemManSplice) ]XIC(BufferInPosition)OTE(ReadyforSplice);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[XIC(EVSpliceB) ,XIC(EVSpliceA) ,XIC(TimerSpliceEnd.EN) ]XIO(TimerSpliceEnd.DN)[MOV(TimeSpliceEnd,TimerSpliceEnd.PRE) TON(TimerSpliceEnd,?,?) ,SUB(TimeSpliceEnd,100,TimerSpliceValveOff.PRE) TON(TimerSpliceValveOff,?,?) ];]]>
