<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(Loc_SplicePreparedA) XIC(AxAEnabled) ,XIC(Loc_SplicePreparedB) XIC(AxBEnabled) ]OTE(SplicePrepared);]]>
</Text>
