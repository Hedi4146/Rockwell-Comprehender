<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[Servo_Manager(Data.Motion.ServoManager,PhysicalAx,GroupSincro,ResetAxAlarm,AxEnable,AxEnabled);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)XIO(PhysicalAx.GearingStatus)XIO(Data.Motion.EnableGearPhasedNotPair)CPT(Data.Motion.GearRatio,1/Data.Input.AxPar.HmiRollDiameter)[EQU(Data.Motion.HmiGearAccelRate,0) ,EQU(VMaster.ActualVelocity,0) ]MAG(PhysicalAx,VMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,Data.Motion.GearRatio,Data.Motion.GearSlaveCounts,360,Command,Real,Disabled,0,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)XIO(PhysicalAx.GearingStatus)XIC(Data.Motion.EnableGearPhasedNotPair)CPT(Data.Motion.GearRatio,Data.Input.AxPar.HmiRollDiameter/360)[EQU(Data.Motion.HmiGearAccelRate,0) ,EQU(VMaster.ActualVelocity,0) ]MAG(PhysicalAx,VMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,Data.Motion.GearRatio,Data.Motion.GearSlaveCounts,360,Command,Real,Disabled,0,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)XIO(PhysicalAx.GearingStatus)NEQ(Data.Motion.HmiGearAccelRate,0)NEQ(VMaster.ActualVelocity,0)CPT(Data.Motion.GearRatio,1/Data.Input.AxPar.HmiRollDiameter)CPT(LocGearAccelRate,VMaster.ActualVelocity*VMaster.ActualVelocity/(Data.Motion.HmiGearAccelRate*2))MAG(PhysicalAx,VMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,Data.Motion.GearRatio,Data.Motion.GearSlaveCounts,360,Command,Real,Enabled,LocGearAccelRate,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIO(AxEnabled) ,XIO(AxStart) ]ONS(Aux9)[MOV(PhysicalAx.ActualPosition,Data.Motion.MemPhisicalAxActualposition) ,OTU(Data.Motion.GearAbsoluteAxPhased) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIO(Data.Motion.GearAbsoluteAxPhasing)XIC(Data.Motion.PhaseForwardCommand)XIO(Data.Motion.ManualPhMamFw.IP)ONS(Aux7)CPT(LocStepManPhase,Data.Motion.HmiManualPhaserStep/1)[MAM(PhysicalAx,Data.Motion.ManualPhMamFw,1,LocStepManPhase,Data.Motion.HmiManualPhaserVelocity,Units per sec,50,Units per sec2,50,Units per sec2,Trapezoidal,100,100,% of Maximum,Disabled,0,0,None,0,0) ,LES(Data.Motion.ManualPhaseOffset,Data.Input.AxPar.ModuleAx) ADD(Data.Motion.ManualPhaseOffset,Data.Motion.HmiManualPhaserStep,Data.Motion.ManualPhaseOffset) ,GEQ(Data.Motion.ManualPhaseOffset,Data.Input.AxPar.ModuleAx) MOV(0,Data.Motion.ManualPhaseOffset) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIO(Data.Motion.GearAbsoluteAxPhasing)XIC(Data.Motion.PhaseBackwardCommand)XIO(Data.Motion.ManualPhMamBk.IP)ONS(Aux8)CPT(LocStepManPhase,Data.Motion.HmiManualPhaserStep/-1)[MAM(PhysicalAx,Data.Motion.ManualPhMamBk,1,LocStepManPhase,Data.Motion.HmiManualPhaserVelocity,Units per sec,50,Units per sec2,50,Units per sec2,Trapezoidal,100,100,% of Maximum,Disabled,0,0,None,0,0) ,GRT(Data.Motion.ManualPhaseOffset,0) SUB(Data.Motion.ManualPhaseOffset,Data.Motion.HmiManualPhaserStep,Data.Motion.ManualPhaseOffset) ,LEQ(Data.Motion.ManualPhaseOffset,0) MOV(Data.Input.AxPar.ModuleAx,Data.Motion.ManualPhaseOffset) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIO(AxEnabled) ONS(LocAux2) ,XIO(AxStart) ONS(LocAux1) ][XIC(PhysicalAx.JogStatus) ,XIC(PhysicalAx.GearingStatus) LES(VMaster.ActualVelocity,1) ,XIC(PhysicalAx.HomingStatus) ,XIC(PhysicalAx.MoveStatus) ][MAS(PhysicalAx,Data.Motion.Stop,All,Yes,90,% of Maximum,No,100,% of Maximum) ,OTU(Data.Motion.GearAbsoluteAxPhasing) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(AxStart)ONS(LocAux12)XIC(PhysicalAx.GearingStatus)GRT(VMaster.ActualVelocity,1)CPT(LocGearDecelRate,(VMaster.ActualVelocity*Data.Motion.GearRatio)/Data.Motion.HmiGearAccelRate)[MAS(PhysicalAx,Data.Motion.Stop,All,Yes,LocGearDecelRate,Units per sec2,Yes,10,% of Maximum) ,OTU(Data.Motion.GearAbsoluteAxPhasing) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(Data.Motion.GearAbsoluteAxPhased)XIC(PhysicalAx.GearingLockStatus)OTE(AxSyncro);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(PhysicalAx.AxisHomedStatus)OTE(AxHomed);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIO(AxEnabled)ONS(aux5)[CLR(Data.Motion.Jog.FLAGS) ,CLR(Data.Motion.Move.FLAGS) ,CLR(Data.Motion.Stop.FLAGS) ,CLR(Data.Motion.Gear.FLAGS) ,CLR(Data.Motion.ManualPhMamFw.FLAGS) ,CLR(Data.Motion.ManualPhMamBk.FLAGS) ,CLR(IstFaultCode) ,CLR(DriveFaultCode) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(Data.Motion.Jog.ER) MOV(Data.Motion.Jog.ERR,IstFaultCode) ,XIC(Data.Motion.Move.ER) MOV(Data.Motion.Move.ERR,IstFaultCode) ,XIC(Data.Motion.Stop.ER) MOV(Data.Motion.Stop.ERR,IstFaultCode) ,XIC(Data.Motion.Gear.ER) MOV(Data.Motion.Gear.ERR,IstFaultCode) ,XIC(Data.Motion.ManualPhMamFw.ER) MOV(Data.Motion.ManualPhMamFw.ERR,IstFaultCode) ,XIC(Data.Motion.ManualPhMamBk.ER) MOV(Data.Motion.ManualPhMamBk.ERR,IstFaultCode) ,XIC(Data.Motion.ServoManager.ER) MOV(Data.Motion.ServoManager.IstError,IstFaultCode) ]OTE(Er);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIC(ResetAxAlarm) ,XIC(PhysicalAx.InhibitStatus) ][XIC(Data.Motion.Jog.ER) CLR(Data.Motion.Jog.FLAGS) ,XIC(Data.Motion.Move.ER) CLR(Data.Motion.Move.FLAGS) ,XIC(Data.Motion.Stop.ER) CLR(Data.Motion.Stop.FLAGS) ,XIC(Data.Motion.Gear.ER) CLR(Data.Motion.Gear.FLAGS) ,XIC(Data.Motion.ManualPhMamFw.ER) CLR(Data.Motion.ManualPhMamFw.FLAGS) ,XIC(Data.Motion.ManualPhMamBk.ER) CLR(Data.Motion.ManualPhMamBk.FLAGS) ,CLR(IstFaultCode) ,CLR(DriveFaultCode) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIO(PhysicalAx.InhibitStatus)[XIC(PhysicalAx.AxisFault.0) ,XIC(PhysicalAx.AxisFault.1) ,XIC(PhysicalAx.AxisFault.2) ][OTE(AxFault) ,MOV(PhysicalAx.DriveFault,DriveFaultCode) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
