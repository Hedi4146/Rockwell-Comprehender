<DefaultData>00 00 00 00 32 00 00 00 00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<Structure DataType="CONTROL">
<DataValueMember Name="LEN" DataType="DINT" Radix="Decimal" Value="50"/>
<DataValueMember Name="POS" DataType="DINT" Radix="Decimal" Value="0"/>
