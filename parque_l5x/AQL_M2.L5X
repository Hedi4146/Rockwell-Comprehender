<![CDATA[[XIC(ResetAxAlarm) ,XIC(PhysicalAx.InhibitStatus) ][XIC(AutoPhMam.ER) CLR(AutoPhMam.FLAGS) ,XIC(AutoPhMam1.ER) CLR(AutoPhMam1.FLAGS) ,XIC(Data.Motion.Jog.ER) CLR(Data.Motion.Jog.FLAGS) ,XIC(Data.Motion.Move.ER) CLR(Data.Motion.Move.FLAGS) ,XIC(Stop.ER) CLR(Stop.FLAGS) ,XIC(Stop1.ER) CLR(Stop1.FLAGS) ,XIC(Stop2.ER) CLR(Stop2.FLAGS) ,XIC(Gear.ER) CLR(Gear.FLAGS) ,XIC(Gear1.ER) CLR(Gear1.FLAGS) ,XIC(Gear2.ER) CLR(Gear2.FLAGS) ,XIC(Gear3.ER) CLR(Gear3.FLAGS) ,XIC(Gear4.ER) CLR(Gear4.FLAGS) ,XIC(Gear5.ER) CLR(Gear5.FLAGS) ,XIC(Data.Motion.ManualPhMamFw.ER) CLR(Data.Motion.ManualPhMamFw.FLAGS) ,XIC(Data.Motion.ManualPhMamBk.ER) CLR(Data.Motion.ManualPhMamBk.FLAGS) ,XIC(Data.Motion.HomeMAH.ER) CLR(Data.Motion.HomeMAH.FLAGS) ,CLR(IstFaultCode) ,CLR(DriveFaultCode) ];]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[XIO(PhysicalAx.InhibitStatus)[XIC(PhysicalAx.AxisFault.0) ,XIC(PhysicalAx.AxisFault.1) ,XIC(PhysicalAx.AxisFault.2) ][OTE(AxFault) ,MOV(PhysicalAx.DriveFault,DriveFaultCode) ];]]>
</Text>
</Rung>
