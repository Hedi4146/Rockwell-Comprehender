<![CDATA[[EQU(Data.Input.AxPar.HmiOpMode,4) XIC(Data.Motion.GearAbsoluteAxPhased) XIC(VirtualAx.GearingLockStatus) ,EQU(Data.Input.AxPar.HmiOpMode,3) XIC(VirtualAx.GearingLockStatus) ]OTE(AxSyncro);]]>
