<Program Name="ReadPar" TestEdits="false" MainRoutineName="ReadPara" Disabled="false">
<Tags/>
<Routines>
<Routine Name="ReadPara" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[M4Data.Input.AxPar.ProductLength	:= 1;]]>
</Line>
<Line Number="1">
<![CDATA[M5Data.Input.AxPar.ProductLength	:= 1;]]>
</Line>
<Line Number="2">
<![CDATA[M9Data.Input.AxPar.ProductLength	:= 1;]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[//M3Data.Input.AxPar.ProductLength			:= M3Data.Input.AxPar.HmiOfsetLength + HmiProductLength;]]>
</Line>
<Line Number="5">
<![CDATA[M5Data.Motion.GearAbsoluteSpeedAutoPhase	:= M4Data.Motion.GearAbsoluteSpeedAutoPhase;]]>
</Line>
<Line Number="6">
<![CDATA[M6Data.Input.AxPar.ProductLength			:= M6Data.Input.AxPar.HmiOfsetLength + HmiAcqlLength;]]>
</Line>
<Line Number="7">
<![CDATA[M10Data.Input.AxPar.ProductLength			:= M10Data.Input.AxPar.HmiOfsetLength + HmiProductLength;]]>
</Line>
<Line Number="8">
<![CDATA[M13Data.Input.AxPar.ProductLength			:= M13Data.Input.AxPar.HmiOfsetLength + HmiWaistBandLength;]]>
</Line>
<Line Number="9">
<![CDATA[//M14Data.Input.AxPar.ProductLength			:= M14Data.Input.AxPar.HmiOfsetLength + HmiProductLength;]]>
</Line>
<Line Number="10">
<![CDATA[//M15Data.Input.AxPar.ProductLength			:= M15Data.Input.AxPar.HmiOfsetLength + HmiProductLength;]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[LengthACQL			:= HmiAcqlLength + M3Data.Input.AxPar.HmiOfsetLength;]]>
</Line>
<Line Number="13">
<![CDATA[LengthWaistBand     := HmiWaistBandLength + M13Data.Input.AxPar.HmiOfsetLength;]]>
</Line>
<Line Number="14">
<![CDATA[]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
