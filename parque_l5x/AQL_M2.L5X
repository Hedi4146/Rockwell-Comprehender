<Routines>
<Routine Name="EnableInFalse" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(EN)JMP(END);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(EN)XIO(EN)OTU(EVMandrelA)OTU(EVMandrelB)OTU(EVPrepareA)OTU(EVPrepareB)OTU(EVSpliceA)OTU(EVSpliceB)OTU(Loc_SplicePreparedA)OTU(Loc_SplicePreparedB)OTU(LocMemManSplice)OTU(LocMustBeSpliceA)OTU(LocMustBeSpliceB)OTU(ReadyforSplice)OTU(RewindA)OTU(RewindB)OTU(SplicePrepared)OTU(StartForSplice)OTU(EN);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[LBL(END)OTE(Locaux2);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTL(EN);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIO(EnableSensorSplicer) ,XIC(EnableSensorSplicer) XIO(SensorPresenceRollA) ]LES(ReelRadiusA,MinRadus)OTE(LocMustBeSpliceA);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIO(EnableSensorSplicer) ,XIC(EnableSensorSplicer) XIO(SensorPresenceRollB) ]LES(ReelRadiusB,MinRadus)OTE(LocMustBeSpliceB);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(PbPrepare)ONS(aux1)XIC(ShieldCloserd)OTE(LocRtPbPrepare);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIO(StartA) XIO(Loc_SplicePreparedB) ,XIO(TimerSpliceEnd.DN) XIC(Loc_SplicePreparedA) ][XIC(LocRtPbPrepare) ,XIC(Loc_SplicePreparedA) ][XIO(LocRtPbPrepare) ,XIO(Loc_SplicePreparedA) ]OTE(Loc_SplicePreparedA);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIO(StartB) XIO(Loc_SplicePreparedA) ,XIO(TimerSpliceEnd.DN) XIC(Loc_SplicePreparedB) ][XIC(LocRtPbPrepare) ,XIC(Loc_SplicePreparedB) ][XIO(LocRtPbPrepare) ,XIO(Loc_SplicePreparedB) ]OTE(Loc_SplicePreparedB);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(Loc_SplicePreparedA) XIC(AxAEnabled) ,XIC(Loc_SplicePreparedB) XIC(AxBEnabled) ]OTE(SplicePrepared);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(Loc_SplicePreparedA) ,XIC(EVSpliceA) ]OTE(EVPrepareA);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(Loc_SplicePreparedB) ,XIC(EVSpliceB) ]OTE(EVPrepareB);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(ShieldCloserd)[XIC(Loc_SplicePreparedA) ,XIC(Loc_SplicePreparedB) ][XIC(PBManualSplice) ,XIC(LocEnableAxManSplice) ]XIO(MemManSplice)OTE(LocEnableAxManSplice);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(LocEnableAxManSplice)[XIC(Loc_SplicePreparedA) [XIC(AxAEnabled) ,XIO(Enable) ] ,XIC(Loc_SplicePreparedB) [XIC(AxBEnabled) ,XIO(Enable) ] ]OTL(MemManSplice);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(ShieldCloserd)XIC(ReadyforSplice)[XIO(MemManSplice) XIC(OkForSplice) ,XIC(MemManSplice) XIO(PBManualSplice) ]ONS(locAux1)[OTL(StartForSplice) ,XIC(Loc_SplicePreparedB) OTU(StartA) ,XIC(Loc_SplicePreparedA) OTU(StartB) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(ShieldCloserd)XIC(ReadyforSplice)[XIO(MemManSplice) XIC(OkForSplice) ,XIC(MemManSplice) XIO(PBManualSplice) ]XIC(AxAStopped)XIC(AxBStopped)ONS(Locaux3)[XIC(Loc_SplicePreparedA) [OTL(EVSpliceB) ,XIC(KnifeBBackwardward) [OTL(EVKnifeBForward) ,OTU(EVKnifeBBackward) ] ,XIC(KnifeBForward) [OTL(EVKnifeBBackward) ,OTU(EVKnifeBForward) ] ] ,XIC(Loc_SplicePreparedB) [OTL(EVSpliceA) ,XIC(KnifeABackwardward) [OTL(EVKnifeAForward) ,OTU(EVKnifeABackward) ] ,XIC(KnifeAForward) [OTL(EVKnifeABackward) ,OTU(EVKnifeAForward) ] ] ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIC(EVSpliceB) XIC(KnifeBForward) ,XIC(EVSpliceA) XIC(KnifeAForward) ]MOV(TimeSpliceEnd,TimerSpliceEnd.PRE)TON(TimerSpliceEnd,?,?);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[XIC(Loc_SplicePreparedA) XIC(LocMustBeSpliceB) ,XIC(Loc_SplicePreparedB) XIC(LocMustBeSpliceA) ,XIC(MemManSplice) ]XIC(BufferInPosition)OTE(ReadyforSplice);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(TimerSpliceEnd.DN)[OTU(EVSpliceA) ,OTU(EVSpliceB) ,OTU(MemManSplice) ,XIC(Loc_SplicePreparedA) [OTL(StartA) ,OTL(RewindB) ] ,XIC(Loc_SplicePreparedB) [OTL(StartB) ,OTL(RewindA) ] ,OTU(StartForSplice) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[XIC(RewindEndA) ,XIO(Enable) ]OTU(RewindA);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[XIC(RewindEndB) ,XIO(Enable) ]OTU(RewindB);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[XIC(Loc_SplicePreparedA) ,XIC(StartA) ,XIC(RewindA) ,XIC(StartForSplice) ][XIC(Enable) OTE(EnableA) ,OTE(EVMandrelA) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[[XIC(Loc_SplicePreparedB) ,XIC(StartB) ,XIC(RewindB) ,XIC(StartForSplice) ][XIC(Enable) OTE(EnableB) ,OTE(EVMandrelB) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIO(Enable)[OTU(EVSpliceA) ,OTU(EVSpliceB) ,OTU(MemManSplice) ,OTU(RewindA) ,OTU(RewindB) ,OTU(StartForSplice) ,XIC(StartA) XIC(StartB) OTU(StartB) ];]]>
</Text>
</Rung>
</RLLContent>
