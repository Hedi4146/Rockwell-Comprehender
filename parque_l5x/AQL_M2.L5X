</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[LBL(Lbl2)OTE(aux);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIO(Istance.HmiEnable)ONS(LocAux4)FLL(0,Istance.Arrey[0],10)OTU(Istance.HmiAlarm)OTU(Alarm)OTU(LocFlag)OTU(LocScrap)OTU(Out)OTU(Istance.HmiLed)CLR(LocCount1);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(ResetCounter)CLR(Istance.HmiCounterRejected);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(Istance.HmiEnable)OTE(Enable);]]>
