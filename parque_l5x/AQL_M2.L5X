</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Reposition_Procedure_M4)[ADD(Vmaster1.ActualPosition,M4_Pos_Phase,M4_Pos_Phase_Command) TON(Timer_Start_Reposition_M4,?,?) ,LIM(1,Timer_Start_Reposition_M4.ACC,150) ADD(M4_Pos_Phase_Command,180,M4_Men_Pos_Lim) GRT(M4_Men_Pos_Lim,360) SUB(M4_Men_Pos_Lim,360,M4_Men_Pos_Lim) ,LIM(151,Timer_Start_Reposition_M4.ACC,300) ONS(BIT3.26) LIM(M4_Pos_Phase_Command,S04N74_CORTE_APLIC_AQL.ActualPosition,M4_Men_Pos_Lim) OTL(M4_Dir_Repos) ,LIM(301,Timer_Start_Reposition_M4.ACC,600) [XIC(M4_Dir_Repos) MOV(4,Reposition_Direction_M4) ,XIO(M4_Dir_Repos) MOV(3,Reposition_Direction_M4) ] ,GRT(Timer_Start_Reposition_M4.ACC,600) MAM(S04N74_CORTE_APLIC_AQL,MAM_Reposition_M4,Reposition_Direction_M4,M4_Operation_Position,Homing_Speed_M4,Units per sec,30,% of Maximum,50,% of Maximum,S-Curve,75,75,% of Maximum,Disabled,Programmed,0,None,0,0) XIC(MAM_Reposition_M4.IP) OTU(Start_Reposition_M4) OTU(Reposition_Procedure_M4) ];]]>
</Text>
</Rung>
