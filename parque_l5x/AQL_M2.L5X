<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(Allarm_Reset) ,XIC(Asse.HomeEventArmedStatus) ONS(Aux2) ][XIC(Asse.ShutdownStatus) MASR(Asse,Reset_Std_Asse) ,MAFR(Asse,Reset_Fault_Asse) ];]]>
</Text>
