<![CDATA[[XIC(ServoAxis_Active) XIO(EM_Fault) OTE(MAJ_Permissive) ,XIO(HMI_Do_MAJ_Clutch) [XIC(Input_Switch) MOV(0,MAJDirection) TON(Switch_ON_T,?,?) ,XIO(Input_Switch) MOV(1,MAJDirection) TON(Switch_OFF_T,?,?) ] ,XIC(MAJ_Permissive) XIO(HMI_Cmd_Home) [XIC(Switch_ON_T.DN) ,XIC(Switch_OFF_T.DN) ] XIO(Mirror) [MAJ(Ref_ServoAxis,MI_MAJ,MAJDirection,HMI_MAJ_Speed,Units per sec,HMI_Accel,Units per sec2,HMI_Decel,Units per sec2,Trapezoidal,ACCEL_J,DECEL_J,Units per sec3,Disabled,Programmed,0,None) ,NEQ(HMI_MAJ_Speed,Par_MAJ_Speed_Mirror) [OTE(Mirror) ,MOV(HMI_MAJ_Speed,Par_MAJ_Speed_Mirror) ] ] ,XIC(MI_MAJ.IP) OTE(EM_MAJ_IP) ];]]>
