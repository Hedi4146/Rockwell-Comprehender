<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Group_Sinced)XIO(Asse.SERCOSRingFault)XIO(Asse.PhysicalAxisFault)XIO(Asse.ModuleFault)XIO(Asse.ConfigFault)XIC(Asse.BusReadyStatus)OTE(Asse_Ready);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Asse_Ready)XIC(Abilitazione)XIO(Asse.ServoActionStatus)MSO(Asse,Servo_On);]]>
