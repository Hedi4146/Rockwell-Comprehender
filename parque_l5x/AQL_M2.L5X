<Rung Number="7" Type="N">
<Text>
<![CDATA[[XIC(UnWinder_Running) [XIC(Left_Cutter_Cmd) ONS(ONS.3) OTL(Left_ReWind_Bit) ,XIC(Right_Cutter_Cmd) ONS(ONS.4) OTL(Right_ReWind_Bit) ] ,XIC(Left_ReWind_Bit) [TON(Timer_Left_ReWind,?,?) GRT(Timer_Left_ReWind.ACC,Delay_Rewind) OTE(Left_ReWind_Actived) ,XIC(Timer_Left_ReWind.DN) OTU(Left_ReWind_Bit) ] ,XIC(Right_ReWind_Bit) [TON(Timer_Right_ReWind,?,?) GRT(Timer_Right_ReWind.ACC,Delay_Rewind) OTE(Right_ReWind_Actived) ,XIC(Timer_Right_ReWind.DN) OTU(Right_ReWind_Bit) ] ];]]>
