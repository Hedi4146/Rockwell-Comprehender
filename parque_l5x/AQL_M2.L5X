<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIO(Set_Up_Off)OTU(Left_Set_Up)OTU(Right_Set_Up)OTU(Right_Cutter_Cmd)OTU(Left_Cutter_Cmd);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[[GEQ(Splice_Diameter,Left_Present_Diameter) XIC(Ready_to_Run_Left) XIO(Left_Set_Up) ,GEQ(Splice_Diameter,Right_Present_Diameter) XIC(Ready_to_Run_Right) XIO(Right_Set_Up) ] XIC(UnWinder_Running) OTE(Splice_Not_Prepared) ,XIO(Ready_to_Run_Left) XIO(Ready_to_Run_Right) TON(Timer_1,?,?) XIC(Timer_1.DN) ONS(ONS.0) OTL(Ready_to_Run_Right) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(Ready_to_Run_Right) XIC(Cmd_Prepare_Splice) ONS(ONS.1) [XIO(Left_Set_Up) OTL(Left_Set_Up) OTE(Bit_Left_Set_Up) ,XIO(Bit_Left_Set_Up) OTU(Left_Set_Up) ] ,XIC(Left_Set_Up) OTE(Left_Press_Cmd) ,[XIC(Left_Set_Up) XIC(In_Put_Blink1) ,XIC(Ready_to_Run_Left) ] OTE(Left_Light) ,XIC(Ready_to_Run_Left) XIC(Cmd_Prepare_Splice) ONS(ONS.2) [XIO(Right_Set_Up) OTL(Right_Set_Up) OTE(Bit_Right_Set_Up) ,XIO(Bit_Right_Set_Up) OTU(Right_Set_Up) ] ,XIC(Right_Set_Up) OTE(Right_Press_Cmd) ,[XIC(Right_Set_Up) XIC(In_Put_Blink1) ,XIC(Ready_to_Run_Right) ] OTE(Right_Light) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIO(Splicing_In_Process) XIC(UnWinder_Running) [XIC(Ready_to_Run_Left) GEQ(Splice_Diameter,Left_Present_Diameter) OTL(Start_Splice_Left) ,XIC(Ready_to_Run_Right) GEQ(Splice_Diameter,Right_Present_Diameter) OTL(Start_Splice_Right) ] ,XIC(Machine_Pulse) [XIC(Start_Splice_Left) CTU(Counter_To_Splice_Left,?,?) ,XIC(Start_Splice_Right) CTU(Counter_To_Splice_Right,?,?) ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[[GEQ(Counter_To_Splice_Left.ACC,Left_Splice_Delay) ,XIC(Right_Splice_Cmd) ] XIC(Right_Set_Up) OTL(Left_Splicing_Bit) OTU(Start_Splice_Left) RES(Counter_To_Splice_Left) ,[GEQ(Counter_To_Splice_Right.ACC,Right_splice_delay) ,XIC(Left_Splice_Cmd) ] XIC(Left_Set_Up) OTL(Right_Splicing_Bit) OTU(Start_Splice_Right) RES(Counter_To_Splice_Right) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(Left_Splicing_Bit) ,XIC(Right_Splicing_Bit) ]TON(Splicing_Timer,?,?)OTE(Splicing_In_Process);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
