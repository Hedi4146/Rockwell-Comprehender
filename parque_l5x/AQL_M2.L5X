<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Out)[XIC(Trigger) [ADD(LocCount1,1,LocCount1) ,ADD(Istance.HmiCounterRejected,1,Istance.HmiCounterRejected) ] ,GEQ(LocCount1,Istance.HmiNumberOf_Reject) [OTU(Out) ,CLR(LocCount1) ] ];]]>
