<Routine Name="R001_A_Corte_AQL" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
S04N74_CORTE_APLIC_AQL - UNIDAD DE CORTE AQL
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
GESTIÓN DE SERVOMOTOR: HABILITACIÓN, MOVIMIENTO Y REPOSICIONAMIENTO

Esta rutina controla las funciones principales del servomotor:
- Habilitación y deshabilitación del servo
- Control de movimiento con velocidad y posición
- Gestión de fases de operación 
- Reposicionamiento del motor a posición inicial/home

 La secuencia verifica las condiciones de seguridad antes de habilitar  el movimiento y monitorea constantemente el estado del servo durante la operación.
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[AxisBlockVM(AB_M4,EnableAxis_M4,StartMachine,ResetAlarm,S04N74_CORTE_APLIC_AQL,Vmaster1,Axis.GroupSynced,M4Data);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(EnableAxis_M4) XIC(MachineStill) TON(M4_Timer_Homing,?,?) ,XIC(M4_Timer_Homing.DN) [XIC(S04N74_CORTE_APLIC_AQL.AxisHomedStatus) ONS(Ons_1.8) OTL(Start_Reposition_M4) ,XIO(S04N74_CORTE_APLIC_AQL.AxisHomedStatus) ONS(Ons_1.9) OTL(Homing_Sequence_M4) ,XIC(Start_Reposition_M4) TON(Timer_End_Reposition_M4,?,?) XIC(Timer_End_Reposition_M4.DN) OTU(Start_Reposition_M4) ] ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[XIC(Homing_Sequence_M4) TON(M4_Timer_InHoming,?,?) [XIC(I0101.3) XIC(OSF_Leva_M4) ONS(Ons_1.30) OTL(OSR_Leva_M4) ,XIO(I0101.3) ONS(Ons_1.31) OTL(OSF_Leva_M4) ,XIC(OSR_Leva_M4) XIC(OSF_Leva_M4) OSR(OSR_C_AQL,OSR_C_AQL_1) ,XIC(OSR_C_AQL_1) TOF(Bit_Retention_C_AQL,?,?) ] ,XIC(M4_Timer_InHoming.DN) [XIO(Bit_Retention_C_AQL.DN) XIO(M4_MAJ.IP) MAJ(S04N74_CORTE_APLIC_AQL,M4_MAJ,M4_MAJ_Direction,Speed_Jog_M4,Units per sec,50,Units per sec2,50,% of Maximum,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None) ,XIC(Bit_Retention_C_AQL.DN) [XIO(M4_MAS.IP) MAS(S04N74_CORTE_APLIC_AQL,M4_MAS,Jog,Yes,1000,Units per sec2,No,1000,Units per sec3) XIC(M4_MAS.PC) OTL(CMD_Home_M4) ,XIC(CMD_Home_M4) MAH(S04N74_CORTE_APLIC_AQL,M4_MAH) XIC(M4_MAH.PC) [OTU(CMD_Home_M4) OTU(Homing_Sequence_M4) ,OTU(OSR_Leva_M4) OTU(OSF_Leva_M4) ] ] ] ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[[XIC(M4_MAJ.ER) ,XIC(M4_MAS.ER) ,XIC(M4_MAH.ER) ,XIC(MAM_Reposition_M4.ER) ] OTE(Error_Home_M4) ,XIC(ResetAlarm) XIC(Error_Home_M4) OTU(CMD_Home_M4) OTU(Homing_Sequence_M4) CLR(MAM_Reposition_M4.FLAGS) CLR(M4_MAS.FLAGS) CLR(M4_MAH.FLAGS) CLR(M4_MAJ.FLAGS) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(MachineStill)[[XIC(HMI_M4_MemPosition) ,XIC(HMI_MemPosition_All_Axis) ] SUB(S04N74_CORTE_APLIC_AQL.CommandPosition,Vmaster1.ActualPosition,M4_Pos_Phase) ,XIC(Start_Reposition_M4) XIC(EnableAxis_M4) XIO(Homing_Procedure_M4) ONS(BIT3.29) OTL(Reposition_Procedure_M4) ];]]>
