<Rung Number="18" Type="N">
<Text>
<![CDATA[[XIC(AutoPhMam.ER) MOV(AutoPhMam.ERR,IstFaultCode) ,XIC(MAS_no_op.ER) MOV(MAS_no_op.ERR,IstFaultCode) ,XIC(Data.Motion.Jog.ER) MOV(Data.Motion.Jog.ERR,IstFaultCode) ,XIC(Data.Motion.Move.ER) MOV(Data.Motion.Move.ERR,IstFaultCode) ,XIC(Data.Motion.Stop.ER) MOV(Data.Motion.Stop.ERR,IstFaultCode) ,XIC(Data.Motion.Gear.ER) MOV(Data.Motion.Gear.ERR,IstFaultCode) ,XIC(Data.Motion.ManualPhMamFw.ER) MOV(Data.Motion.ManualPhMamFw.ERR,IstFaultCode) ,XIC(Data.Motion.ManualPhMamBk.ER) MOV(Data.Motion.ManualPhMamBk.ERR,IstFaultCode) ,XIC(Data.Motion.HomeMAH.ER) MOV(Data.Motion.HomeMAH.ERR,IstFaultCode) ]OTE(Er);]]>
