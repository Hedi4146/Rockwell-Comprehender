<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(EnableCam)JMP(Lbl1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Cam)ONS(LocAux)[XIO(PositionCheckEnable) XIC(LocFlag) OTL(LocScrap) ,OTL(LocFlag) ];]]>
