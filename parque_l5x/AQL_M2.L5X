<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(Reset_Fault_Asse.ER) ,XIC(Reset_Std_Asse.ER) ,XIC(Servo_Off.ER) ,XIC(Servo_On.ER) MOV(Servo_On.ERR,IstError) ]OTE(ER);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIO(Abilitazione)ONS(Aux1)XIC(ER)[CLR(Reset_Fault_Asse.FLAGS) ,CLR(Reset_Std_Asse.FLAGS) ,CLR(Servo_Off.FLAGS) ,[CLR(Servo_On.FLAGS) ,CLR(IstError) ] ];]]>
