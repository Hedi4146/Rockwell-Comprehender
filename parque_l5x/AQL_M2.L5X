</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[NEQ(Istance.HmiNumberDeley,Istance.BSLControl.LEN)MOV(Istance.HmiNumberDeley,Istance.BSLControl.LEN);]]>
