<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)ONS(aux6)DIV(Data.Input.AxPar.ModuleAx,1000,LocModuleAx);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Feedback Ax Manager]]>
</Comment>
<Text>
<![CDATA[Servo_Manager(Data.Motion.ServoManager,PhysicalAx,GroupSincro,ResetAxAlarm,AxEnable,AxEnabled);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Jog Ax Manager]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,1)XIC(AxEnabled)XIC(AxStart)[XIO(PhysicalAx.JogStatus) ,NEQ(Data.Motion.HmiJogSpeed,LocJogSpeed) ][MAJ(PhysicalAx,Data.Motion.Jog,Data.Motion.HmiJogDirection,Data.Motion.HmiJogSpeed,Units per sec,Data.Motion.HmiAccelRate,Units per sec2,Data.Motion.HmiDecelRate,Units per sec2,Trapezoidal,100,100,% of Maximum,Disabled,Programmed,0,None) ,MOV(Data.Motion.HmiJogSpeed,LocJogSpeed) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Positioning Ax Manager]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,2)XIC(AxEnabled)XIC(AxStart)ONS(Aux1)[XIO(PhysicalAx.MoveStatus) ,[NEQ(Data.Motion.HmiMoveSpeed,LocMoveSpeed) ,NEQ(Data.Motion.HmiMovePosition,LocMovePosition) ] ][MAM(PhysicalAx,Data.Motion.Move,Data.Motion.HmiMoveType,Data.Motion.HmiMovePosition,Data.Motion.HmiMoveSpeed,Units per sec,Data.Motion.HmiAccelRate,Units per sec2,Data.Motion.HmiDecelRate,Units per sec2,Trapezoidal,100,100,% of Maximum,Enabled,Programmed,0,None,0,0) ,MOV(Data.Motion.HmiMovePosition,LocMovePosition) ,MOV(Data.Motion.HmiMoveSpeed,LocMoveSpeed) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Gearing RELATIVE MODE Immediate Start Manager]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,3)XIC(AxEnabled)XIC(AxStart)EQU(Data.Motion.HmiGearAccelRate,0)[XIO(PhysicalAx.GearingStatus) ,NEQ(Data.Input.AxPar.ProductLength,LocProductLength) ]CPT(Data.Motion.GearRatio,Data.Input.AxPar.ProductLength/(3.14159*Data.Input.AxPar.HmiRollDiameter))[MAG(PhysicalAx,VMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,Data.Motion.GearRatio,Data.Motion.GearSlaveCounts,360,Command,Real,Disabled,0,Units per sec2) ,MOV(Data.Input.AxPar.ProductLength,LocProductLength) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Gearing RELATIVE MODE Ramp Start Manager
Speed > 1]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,3)XIC(AxEnabled)XIC(AxStart)GRT(VMaster.ActualVelocity,1)NEQ(Data.Motion.HmiGearAccelRate,0)[XIO(PhysicalAx.GearingStatus) ,NEQ(Data.Input.AxPar.ProductLength,LocProductLength) ]CPT(Data.Motion.GearRatio,Data.Input.AxPar.ProductLength/(3.14159*Data.Input.AxPar.HmiRollDiameter))CPT(LocGearAccelRate,VMaster.ActualVelocity*VMaster.ActualVelocity/(Data.Motion.HmiGearAccelRate*2))[MAG(PhysicalAx,VMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,Data.Motion.GearRatio,Data.Motion.GearSlaveCounts,360,Command,Real,Enabled,LocGearAccelRate,Units per sec2) ,MOV(Data.Input.AxPar.ProductLength,LocProductLength) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Gearing RELATIVE MODE Ramp Start Manager
Speed < 1]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,3)XIC(AxEnabled)XIC(AxStart)LES(VMaster.ActualVelocity,1)NEQ(Data.Motion.HmiGearAccelRate,0)[XIO(PhysicalAx.GearingStatus) ,NEQ(Data.Input.AxPar.ProductLength,LocProductLength) ]CPT(Data.Motion.GearRatio,Data.Input.AxPar.ProductLength/(3.14159*Data.Input.AxPar.HmiRollDiameter))[MAG(PhysicalAx,VMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,Data.Motion.GearRatio,Data.Motion.GearSlaveCounts,360,Command,Real,Disabled,LocGearAccelRate,Units per sec2) ,MOV(Data.Input.AxPar.ProductLength,LocProductLength) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Dancer Correction]]>
</Comment>
<Text>
<![CDATA[XIC(Data.Input.Dancer.HmiEnable)XIC(AxEnabled)XIC(AxStart)XIC(PhysicalAx.GearingLockStatus)[CPT(Data.Input.Dancer.SpeedCorrection,(Data.Input.Dancer.HmiSetpoint - Data.Input.Dancer.Position) * Data.Input.Dancer.HmiPgain) ,[GRT(Data.Input.Dancer.SpeedCorrection,Data.Input.Dancer.HmiMaxCorrection) MOV(Data.Input.Dancer.HmiMaxCorrection,Data.Input.Dancer.SpeedCorrection) ,XIO(DancCorr.DN) TON(DancCorr,?,?) ,XIC(DancCorr.DN) MAJ(PhysicalAx,Data.Motion.JogDancer,0,Data.Input.Dancer.SpeedCorrection,Units per sec,50,% of Maximum,50,% of Maximum,S-Curve,100,100,% of Maximum,Disabled,Programmed,0,None) ] ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Gearing Absoluted no ramp Manager]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,4)XIC(AxEnabled)XIC(AxStart)XIO(PhysicalAx.GearingStatus)CPT(Data.Motion.GearRatio,1/Data.Input.AxPar.HmiRollDiameter)[EQU(Data.Motion.HmiGearAccelRate,0) ,EQU(VMaster.ActualVelocity,0) ]MAG(PhysicalAx,VMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,Data.Motion.GearRatio,Data.Motion.GearSlaveCounts,360,Command,Real,Disabled,0,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Gearing Absoluted ramp Manager]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,4)XIC(AxEnabled)XIC(AxStart)XIO(PhysicalAx.GearingStatus)NEQ(Data.Motion.HmiGearAccelRate,0)NEQ(VMaster.ActualVelocity,0)CPT(Data.Motion.GearRatio,1/Data.Input.AxPar.HmiRollDiameter)CPT(LocGearAccelRate,VMaster.ActualVelocity*VMaster.ActualVelocity/(Data.Motion.HmiGearAccelRate*2))MAG(PhysicalAx,VMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,Data.Motion.GearRatio,Data.Motion.GearSlaveCounts,360,Command,Real,Enabled,LocGearAccelRate,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIO(AxEnabled) ,XIO(AxStart) ]ONS(Aux15)[MOV(PhysicalAx.ActualPosition,Data.Motion.MemPhisicalAxActualposition) ,OTU(Data.Motion.GearAbsoluteAxPhased) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Computation Speed Phase]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,4)XIC(Data.Motion.GearAbsoluteEnableAutoPhase)XIC(AxEnabled)XIC(AxStart)XIC(PhysicalAx.GearingLockStatus)XIC(Data.Motion.GearingAbsoluteMasterFased)XIO(Data.Motion.GearAbsoluteAxPhased)GEQ(VMaster.AverageVelocity,Data.Motion.HmiGearAbsoluteThresholdAutoPhase)ONS(aux4)[OTL(Data.Motion.GearAbsoluteAxPhasing) ,CPT(Data.Motion.GearAbsoluteErrorPhase,(VMaster.CommandPosition + Data.Motion.ManualPhaseOffset)MOD 360) ,LES(Data.Motion.GearAbsoluteErrorPhase,0) SUB(360,Data.Motion.GearAbsoluteErrorPhase,Data.Motion.GearAbsoluteErrorPhase) ,CPT(Data.Motion.DeltaCorrection,ABS((PhysicalAx.CommandPosition - Data.Motion.GearAbsoluteErrorPhase)MOD 360)) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Start Auto Phase]]>
</Comment>
<Text>
<![CDATA[XIC(Data.Motion.GearAbsoluteEnableAutoPhase)XIC(AxEnabled)XIC(AxStart)XIC(Data.Motion.GearAbsoluteAxPhasing)XIO(Data.Motion.GearAbsoluteAxPhased)[ONS(RT_AutoPhase) [LES(Data.Motion.DeltaCorrection,10) MAM(PhysicalAx,AutoPhMam1,2,Data.Motion.GearAbsoluteErrorPhase,Data.Motion.GearAbsoluteSpeedAutoPhase,Units per sec,50,% of Maximum,50,% of Maximum,S-Curve,100,100,% of Maximum,Disabled,0,0,None,0,0) ,GEQ(Data.Motion.DeltaCorrection,10) MAM(PhysicalAx,AutoPhMam,3,Data.Motion.GearAbsoluteErrorPhase,Data.Motion.GearAbsoluteSpeedAutoPhase,Units per sec,50,% of Maximum,50,% of Maximum,S-Curve,100,100,% of Maximum,Disabled,0,0,None,0,0) ] ,[XIC(AutoPhMam.PC) ,XIC(AutoPhMam1.PC) ] [OTL(Data.Motion.GearAbsoluteAxPhased) ,OTU(Data.Motion.GearAbsoluteAxPhasing) ] ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Manual Phase Forward]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,4)XIC(AxEnabled)XIO(Data.Motion.HmiEnablePrintMark)XIO(Data.Motion.GearAbsoluteAxPhasing)XIC(Data.Motion.PhaseForwardCommand)XIO(Data.Motion.ManualPhMamFw.IP)CPT(LocStepManPhase,Data.Motion.HmiManualPhaserStep/2)MAM(PhysicalAx,Data.Motion.ManualPhMamFw,1,LocStepManPhase,Data.Motion.HmiManualPhaserVelocity,Units per sec,50,% of Maximum,50,% of Maximum,S-Curve,100,100,% of Maximum,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Manual Phase Forward]]>
</Comment>
<Text>
<![CDATA[XIC(Data.Motion.ManualPhMamFw.IP)ONS(Aux7)[LES(Data.Motion.ManualPhaseOffset,LocModuleAx) ADD(Data.Motion.ManualPhaseOffset,Data.Motion.HmiManualPhaserStep,Data.Motion.ManualPhaseOffset) ,GEQ(Data.Motion.ManualPhaseOffset,LocModuleAx) MOV(0,Data.Motion.ManualPhaseOffset) ,CLR(Data.Motion.ManualPhMamFw.FLAGS) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Manual Phase Backward]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,4)XIC(AxEnabled)XIO(Data.Motion.HmiEnablePrintMark)XIO(Data.Motion.GearAbsoluteAxPhasing)XIC(Data.Motion.PhaseBackwardCommand)XIO(Data.Motion.ManualPhMamBk.IP)CPT(LocStepManPhase,Data.Motion.HmiManualPhaserStep/-2)MAM(PhysicalAx,Data.Motion.ManualPhMamBk,1,LocStepManPhase,Data.Motion.HmiManualPhaserVelocity,Units per sec,50,% of Maximum,50,% of Maximum,S-Curve,100,100,% of Maximum,Disabled,0,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Manual Phase Backward]]>
</Comment>
<Text>
<![CDATA[XIC(Data.Motion.ManualPhMamBk.IP)ONS(Aux8)[GRT(Data.Motion.ManualPhaseOffset,0) SUB(Data.Motion.ManualPhaseOffset,Data.Motion.HmiManualPhaserStep,Data.Motion.ManualPhaseOffset) ,LEQ(Data.Motion.ManualPhaseOffset,0) MOV(LocModuleAx,Data.Motion.ManualPhaseOffset) ,CLR(Data.Motion.ManualPhMamBk.FLAGS) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Start Home]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,10)XIO(AxEnabled)XIC(AxStart)ONS(Aux3)MAH(PhysicalAx,Data.Motion.HomeMAH);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[Disable Ax]]>
</Comment>
<Text>
<![CDATA[[XIO(AxEnabled) ONS(LocAux2) ,XIO(AxStart) ONS(LocAux1) ,EQU(Data.Input.AxPar.HmiOpMode,0) ][XIC(PhysicalAx.JogStatus) ,XIC(PhysicalAx.GearingStatus) ,XIC(PhysicalAx.HomingStatus) ,XIC(PhysicalAx.MoveStatus) ][MAS(PhysicalAx,Data.Motion.Stop,All,Yes,90,% of Maximum,No,100,% of Maximum) ,OTU(Data.Motion.GearAbsoluteAxPhasing) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[[EQU(Data.Input.AxPar.HmiOpMode,4) XIC(Data.Motion.GearAbsoluteAxPhased) XIC(PhysicalAx.GearingLockStatus) ,EQU(Data.Input.AxPar.HmiOpMode,3) XIC(PhysicalAx.GearingLockStatus) ]OTE(AxSyncro);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(PhysicalAx.AxisHomedStatus)OTE(AxHomed);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIO(AxEnabled)ONS(aux5)[CLR(AutoPhMam.FLAGS) ,CLR(MAS_no_op.FLAGS) ,CLR(Data.Motion.Jog.FLAGS) ,CLR(Data.Motion.Move.FLAGS) ,CLR(Data.Motion.Stop.FLAGS) ,CLR(Data.Motion.Gear.FLAGS) ,CLR(Data.Motion.ManualPhMamFw.FLAGS) ,CLR(Data.Motion.ManualPhMamBk.FLAGS) ,CLR(Data.Motion.HomeMAH.FLAGS) ,CLR(IstFaultCode) ,CLR(DriveFaultCode) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[[XIC(AutoPhMam.ER) MOV(AutoPhMam.ERR,IstFaultCode) ,XIC(MAS_no_op.ER) MOV(MAS_no_op.ERR,IstFaultCode) ,XIC(Data.Motion.Jog.ER) MOV(Data.Motion.Jog.ERR,IstFaultCode) ,XIC(Data.Motion.Move.ER) MOV(Data.Motion.Move.ERR,IstFaultCode) ,XIC(Data.Motion.Stop.ER) MOV(Data.Motion.Stop.ERR,IstFaultCode) ,XIC(Data.Motion.Gear.ER) MOV(Data.Motion.Gear.ERR,IstFaultCode) ,XIC(Data.Motion.ManualPhMamFw.ER) MOV(Data.Motion.ManualPhMamFw.ERR,IstFaultCode) ,XIC(Data.Motion.ManualPhMamBk.ER) MOV(Data.Motion.ManualPhMamBk.ERR,IstFaultCode) ,XIC(Data.Motion.HomeMAH.ER) MOV(Data.Motion.HomeMAH.ERR,IstFaultCode) ,XIC(Data.Motion.ServoManager.ER) MOV(Data.Motion.ServoManager.IstError,IstFaultCode) ]OTE(Er);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(ResetAxAlarm)[XIC(AutoPhMam.ER) CLR(AutoPhMam.FLAGS) ,XIC(MAS_no_op.ER) CLR(MAS_no_op.FLAGS) ,XIC(Data.Motion.Jog.ER) CLR(Data.Motion.Jog.FLAGS) ,XIC(Data.Motion.Move.ER) CLR(Data.Motion.Move.FLAGS) ,XIC(Data.Motion.Stop.ER) CLR(Data.Motion.Stop.FLAGS) ,XIC(Data.Motion.Gear.ER) CLR(Data.Motion.Gear.FLAGS) ,XIC(Data.Motion.ManualPhMamFw.ER) CLR(Data.Motion.ManualPhMamFw.FLAGS) ,XIC(Data.Motion.ManualPhMamBk.ER) CLR(Data.Motion.ManualPhMamBk.FLAGS) ,XIC(Data.Motion.HomeMAH.ER) CLR(Data.Motion.HomeMAH.FLAGS) ,CLR(IstFaultCode) ,CLR(DriveFaultCode) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[[XIC(PhysicalAx.AxisFault.0) ,XIC(PhysicalAx.AxisFault.1) ,XIC(PhysicalAx.AxisFault.2) ][OTE(AxFault) ,MOV(PhysicalAx.DriveFault,DriveFaultCode) ];]]>
</Text>
</Rung>
