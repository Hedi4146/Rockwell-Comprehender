<Text>
<![CDATA[[[XIC(HMI_Do_MAJ_Clutch) ,XIC(HMI_Cmd_Home) ] XIC(MI_MAJ.IP) MAS(Ref_ServoAxis,MI_MAS_ALL,All,Yes,HMI_Decel,Units per sec2,No,100,% of Time) ,XIC(HMI_Cmd_Home) MOV(2000,HMI_Cmd_Home_Delay.PRE) TON(HMI_Cmd_Home_Delay,?,?) ,XIC(HMI_Cmd_Home_Delay.DN) ONS(ONS_HomeStart) OTU(Sts_Homed) MOV(1,HomeSequence) ,EQU(HomeSequence,1) [MAH(Ref_ServoAxis,MI_Home) ,MOV(2,HomeSequence) ] ,EQU(HomeSequence,2) XIC(MI_Home.PC) [OTL(Sts_Homed) ,MOV(3,HomeSequence) ] ,XIC(HMI_Cmd_Home_Delay.DN) XIC(Sts_Homed) OTE(Sts_HomeDone) ,XIC(ER_Clearing) [XIC(MI_MAJ.ER) CLR(MI_MAJ.FLAGS) ,XIC(MI_MAS_ALL.ER) CLR(MI_MAS_ALL.FLAGS) ,XIC(MI_Home.ER) CLR(MI_Home.FLAGS) ] ,[XIC(MI_MAJ.ER) ,XIC(MI_MAS_ALL.ER) ,XIC(MI_Home.ER) ] XIO(ER_Clearing) OTE(EM_Fault) ];]]>
