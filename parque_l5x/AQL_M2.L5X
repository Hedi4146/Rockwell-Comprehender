<Routine Name="InitAxis" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[(*Virtual Master        *)]]>
</Line>
<Line Number="2">
<![CDATA[Virtual1Data.Motion.HmiGearAccelRate					:= 0;]]>
</Line>
<Line Number="3">
<![CDATA[Virtual1Data.Input.AxPar.ProductLength					:= 1;]]>
</Line>
<Line Number="4">
<![CDATA[Virtual1Data.Motion.HmiGearAbsoluteThresholdAutoPhase	:= 300;]]>
</Line>
<Line Number="5">
<![CDATA[Virtual1Data.Motion.GearAbsoluteEnableAutoPhase			:= 1;]]>
</Line>
<Line Number="6">
<![CDATA[Virtual1Data.Input.AxPar.ModuleAx						:= 360000;]]>
</Line>
<Line Number="7">
<![CDATA[	]]>
</Line>
<Line Number="8">
<![CDATA[(*M3 *)]]>
</Line>
<Line Number="9">
<![CDATA[M3Data.Input.AxPar.HmiOpMode							:= 3;]]>
</Line>
<Line Number="10">
<![CDATA[M3Data.Motion.HmiAccelRate								:= 200;]]>
</Line>
<Line Number="11">
<![CDATA[M3Data.Motion.HmiDecelRate								:= 200;]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
