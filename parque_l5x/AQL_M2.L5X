<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(CutterA) ,XIC(CutterB) ,XIC(Start) ]ONS(Aux4)[MOV(InitRadius,RadiusComputation) ,CPT(Ratio,(LenghtProduct /3.1416) / (RadiusComputation * 2)) ,CLR(Counter) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Start)XIC(TriggerProduct)[GEQ(Counter,FreqUpdateRadius) CLR(Counter) ,LES(Counter,FreqUpdateRadius) ADD(Counter,1,Counter) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(StopRequest)CLR(Counter);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[GEQ(Counter,FreqUpdateRadius)[XIO(EnableDiameterSensor) [CPT(RadiusComputation,(MasterSpeed * LenghtProduct / 6.2831)/AxSpeed) ,LES(RadiusComputation,45) MOV(45,RadiusComputation) ,GRT(RadiusComputation,700) MOV(700,RadiusComputation) ] ,CPT(Ratio,(LenghtProduct /3.1416) / (RadiusComputation * 2)) ,CLR(Counter) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(EnableDiameterSensor)XIO(TimeFreqUpdateRadius.DN)TON(TimeFreqUpdateRadius,?,?);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(TimeFreqUpdateRadius.DN)[CPT(LocSensorDiameter,SensorDistance-SensorDiameter) ,FFL(LocSensorDiameter,RadiusAvg,FFl,?,?) ,AVE(RadiusAvg,0,RadiusComputation,Ave,?,?) ,XIC(FFl.DN) CLR(FFl.POS) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(StartMacine)ONS(Aux3)XIC(EnableDiameterSensor)CPT(Ratio,(LenghtProduct /3.1416) / (RadiusComputation * 2));]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(EnableDiameterSensor)XIC(LoadManRadius)MOV(ManRadius,RadiusComputation)[CPT(Ratio,(LenghtProduct /3.1416) / (RadiusComputation * 2)) ,CLR(Counter) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
