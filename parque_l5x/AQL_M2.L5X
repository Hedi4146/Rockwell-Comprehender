<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)ONS(aux6)DIV(Data.Input.AxPar.ModuleAx,1000,LocModuleAx);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(AxEnable)XIC(GroupSincro)XIO(VirtualAx.PhysicalAxisFault)XIO(VirtualAx.ModuleFault)XIO(VirtualAx.ConfigFault)OTE(AxEnabled);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Jog Ax Manager]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,1)XIC(AxEnabled)XIC(AxStart)[XIO(VirtualAx.JogStatus) ,NEQ(Data.Motion.HmiJogSpeed,LocJogSpeed) ][MAJ(VirtualAx,Data.Motion.Jog,Data.Motion.HmiJogDirection,Data.Motion.HmiJogSpeed,Units per sec,Data.Motion.HmiAccelRate,% of Maximum,Data.Motion.HmiDecelRate,% of Maximum,Trapezoidal,100,100,% of Maximum,Disabled,Programmed,0,None) ,MOV(Data.Motion.HmiJogSpeed,LocJogSpeed) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Gearing RELATIVE MODE Immediate Start Manager]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,3)XIC(AxEnabled)XIC(AxStart)EQU(Data.Motion.HmiGearAccelRate,0)XIO(VirtualAx.GearingStatus)MAG(VirtualAx,PhysicalMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,1,Data.Motion.GearSlaveCounts,360,Command,Real,Disabled,0,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Gearing RELATIVE MODE Ramp Start Manager
Speed > 1]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,3)XIC(AxEnabled)XIC(AxStart)GRT(PhysicalMaster.ActualVelocity,1)NEQ(Data.Motion.HmiGearAccelRate,0)XIO(VirtualAx.GearingStatus)CPT(LocGearAccelRate,PhysicalMaster.ActualVelocity*PhysicalMaster.ActualVelocity/(2*Data.Motion.HmiGearAccelRate* 360))MAG(VirtualAx,PhysicalMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,1,1,1,Command,Real,Enabled,LocGearAccelRate,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Gearing RELATIVE MODE Ramp Start Manager
Speed < 1]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,3)XIC(AxEnabled)XIC(AxStart)LES(PhysicalMaster.ActualVelocity,1)NEQ(Data.Motion.HmiGearAccelRate,0)XIO(VirtualAx.GearingStatus)MAG(VirtualAx,PhysicalMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,1,1,1,Command,Real,Disabled,LocGearAccelRate,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Gearing Absoluted no ramp Manager]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,4)XIC(AxEnabled)XIC(AxStart)XIO(VirtualAx.GearingStatus)[EQU(Data.Motion.HmiGearAccelRate,0) ,LIM(-2,PhysicalMaster.ActualVelocity,2) ]MAG(VirtualAx,PhysicalMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,1,1,1,Command,Real,Disabled,0,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Gearing Absoluted ramp Manager]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,4)XIC(AxEnabled)XIC(AxStart)XIO(VirtualAx.GearingStatus)NEQ(Data.Motion.HmiGearAccelRate,0)GRT(PhysicalMaster.ActualVelocity,2)CPT(LocGearAccelRate,PhysicalMaster.ActualVelocity*PhysicalMaster.ActualVelocity/(2*Data.Motion.HmiGearAccelRate*360))MAG(VirtualAx,PhysicalMaster,Data.Motion.Gear,Data.Motion.HmiGearDirection,1,1,1,Command,Real,Enabled,LocGearAccelRate,Units per sec2);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Computation Error  Phase]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,4)XIC(Data.Motion.GearAbsoluteEnableAutoPhase)XIC(AxEnabled)XIC(AxStart)XIC(VirtualAx.GearingLockStatus)ONS(RT_Start)[CPT(Data.Motion.GearAbsoluteErrorPhase,PhysicalMaster.CommandPosition-VirtualAx.CommandPosition) ,CPT(Data.Motion.GearAbsoluteSpeedAutoPhase,Data.Motion.HmiGearAbsoluteThresholdAutoPhase / 2) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[EQU(Data.Input.AxPar.HmiOpMode,4) XIC(Data.Motion.GearAbsoluteEnableAutoPhase) [XIO(AxEnabled) ,XIO(AxStart) ] ,EQU(Data.Input.AxPar.HmiOpMode,1) ]ONS(aux4)OTU(Data.Motion.GearAbsoluteAxPhased);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,4)XIC(Data.Motion.GearAbsoluteEnableAutoPhase)XIO(Data.Motion.GearAbsoluteAxPhased)XIO(Data.Motion.GearAbsoluteAxPhasing)GRT(PhysicalMaster.AverageVelocity,Data.Motion.HmiGearAbsoluteThresholdAutoPhase)OTL(Data.Motion.GearAbsoluteAxPhasing);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Start Auto Phase]]>
</Comment>
<Text>
<![CDATA[XIC(Data.Motion.GearAbsoluteEnableAutoPhase)XIC(AxEnabled)XIC(AxStart)XIC(Data.Motion.GearAbsoluteAxPhasing)XIO(Data.Motion.GearAbsoluteAxPhased)[ONS(RT_AutoPhase) MAM(VirtualAx,AutoPhMam,1,Data.Motion.GearAbsoluteErrorPhase,Data.Motion.GearAbsoluteSpeedAutoPhase,Units per sec,50,% of Maximum,50,% of Maximum,S-Curve,100,100,% of Maximum,Disabled,0,0,None,0,0) ,XIC(AutoPhMam.PC) [OTL(Data.Motion.GearAbsoluteAxPhased) ,OTU(Data.Motion.GearAbsoluteAxPhasing) ] ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Start Home]]>
</Comment>
<Text>
<![CDATA[EQU(Data.Input.AxPar.HmiOpMode,10)XIC(AxEnabled)XIC(AxStart)XIO(VirtualAx.HomingStatus)ONS(Aux3)MAH(VirtualAx,Data.Motion.HomeMAH);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Disable Ax]]>
</Comment>
<Text>
<![CDATA[XIO(AxStart)XIC(VirtualAx.JogStatus)MAM(VirtualAx,MamStop,3,PhysicalMaster.ActualPosition,0,% of Maximum,5,Units per sec2,5,% of Maximum,Trapezoidal,100,100,% of Maximum,Enabled,Current,0,None,0,0);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Disable Ax]]>
</Comment>
<Text>
<![CDATA[[XIO(AxEnabled) ,XIO(AxStart) ,EQU(Data.Input.AxPar.HmiOpMode,0) ][XIC(VirtualAx.GearingStatus) ,XIC(VirtualAx.HomingStatus) ,XIO(VirtualAx.JogStatus) XIC(VirtualAx.MoveStatus) XIO(MamStop.IP) ][MAS(VirtualAx,Data.Motion.Stop,All,Yes,Data.Motion.HmiDecelRate,% of Maximum,No,100,% of Maximum) ,OTU(Data.Motion.GearAbsoluteAxPhasing) ];]]>
</Text>
