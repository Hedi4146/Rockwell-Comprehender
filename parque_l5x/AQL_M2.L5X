<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(PBStopMotor) MOV(StopPositionDancer,LocDancerSetpoint) ,XIO(PBStopMotor) MOV(DancerSetpoint,LocDancerSetpoint) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)TON(T1,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)XIC(MachineStart)[LES(MasterSpeed,100) MOV(100,LocAxAverageVelocity) ,GEQ(MasterSpeed,100) MOV(MasterSpeed,LocAxAverageVelocity) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)XIC(MachineStart)XIC(T1.DN)CPT(LocCorrection,(LocAxAverageVelocity * GainCorrection) * Ratio * ((LocDancerSetpoint - DancerPosition)/50));]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AxStart)XIC(MachineStart)XIO(T1.DN)CPT(LocCorrection,(LocAxAverageVelocity * GainCorrection * Ratio * ((LocDancerSetpoint - DancerPosition)/50))/GainCorrectionSplicer);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)[[XIO(MachineStart) ,XIO(AxStart) ] ,XIC(EnableInitRadiusAutocalc) XIC(AutoCalcRadiusDone) ]XIO(AutocalcRaduisRunning)CPT(LocCorrection,(((1200-ReelRadius)/Kp1DancerCorreection)*((LocDancerSetpoint-DancerPosition)/2))/2);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(AxEnabled)XIC(AutocalcRaduisRunning)CPT(LocCorrection,(((1200-ReelRadius)/Kp1DancerCorreection)*((LocSetpoin-DancerPosition)/2))/2);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIO(AxStart)XIO(AutocalcRaduisRunning)XIC(EnablePreStart)[XIC(AutoCalcRadiusDone) ,XIO(EnableInitRadiusAutocalc) ]CPT(LocCorrection,(((1200-ReelRadius)/Kp1DancerCorreection)*((20-DancerPosition)/2))/2);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(EnableRewinder)MUL(LocCorrection,-1,LocCorrection);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(HmiDisableCorrPrepared)XIC(AxPrepared)XIO(EnableInitRadiusAutocalc)XIO(AxStart)CLR(LocCorrection);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(AxStart) ,XIO(AxEnabled) ][OTU(AutoCalcRadiusDone) ,OTU(AutocalcRaduisRunning) ,OTU(StartJogAutoCalc) ,CLR(LocAutocalc) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIO(EnableInitRadiusAutocalc) ,XIO(AxPrepared) ,XIC(AutoCalcRadiusDone) ,XIC(AxStart) ]JMP(Lab1);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIO(AutocalcRaduisRunning)[OTL(AutocalcRaduisRunning) ,CLR(LocAutocalc) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[EQU(LocAutocalc,0)[MOV(30,LocSetpoin) ,MOV(9,LocAutocalc) ,OTL(StartJogAutoCalc) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[EQU(LocAutocalc,9)LIM(29,DancerPosition,31)[OTU(StartJogAutoCalc) ,MAS(Ax,LocMAS,Jog,Yes,100,% of Maximum,Yes,100,% of Maximum) ,XIC(LocMAS.PC) MOV(10,LocAutocalc) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[EQU(LocAutocalc,10)XIC(AxEnabled)LES(Ax.AverageVelocity,2)[MAM(Ax,LocMAM,1,DegMoveCalcRadius,20,Units per sec,60,Units per sec2,60,Units per sec2,S-Curve,100,100,% of Maximum,Enabled,Programmed,0,None,0,0) ,XIC(LocMAM.IP) MOV(30,LocAutocalc) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[EQU(LocAutocalc,30)XIC(AxEnabled)XIC(LocMAM.PC)[CPT(LocInitRadius,(((DancerPosition - 20) * (DancerBuffered / 100))/ 6.2831) * (360 / DegMoveCalcRadius)) ,GRT(LocInitRadius,700) MOV(700,LocInitRadius) ,LES(LocInitRadius,50) MOV(50,LocInitRadius) ,MOV(40,LocAutocalc) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[EQU(LocAutocalc,40)[OTU(AutocalcRaduisRunning) ,OTL(AutoCalcRadiusDone) ,CLR(LocAutocalc) ,MOV(LocInitRadius,InitRadiusCoputation) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[LBL(Lab1)OTE(Aux2);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[[XIC(RewinderEnable) MUL(LocCorrection,-1,LocCorrection1) ,XIO(RewinderEnable) MOV(LocCorrection,LocCorrection1) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIO(RewinderEnable)XIC(AxEnabled)[[EQU(SpliceTipe,2) ,EQU(SpliceTipe,3) ] XIC(AxStart) ,[EQU(SpliceTipe,1) ,EQU(SpliceTipe,4) ] [XIO(AutocalcRaduisRunning) ,XIC(StartJogAutoCalc) ] ]NEQ(LocCorrection,Aux1LocCorrection)[MAJ(Ax,LocMAJ1,0,LocCorrection1,Units per sec,10,% of Maximum,40,% of Maximum,Trapezoidal,100,100,% of Maximum,Disabled,Programmed,0,None) ,MOV(LocCorrection,Aux1LocCorrection) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIO(RewinderEnable)[[XIO(AxEnabled) ,XIO(AxStart) NEQ(SpliceTipe,1) NEQ(SpliceTipe,4) ] XIC(Ax.JogStatus) ,XIO(AxEnabled) XIC(AxEnabled) XIC(Ax.JogStatus) EQU(LocCorrection1,0) ]MAS(Ax,LocMAS2,Jog,Yes,100,% of Maximum,Yes,100,% of Maximum);]]>
</Text>
</Rung>
