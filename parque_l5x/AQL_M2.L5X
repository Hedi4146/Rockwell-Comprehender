</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Trigger)[XIC(LocScrap) ADD(LocCount,1,LocCount) ,XIO(LocScrap) CLR(LocCount) ,GRT(LocCount,Istance.HmiMaxNumberReject) [OTL(Alarm) ,OTL(Istance.HmiAlarm) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(ResetAlarm)CLR(LocCount)OTU(Alarm)OTU(Istance.HmiAlarm);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Trigger)[BSL(Istance.Arrey,Istance.BSLControl,LocScrap,?) ,OTU(LocScrap) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Istance.BSLControl.UL)[OTL(Out) ,OTL(Istance.HmiLed) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Istance.HmiLed)[TON(T1,?,?) ,XIC(T1.DN) OTU(Istance.HmiLed) ];]]>
